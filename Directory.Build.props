<Project>

  <!--
    Repository-wide build properties.
    Individual projects may override any of these; keep project-local overrides
    to the minimum and prefer changing them here.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      On, so the compiler reads the XML comments instead of ignoring them.

      This codebase carries a lot of reasoning in doc comments, and none of it was
      being checked: a doc block can drift onto the wrong member when a method is
      inserted above it (CS1571), a cref can name something that no longer exists
      (CS1574), and the XML itself can be malformed (CS1570) - all silently, because
      nothing parsed any of it. With warnings as errors, turning this on makes those
      build failures.

      CS1591 - "missing XML comment for publicly visible type or member" - stays
      suppressed. Requiring a comment on every public member produces ceremony, and
      ceremony is what makes people stop reading comments. The rule here is that a
      comment which exists must be correct, not that one must exist.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    B5 - warnings are errors.

    Nullable is enabled everywhere but nothing enforced it, so a genuine
    CS8602 (possible null dereference) shipped to production. Every warning
    now fails the build, in CI and locally alike.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      NuGet audit advisories (NU1901-NU1904) stay warnings on purpose: a new
      CVE published against a transitive dependency must not turn every deploy
      red on a day nobody touched the code. Dependabot (.github/dependabot.yml)
      raises the PR instead, and `dotnet restore` still prints the advisory.
    -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Deterministic, reproducible CI builds.
  -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' AND '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
