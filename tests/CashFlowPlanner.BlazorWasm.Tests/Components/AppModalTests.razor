@namespace CashFlowPlanner.BlazorWasm.Tests.Components
@inherits ComponentTestBase

@code {
    [Fact]
    public void Announces_itself_as_a_dialog_labelled_by_its_own_heading()
    {
        // One of the three old modals set aria-modal. Without it a screen reader keeps reading the
        // page behind the backdrop, which the user cannot see or reach.
        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction"));

        var dialog = cut.Find("div.modal");

        Assert.Equal("dialog", dialog.GetAttribute("role"));
        Assert.Equal("true", dialog.GetAttribute("aria-modal"));

        var labelledBy = dialog.GetAttribute("aria-labelledby");

        Assert.False(string.IsNullOrWhiteSpace(labelledBy));
        Assert.Equal("Delete transaction", cut.Find("#" + labelledBy).TextContent.Trim());
    }

    [Fact]
    public void Gives_two_dialogs_on_one_page_different_heading_ids()
    {
        var cut = Render(@<div>
                             <AppModal Visible="true" Title="First" />
                             <AppModal Visible="true" Title="Second" />
                         </div>);

        var ids = cut.FindAll("div.modal").Select(d => d.GetAttribute("aria-labelledby")).ToList();

        Assert.Equal(2, ids.Distinct().Count());
    }

    [Fact]
    public void Renders_nothing_at_all_when_hidden()
    {
        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, false)
            .Add(p => p.Title, "Delete transaction"));

        Assert.Empty(cut.FindAll("div.modal"));
        Assert.Empty(cut.FindAll("div.modal-backdrop"));
    }

    [Fact]
    public void Draws_a_backdrop()
    {
        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction"));

        Assert.NotNull(cut.Find("div.modal-backdrop"));
    }

    [Fact]
    public void Escape_cancels()
    {
        // Two of the three old modals ignored Escape outright.
        var cancelled = false;

        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction")
            .Add(p => p.OnCancel, () => cancelled = true));

        cut.Find("div.modal").KeyDown(Key.Escape);

        Assert.True(cancelled);
    }

    [Fact]
    public void Other_keys_do_nothing()
    {
        var cancelled = false;

        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction")
            .Add(p => p.OnCancel, () => cancelled = true));

        cut.Find("div.modal").KeyDown(Key.Enter);
        cut.Find("div.modal").KeyDown(Key.Tab);

        Assert.False(cancelled);
    }

    [Fact]
    public void The_close_button_and_the_cancel_button_both_cancel()
    {
        // One way out, so a caller cannot handle two of the three and forget the third.
        var cancellations = 0;

        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction")
            .Add(p => p.OnCancel, () => cancellations++));

        cut.Find("button.btn-close").Click();
        cut.Find("div.modal-footer button.btn-outline-secondary").Click();

        Assert.Equal(2, cancellations);
    }

    [Fact]
    public void Puts_the_way_out_before_the_thing_that_commits()
    {
        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction")
            .Add(p => p.CancelText, "Cancel")
            .Add(p => p.ConfirmText, "Delete"));

        var buttons = cut.FindAll("div.modal-footer button");

        Assert.Equal(2, buttons.Count);
        Assert.Equal("Cancel", buttons[0].TextContent.Trim());
        Assert.Equal("Delete", buttons[1].TextContent.Trim());
    }

    [Fact]
    public void Localizes_the_close_buttons_accessible_name()
    {
        // ConfirmDialog hardcoded aria-label="Close" in an otherwise fully localized app, so a
        // German screen reader announced one English word.
        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction"));

        Assert.Equal("Close", cut.Find("button.btn-close").GetAttribute("aria-label"));
    }

    [Fact]
    public void Focuses_into_the_dialog_when_it_opens()
    {
        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, false)
            .Add(p => p.Title, "Delete transaction"));

        Assert.Equal(0, FocusCallCount());

        cut.Render(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction"));

        Assert.Equal(1, FocusCallCount());
        AssertLastFocusWasOn(cut.Find("button.btn-close"));
    }

    [Fact]
    public void Traps_focus_at_the_end_of_the_dialog()
    {
        // Tabbing off the end lands on the trailing guard, which sends focus back to the top. Every
        // one of the three old modals let Tab walk straight out into the page behind the backdrop.
        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction"));

        var guards = cut.FindAll("div.modal > span[tabindex='0']");

        Assert.Equal(2, guards.Count);

        var before = FocusCallCount();
        guards[1].Focus();

        Assert.Equal(before + 1, FocusCallCount());
        AssertLastFocusWasOn(cut.Find("button.btn-close"));
    }

    [Fact]
    public void Traps_focus_at_the_start_of_the_dialog()
    {
        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction")
            .Add(p => p.ConfirmText, "Delete"));

        var guards = cut.FindAll("div.modal > span[tabindex='0']");

        var before = FocusCallCount();
        guards[0].Focus();

        // Shift-tabbing off the front goes to the last thing in the dialog: the commit button.
        Assert.Equal(before + 1, FocusCallCount());
        AssertLastFocusWasOn(cut.FindAll("div.modal-footer button")[1]);
    }

    [Fact]
    public void Locks_the_page_behind_the_dialog_and_unlocks_it_again()
    {
        // The page lock needs document.body, so it lives in the collocated module. What is asserted
        // here is that the component calls it, once each way.
        var module = JSInterop.SetupModule("./Components/AppModal.razor.js");
        var open = module.SetupVoid("open").SetVoidResult();
        var close = module.SetupVoid("close").SetVoidResult();

        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction"));

        Assert.Single(open.Invocations);
        Assert.Empty(close.Invocations);

        cut.Render(parameters => parameters
            .Add(p => p.Visible, false)
            .Add(p => p.Title, "Delete transaction"));

        Assert.Single(close.Invocations);
    }

    [Fact]
    public void Custom_footer_content_replaces_the_standard_buttons()
    {
        var cut = Render<AppModal>(parameters => parameters
            .Add(p => p.Visible, true)
            .Add(p => p.Title, "Delete transaction")
            .Add(p => p.FooterContent, "<button type=\"button\" id=\"only\">Only</button>"));

        var buttons = cut.FindAll("div.modal-footer button");

        Assert.Single(buttons);
        Assert.Equal("only", buttons[0].Id);
    }

    private int FocusCallCount() => JSInterop.Invocations.Count(IsFocusCall);

    /// <summary>
    /// Asserts that the most recent FocusAsync call was aimed at <paramref name="expected"/>.
    ///
    /// The ElementReference passed to FocusAsync is joined back up with the element it points at,
    /// so the assertion says which control got focus rather than only that something did.
    /// </summary>
    private void AssertLastFocusWasOn(AngleSharp.Dom.IElement expected)
    {
        var invocation = JSInterop.Invocations.Last(IsFocusCall);

        invocation.Arguments[0].ShouldBeElementReferenceTo(expected);
    }

    private static bool IsFocusCall(JSRuntimeInvocation invocation) =>
        invocation.Identifier.EndsWith("focus", StringComparison.OrdinalIgnoreCase);
}
