<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings / TreatWarningsAsErrors
       come from ../../Directory.Build.props -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Versions are centrally managed in ../../Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    CAMT.053 test fixtures.

    Embedded rather than copied to the output directory so a fixture can never be silently
    missing at run time: a wrong name fails in CamtFixture.Read, not in a file-not-found
    deep inside a test.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Banking\Camt\Fixtures\*.xml" />
  </ItemGroup>

  <!--
    CSV test fixtures.

    Embedded for the same reason as the camt ones, and for one more: several of them are not
    UTF-8. Latin1.csv is Latin-1 on purpose, and Utf8Bom.csv carries a byte-order mark, because
    Swiss exports are not uniformly UTF-8 and a decoder that guesses wrong turns "Zürich" into
    "Z?rich" without failing. Copying those to the output directory would let a build step or a
    text-mode file copy silently re-encode them and quietly disarm the test.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Banking\Csv\Fixtures\*.csv" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CashFlowPlanner.Core\CashFlowPlanner.Core.csproj" />
  </ItemGroup>

</Project>
