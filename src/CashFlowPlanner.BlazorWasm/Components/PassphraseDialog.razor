@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.BlazorWasm.Services
@using Microsoft.Extensions.Localization

@implements IDisposable

@inject PassphrasePromptService Prompt
@inject IStringLocalizer<SharedResource> L

@*
    Asks for the passphrase, for both opening an encrypted plan and choosing one for
    the first time.

    The Create path deliberately makes it hard to proceed carelessly: the passphrase
    is typed twice and the user must tick an acknowledgement. There is no reset, no
    hint and no backdoor - if this is forgotten the plan is unreadable by anyone,
    including us. Saying that once, clearly, before anything is encrypted is the only
    protection available.

    The chrome is AppModal's now, so this dialog gains the focus trap, the page lock and
    the focus restore it never had. What it must not gain is a new way out: there is no
    header close button, exactly as before, because a dialog that gates encryption is
    answered or cancelled, not dismissed.
*@

@if (Prompt.Current is { } request)
{
    <AppModal Visible="true"
              Title="@(request.Mode == PassphrasePromptMode.Create
                        ? L["Passphrase_CreateTitle"].Value
                        : L["Passphrase_UnlockTitle"].Value)"
              ShowCloseButton="false"
              CancelText="@L["Passphrase_Cancel"].Value"
              ConfirmText="@(request.Mode == PassphrasePromptMode.Create
                             ? L["Passphrase_CreateAction"].Value
                             : L["Passphrase_UnlockAction"].Value)"
              ConfirmDisabled="@(!CanSubmit)"
              OnConfirm="Submit"
              OnCancel="Cancel">

        @if (!string.IsNullOrWhiteSpace(request.FileName))
        {
            <p class="text-body-secondary mb-3">
                @request.FileName
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(request.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@request.ErrorMessage</div>
        }

        @if (request.Mode == PassphrasePromptMode.Create)
        {
            <div class="alert alert-warning" role="alert">
                <strong>@L["Passphrase_NoRecoveryTitle"]</strong>
                <div>@L["Passphrase_NoRecoveryBody"]</div>
            </div>
        }

        <FormField Label="@L["Passphrase_Label"].Value" Id="passphraseInput" Context="field">
            <input id="@field.Id"
                   type="password"
                   class="form-control"
                   autocomplete="@(request.Mode == PassphrasePromptMode.Create ? "new-password" : "current-password")"
                   @bind="_passphrase"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDown" />
        </FormField>

        @if (request.Mode == PassphrasePromptMode.Create)
        {
            <FormField Label="@L["Passphrase_ConfirmLabel"].Value" Id="passphraseConfirmInput" Context="field">
                <input id="@field.Id"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       @bind="_confirm"
                       @bind:event="oninput"
                       @onkeydown="OnKeyDown" />
            </FormField>

            @if (_passphrase.Length > 0 && _confirm.Length > 0 && _passphrase != _confirm)
            {
                <div class="text-danger small mb-2">@L["Passphrase_Mismatch"]</div>
            }

            <FormField Label="@L["Passphrase_Acknowledge"].Value"
                       Id="passphraseAck"
                       Layout="FormFieldLayout.Checkbox"
                       CssClass=""
                       Context="field">
                <input id="@field.Id" class="form-check-input" type="checkbox" @bind="_acknowledged" />
            </FormField>
        }
    </AppModal>
}

@code {
    private string _passphrase = string.Empty;
    private string _confirm = string.Empty;
    private bool _acknowledged;

    private bool CanSubmit
    {
        get
        {
            if (_passphrase.Length == 0)
            {
                return false;
            }

            if (Prompt.Current?.Mode != PassphrasePromptMode.Create)
            {
                return true;
            }

            return _passphrase == _confirm && _acknowledged;
        }
    }

    protected override void OnInitialized()
    {
        Prompt.Changed += OnPromptChanged;
    }

    private void OnPromptChanged()
    {
        // Never let a passphrase survive into the next prompt.
        _passphrase = string.Empty;
        _confirm = string.Empty;
        _acknowledged = false;

        InvokeAsync(StateHasChanged);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        // Enter only. Escape is AppModal's, and handling it here as well would cancel the prompt
        // twice as the event bubbles up to the dialog.
        if (e.Key == "Enter" && CanSubmit)
        {
            Submit();
        }
    }

    private void Submit()
    {
        var value = _passphrase;

        _passphrase = string.Empty;
        _confirm = string.Empty;
        _acknowledged = false;

        Prompt.Complete(value);
    }

    private void Cancel()
    {
        _passphrase = string.Empty;
        _confirm = string.Empty;
        _acknowledged = false;

        Prompt.Cancel();
    }

    public void Dispose()
    {
        Prompt.Changed -= OnPromptChanged;
    }
}
