@*
    The navigation icons, as inline SVG.

    Inline rather than an icon font or a CDN sprite for the same reason everything else
    here is: the app makes no network requests, and a font that fails to load leaves a row
    of empty boxes where the navigation used to be.

    All of them are 24x24, stroke-based, and inherit currentColor, so a link's colour and
    focus ring apply to the icon without a second set of rules. They carry aria-hidden:
    the accessible name belongs on the link, not on the glyph, or a screen reader announces
    it twice.
*@

<svg class="nav-icon @CssClass"
     viewBox="0 0 24 24"
     width="20"
     height="20"
     fill="none"
     stroke="currentColor"
     stroke-width="1.75"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">
    @switch (Name)
    {
        case "home":
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5.5 9.5V20h13V9.5" />
            <path d="M9.75 20v-5.5h4.5V20" />
            break;

        case "dashboard":
            <rect x="3" y="3" width="7.5" height="7.5" rx="1.5" />
            <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" />
            <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" />
            <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" />
            break;

        case "simulation":
            <path d="M3 3v18h18" />
            <path d="M6.5 15.5 10 11l3.5 3 4.5-6.5" />
            break;

        case "accounts":
            <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h11A2.5 2.5 0 0 1 19 7.5" />
            <rect x="3" y="7.5" width="18" height="11.5" rx="2.5" />
            <path d="M16 13.25h2.5" />
            break;

        case "transactions":
            <path d="M4 8.5h13" />
            <path d="M13.5 5 17 8.5 13.5 12" />
            <path d="M20 15.5H7" />
            <path d="M10.5 12 7 15.5 10.5 19" />
            break;

        case "mortgages":
            @* A percent inside a building: a rate charged against a property. Deliberately
               not a house outline - Home already owns that shape, and three near-identical
               houses in one row is worse than no icons at all. *@
            <path d="M4 20V7.5L12 4l8 3.5V20" />
            <path d="M2.5 20h19" />
            <circle cx="9" cy="10.75" r="1.25" />
            <circle cx="15" cy="16.25" r="1.25" />
            <path d="M15.75 10 8.25 17" />
            break;

        case "realestate":
            @* A key. Emphatically not a house: Home is already a house, Mortgages is a building
               with a percent in it, and House buy is a calculator - a fourth roofline in the same
               row would be indistinguishable from two of them at 20px. A key is ownership, which
               is exactly what separates this page from the mortgage that paid for it. *@
            <circle cx="7.5" cy="16.5" r="3.5" />
            <path d="M10 14 20 4" />
            <path d="M17 7l2.5 2.5" />
            <path d="M14.5 9.5 17 12" />
            break;

        case "creditcards":
            <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
            <path d="M2.5 9.5h19" />
            <path d="M6 15h4" />
            break;

        case "pillar3a":
            <path d="M12 3 4.5 6v6c0 4.5 3.2 7.9 7.5 9 4.3-1.1 7.5-4.5 7.5-9V6L12 3Z" />
            <path d="M9.5 12.25 11.25 14l3.25-3.5" />
            break;

        case "persons":
            <circle cx="9" cy="8.5" r="3.25" />
            <path d="M3 19.5a6 6 0 0 1 12 0" />
            <path d="M16.5 6.4a3.25 3.25 0 0 1 0 6.2" />
            <path d="M17.5 14.2a6 6 0 0 1 3.5 5.3" />
            break;

        case "housebuy":
            @* A calculator. The page answers "can I afford this house", and an affordability
               calculation is what distinguishes it from Mortgages. *@
            <rect x="4.5" y="2.5" width="15" height="19" rx="2.5" />
            <rect x="7.5" y="5.5" width="9" height="3.5" rx="1" />
            <path d="M8.25 13h.01M12 13h.01M15.75 13h.01" />
            <path d="M8.25 17h.01M12 17h.01M15.75 17h.01" />
            break;

        case "settings":
            <path d="M5 6.5h14" />
            <path d="M5 12h14" />
            <path d="M5 17.5h14" />
            <circle cx="9" cy="6.5" r="1.9" />
            <circle cx="15" cy="12" r="1.9" />
            <circle cx="8" cy="17.5" r="1.9" />
            break;

        default:
            <circle cx="12" cy="12" r="8.5" />
            break;
    }
</svg>

@code {
    /// <summary>Which glyph to draw. An unknown name renders a neutral circle rather than nothing.</summary>
    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? CssClass { get; set; }
}
