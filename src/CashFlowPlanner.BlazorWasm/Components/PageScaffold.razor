@using CashFlowPlanner.BlazorWasm.Services
@implements IDisposable

@inject CashFlowAppState AppState

@*
    The frame every routable page sits in: browser title, page heading, optional
    subtitle, a slot for page-level notifications, and the no-plan fallback.

    Three things were wrong before this existed and none of them were cosmetic:

    * App.razor renders <FocusOnNavigate Selector="h1" />. Nine pages had an <h1>,
      four led with an <h2> and one with an <h3>, so on five of fourteen routes the
      selector matched nothing and focus stayed on whatever the user had clicked in
      the nav. A keyboard or screen-reader user was silently dropped back at the top
      of the navigation on every one of those routes. The heading is emitted here so
      it cannot be the wrong level.
    * That <h1> also carries tabindex="-1". A heading is not focusable by default, so
      even on the nine pages that had one, FocusOnNavigate's focus() call did nothing.
      This is the half of the fix that is easy to miss.
    * Three pages had no <PageTitle> at all, leaving the browser tab and any bookmark
      showing the previous route's title.

    The heading renders as .h3 rather than at h1's default size: the four pages that
    used an h2 and the one that used an h3 keep the size they had, and only the markup
    changes. Sizing is a class; structure is not.
*@

<PageTitle>@EffectiveDocumentTitle</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        @*
            tabindex="-1" makes the heading programmatically focusable without adding
            it to the tab order. FocusOnNavigate needs this; nobody tabbing through the
            page will notice it.
        *@
        <h1 class="h3 mb-0" tabindex="-1">@Title</h1>

        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="text-body-secondary mb-0 mt-1">@Subtitle</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="d-flex flex-wrap gap-2">
            @Actions
        </div>
    }
</div>

@if (Notifications is not null)
{
    <div class="mb-3">
        @Notifications
    </div>
}

@if (ShowEmptyState)
{
    <PlanEmptyState Message="@EmptyStateMessage" />
}
else
{
    @ChildContent
}

@code {
    /// <summary>
    /// Appended to <see cref="Title"/> for the browser tab, matching what the eleven pages that
    /// already set a title did by hand.
    /// </summary>
    private const string AppName = "CashFlow Planner";

    /// <summary>The page heading. Also the browser title unless <see cref="DocumentTitle"/> is set.</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Overrides the browser title outright, suffix included. Home wants a bare "CashFlow Planner"
    /// rather than "CashFlow Planner - CashFlow Planner".
    /// </summary>
    [Parameter]
    public string? DocumentTitle { get; set; }

    /// <summary>One sentence under the heading explaining what the page is for.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Page-level buttons, laid out on the heading row.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Alerts and inline feedback, above the content and below the heading. Kept as a slot rather
    /// than hardwired to UiFeedbackService because most pages show their own validation errors here
    /// too.
    /// </summary>
    [Parameter]
    public RenderFragment? Notifications { get; set; }

    /// <summary>
    /// When true and no plan is loaded, the page body is replaced by <see cref="PlanEmptyState"/>.
    /// Pages no longer need their own "no plan loaded" branch, and cannot forget one.
    /// </summary>
    [Parameter]
    public bool RequiresPlan { get; set; }

    /// <summary>Page-specific lead sentence for the empty state.</summary>
    [Parameter]
    public string? EmptyStateMessage { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool ShowEmptyState => RequiresPlan && !AppState.HasPlan;

    private string EffectiveDocumentTitle =>
        DocumentTitle ?? (string.IsNullOrWhiteSpace(Title) ? AppName : $"{Title} - {AppName}");

    protected override void OnInitialized()
    {
        // Without this the empty state stays on screen after the user loads a plan through one of
        // its own three buttons: the scaffold owns the branch, so the scaffold has to hear about it.
        AppState.Changed += OnAppStateChanged;
    }

    private void OnAppStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AppState.Changed -= OnAppStateChanged;
    }
}
