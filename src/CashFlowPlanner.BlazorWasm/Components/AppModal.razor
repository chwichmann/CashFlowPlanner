@using CashFlowPlanner.BlazorWasm.Resources
@using Microsoft.Extensions.Localization

@implements IAsyncDisposable

@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

@*
    The app's one dialog.

    There were three modal implementations and between them they did none of this. Only one set
    aria-modal. None trapped focus, so Tab walked straight out of the dialog and into the page
    behind it, where a screen reader happily read out content the user could not see. None restored
    focus on close, so dismissing a delete confirmation dropped the keyboard user back at the top of
    the document. None locked the body, so the page scrolled behind the backdrop. Two of the three
    ignored Escape.

    What is in C# and what is in JavaScript is deliberate: Escape and the focus trap are here, where
    they can be tested, and only the page lock and the focus restore - which need document.body and
    document.activeElement - are in the collocated AppModal.razor.js.
*@

@if (Visible)
{
    <div class="modal fade show d-block"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@TitleId"
         tabindex="-1"
         @ref="_dialog"
         @onkeydown="OnKeyDownAsync">

        @*
            Focus guards. Tabbing past the end of the dialog lands on the trailing one, which sends
            focus back to the top, and shift-tabbing off the front lands on the leading one, which
            sends it to the bottom. They are the whole trap; there is no keystroke bookkeeping to
            get wrong.
        *@
        <span tabindex="0" class="visually-hidden" aria-hidden="true" @onfocus="FocusLastAsync"></span>

        <div class="modal-dialog modal-dialog-centered @SizeCssClass">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="@TitleId">@Title</h2>

                    @if (ShowCloseButton)
                    {
                        <button type="button"
                                class="btn-close"
                                aria-label="@L["Dialog_Close"]"
                                @ref="_closeButton"
                                @onclick="CancelAsync">
                        </button>
                    }
                </div>

                <div class="modal-body">
                    @ChildContent
                </div>

                @if (RendersFooter)
                {
                    <div class="modal-footer">
                        @if (FooterContent is not null)
                        {
                            @FooterContent
                        }
                        else
                        {
                            @*
                                Standard order, everywhere: the way out on the left, the thing that
                                commits on the right. The three old dialogs each chose their own.
                            *@
                            @if (ShowCancelButton)
                            {
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @ref="_cancelButton"
                                        @onclick="CancelAsync">
                                    @(CancelText ?? L["Cancel"].Value)
                                </button>
                            }

                            @if (ShowConfirmButton)
                            {
                                <button type="button"
                                        class="@ConfirmCssClass"
                                        disabled="@ConfirmDisabled"
                                        @ref="_confirmButton"
                                        @onclick="ConfirmAsync">
                                    @(ConfirmText ?? L["Save"].Value)
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <span tabindex="0" class="visually-hidden" aria-hidden="true" @onfocus="FocusFirstAsync"></span>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {
    private static int _sequence;

    /// <summary>Whether the dialog is on screen. Everything else follows from this flipping.</summary>
    [Parameter]
    public bool Visible { get; set; }

    /// <summary>
    /// The dialog's heading, and the text <c>aria-labelledby</c> points at. A dialog without one is
    /// announced as just "dialog".
    /// </summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Replaces both standard buttons. Use it sparingly - the standard order is the point.</summary>
    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    /// <summary>Left-hand button text. Defaults to the shared "Cancel".</summary>
    [Parameter]
    public string? CancelText { get; set; }

    /// <summary>Right-hand button text. Defaults to the shared "Save".</summary>
    [Parameter]
    public string? ConfirmText { get; set; }

    /// <summary>Classes on the commit button, e.g. <c>btn btn-danger</c> for a deletion.</summary>
    [Parameter]
    public string ConfirmCssClass { get; set; } = "btn btn-primary";

    [Parameter]
    public bool ConfirmDisabled { get; set; }

    [Parameter]
    public bool ShowCancelButton { get; set; } = true;

    [Parameter]
    public bool ShowConfirmButton { get; set; } = true;

    /// <summary>The header's close button. Off for a dialog that must be answered, not dismissed.</summary>
    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    /// <summary>A Bootstrap size class, e.g. <c>modal-lg</c>.</summary>
    [Parameter]
    public string? SizeCssClass { get; set; }

    /// <summary>Raised by the commit button.</summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>
    /// Raised by the cancel button, the close button and Escape alike. There is one way out, so a
    /// caller cannot handle two of the three and forget the third.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Where focus goes when the dialog opens - a text box, usually. Left unset, focus lands on the
    /// close button, or on the first button there is, or on the dialog itself.
    /// </summary>
    [Parameter]
    public ElementReference? InitialFocus { get; set; }

    private readonly string _titleId = $"modal-title-{System.Threading.Interlocked.Increment(ref _sequence).ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private ElementReference _dialog;
    private ElementReference _closeButton;
    private ElementReference _cancelButton;
    private ElementReference _confirmButton;

    private IJSObjectReference? _module;
    private bool _isOpen;

    private string TitleId => _titleId;

    private bool RendersFooter =>
        FooterContent is not null || ShowCancelButton || ShowConfirmButton;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible == _isOpen)
        {
            return;
        }

        _isOpen = Visible;

        if (Visible)
        {
            await InvokeModuleAsync("open");
            await FocusFirstAsync();
        }
        else
        {
            await InvokeModuleAsync("close");
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CancelAsync();
        }
    }

    private Task ConfirmAsync() => OnConfirm.InvokeAsync();

    private Task CancelAsync() => OnCancel.InvokeAsync();

    /// <summary>Sends focus to the top of the dialog: the caller's choice, or its first control.</summary>
    private async Task FocusFirstAsync()
    {
        // An InitialFocus captured with @ref is still empty on the render that opens the dialog -
        // the caller's field is only assigned once the element exists. Falling through to the
        // chrome then is right: focus lands inside the dialog either way, which is the thing that
        // matters.
        var target = FirstOf(InitialFocus ?? default, _closeButton, _cancelButton, _confirmButton)
            ?? _dialog;

        await FocusAsync(target);
    }

    /// <summary>Sends focus to the bottom of the dialog.</summary>
    private async Task FocusLastAsync()
    {
        // Reverse order: the commit button is the last thing in the footer, and the footer is the
        // last thing in the dialog.
        var target = FirstOf(_confirmButton, _cancelButton, _closeButton) ?? _dialog;

        await FocusAsync(target);
    }

    /// <summary>
    /// The first of these that was actually rendered. An <see cref="ElementReference"/> that was
    /// never assigned has a null id, and focusing it throws.
    /// </summary>
    private static ElementReference? FirstOf(params ElementReference[] candidates)
    {
        foreach (var candidate in candidates)
        {
            if (!string.IsNullOrEmpty(candidate.Id))
            {
                return candidate;
            }
        }

        return null;
    }

    private static async Task FocusAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (JSException)
        {
            // The element went away between render and focus. Not worth taking the dialog down for.
        }
        catch (InvalidOperationException)
        {
            // No renderer to dispatch through - prerendering, or a torn-down test.
        }
    }

    private async Task InvokeModuleAsync(string identifier)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/AppModal.razor.js");

            await _module.InvokeVoidAsync(identifier);
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; there is nothing left to unlock.
        }
        catch (JSException)
        {
            // The page lock and focus restore are an improvement, not a precondition. A dialog that
            // works without them beats a dialog that throws.
        }
        catch (TaskCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_isOpen)
        {
            // Disposed while open - a navigation, usually. Without this the body keeps .modal-open
            // and the page behind can never be scrolled again.
            await InvokeModuleAsync("close");
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }
    }
}
