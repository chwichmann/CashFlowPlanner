<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- TargetFramework / Nullable / ImplicitUsings come from ../../Directory.Build.props -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!--
      REQUIRED - do not remove without changing how the culture is set.

      Program.cs reads the user's saved language/region preference and applies it
      with CultureInfo.DefaultThreadCurrentCulture *after* the runtime has
      started. Blazor calls that "changing culture dynamically during startup",
      and it is only supported when all globalization data is loaded. Removing
      this property to save ICU bytes (finding B6) shipped a build that reached
      100% and then died with:

        Blazor detected a change in the application's culture that is not
        supported with the current project configuration.

      The sharded-ICU saving is real (550 KB EFIGS / 1.11 MB no_CJK against
      1.53 MB full) but it cannot be taken while the culture is chosen in
      Program.cs. To claim it, the culture must instead be passed to
      blazor.start({ applicationCulture: ... }) in wwwroot/index.html before the
      runtime boots, so no dynamic switch ever happens. Tracked in
      docs/STABILIZATION-PLAN.md.

      Do NOT set InvariantGlobalization either: the app formats CHF/EUR amounts
      and parses localised dates.
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Pages\HouseBuySimulator.razor.css" />
  </ItemGroup>

  <!--
    The bundled example plan is embedded in the assembly rather than served from
    wwwroot, so loading it needs no HttpClient and the app keeps making zero
    network requests. See Services/StarterPlanProvider.cs.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\StarterPlan.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Pages\HouseBuySimulator.razor.css">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    B6 - prune wwwroot/lib from the published artifact.

    Bootstrap ships ~11 MB under wwwroot/lib: source maps, RTL variants,
    unminified builds and six JavaScript bundles. index.html loads exactly one
    of those files (bootstrap.min.css) and no Bootstrap JavaScript at all - the
    navbar toggle is hand-rolled. Everything else is excluded from *publish*
    only; the files stay on disk and are still served by `dotnet run`, so
    source maps remain available while debugging locally.
  -->
  <ItemGroup>
    <Content Update="wwwroot\lib\**" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot\lib\bootstrap\dist\css\bootstrap.min.css" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashFlowPlanner.Core\CashFlowPlanner.Core.csproj" />
    <ProjectReference Include="..\CashFlowPlanner.Storage.Json\CashFlowPlanner.Storage.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\SharedResource.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
