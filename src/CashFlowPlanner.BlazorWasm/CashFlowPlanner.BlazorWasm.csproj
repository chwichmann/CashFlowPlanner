<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- TargetFramework / Nullable / ImplicitUsings come from ../../Directory.Build.props -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <!--
    B5 - TreatWarningsAsErrors is on repo-wide (../../Directory.Build.props).
    These two diagnostics are demoted back to warnings *for this project only*
    because three genuine occurrences pre-date the gate:

      CS8602  Pages/Transactions.razor:600  dereference of a possibly null reference
      CS8620  Pages/BankImport.razor:746    object?[] -> object[] for IStringLocalizer
      CS8620  Pages/Accounts.razor:820      object?[] -> object[] for IStringLocalizer

    TODO(B5): fix those three call sites, then delete this WarningsNotAsErrors
    line so CS8602/CS8620 fail the build here too. Tracked in
    docs/STABILIZATION-PLAN.md finding B5. Every other warning, in every
    project including this one, is already an error.
  -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8602;CS8620</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Pages\HouseBuySimulator.razor.css" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Pages\HouseBuySimulator.razor.css">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.6" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashFlowPlanner.Core\CashFlowPlanner.Core.csproj" />
    <ProjectReference Include="..\CashFlowPlanner.Storage.Json\CashFlowPlanner.Storage.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\SharedResource.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
