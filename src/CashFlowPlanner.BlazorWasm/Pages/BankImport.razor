@page "/bank-import"

@using CashFlowPlanner.BlazorWasm.Resources
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject IStringLocalizer<SharedResource> L

@*
    Kept as a route so existing links and bookmarks still resolve, but off the navigation
    bar: the import lives on the Accounts page now. Everything is in
    Components/BankStatementImport.razor.
*@

<PageScaffold Title='@L["BankImport_Title"]'
              RequiresPlan="true"
              EmptyStateMessage='@L["BankImport_NoPlanLoaded"]'>
    <ChildContent>
        <BankStatementImport />
    </ChildContent>
</PageScaffold>
