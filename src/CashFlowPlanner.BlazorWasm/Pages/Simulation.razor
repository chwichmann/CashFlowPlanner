@page "/simulation"

@using System.Globalization
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Components.Charts
@using CashFlowPlanner.Core.Mortgages
@using Microsoft.Extensions.Localization

@inject MonthlyCashflowSummaryService MonthlySummaryService
@inject CashFlowAppState AppState
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL

<PageTitle>@L["Simulation"] - CashFlow Planner</PageTitle>

<h2>@L["Simulation"]</h2>

@if (AppState.CurrentPlan is null)
{
    <div class="alert alert-warning">
        @L["Simulation_NoPlanLoaded"]
    </div>
}
else
{
    var plan = AppState.CurrentPlan;

    @if (AppState.CurrentSimulationResult is null)
    {
        <div class="alert alert-info">
            @L["Simulation_NoSimulationResult"]
        </div>
    }
    else
    {
        var result = AppState.CurrentSimulationResult;
        var monthlySummaries = MonthlySummaryService.CreateMonthlySummary(plan, result);
        var fullMonthSummaries = monthlySummaries
            .Where(x => IsFullMonthInsideSimulationRange(x.Label, result.StartDate, result.EndDate))
            .ToList();

        <div class="card mb-4">
            <div class="card-header">
                <strong>@L["Simulation_Result"]</strong>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">@L["Simulation_Range"]</dt>
                    <dd class="col-sm-9">@FormatDate(result.StartDate) - @FormatDate(result.EndDate)</dd>

                    <dt class="col-sm-3">@L["Simulation_Events"]</dt>
                    <dd class="col-sm-9">@result.Events.Count</dd>

                    <dt class="col-sm-3">@L["Simulation_BalancePoints"]</dt>
                    <dd class="col-sm-9">@result.BalancePoints.Count</dd>

                    <dt class="col-sm-3">@L["Simulation_MortgagePrincipalPoints"]</dt>
                    <dd class="col-sm-9">@result.MortgagePrincipalPoints.Count</dd>

                    <dt class="col-sm-3">@L["Simulation_Warnings"]</dt>
                    <dd class="col-sm-9">@result.Warnings.Count</dd>
                </dl>
            </div>
        </div>

        <h4>@L["Simulation_MonthlyCashflowSummary"]</h4>

        @if (fullMonthSummaries.Count == 0)
        {
            <div class="alert alert-info">
                @L["Simulation_NoCompleteMonthCovered"]
            </div>
        }
        else
        {
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>@L["Simulation_Month"]</th>
                        <th class="text-end">@L["Simulation_Income"]</th>
                        <th class="text-end">@L["Simulation_Expenses"]</th>
                        <th class="text-end">@L["Simulation_InternalOut"]</th>
                        <th class="text-end">@L["Simulation_InternalIn"]</th>
                        <th class="text-end">@L["Simulation_MortgagePayments"]</th>
                        <th class="text-end">@L["Simulation_NetCashflow"]</th>
                        <th class="text-end">@L["Simulation_EndLiquidBalance"]</th>
                        <th class="text-end">@L["Simulation_Warnings"]</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var month in fullMonthSummaries)
                    {
                        <tr>
                            <td>@FormatMonthLabel(month.Label)</td>
                            <td class="text-end">@FormatAmount(month.Income)</td>
                            <td class="text-end">@FormatAmount(month.Expenses)</td>
                            <td class="text-end">@FormatAmount(month.InternalTransfersOut)</td>
                            <td class="text-end">@FormatAmount(month.InternalTransfersIn)</td>
                            <td class="text-end">@FormatAmount(month.MortgagePayments)</td>
                            <td class="text-end">@FormatAmount(month.NetCashflow)</td>
                            <td class="text-end">@FormatAmount(month.EndLiquidBalance)</td>
                            <td class="text-end">
                                @if (month.WarningCount > 0)
                                {
                                    <span class="badge bg-warning text-dark">@month.WarningCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* If/when a monthly chart is added here, use fullMonthSummaries as its data source.
           Do not use monthlySummaries directly, because monthlySummaries can contain partial edge months. *@

        @if (plan.Mortgages.Count > 0)
        {
            <h4>@L["Simulation_MortgageSummary"]</h4>

            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>@L["Simulation_Mortgage"]</th>
                        <th>@L["Type"]</th>
                        <th>@L["Simulation_Amortisation"]</th>
                        <th class="text-end">@L["Simulation_StartPrincipal"]</th>
                        <th class="text-end">@L["Simulation_ProjectedEndPrincipal"]</th>
                        <th class="text-end">@L["Simulation_PrincipalChange"]</th>
                        <th>@L["Currency"]</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var mortgage in plan.Mortgages.OrderBy(x => x.Name))
                    {
                        var startPrincipal = mortgage.CalculationPrincipal ?? mortgage.InitialPrincipal;
                        var endPrincipal = GetProjectedMortgagePrincipal(
                            mortgage,
                            result,
                            result.EndDate);
                        var change = endPrincipal - startPrincipal;

                        <tr>
                            <td>@mortgage.Name</td>
                            <td>@EnumL.Translate(mortgage.Type)</td>
                            <td>@EnumL.Translate(mortgage.AmortisationMode)</td>
                            <td class="text-end">@FormatAmount(startPrincipal)</td>
                            <td class="text-end">@FormatAmount(endPrincipal)</td>
                            <td class="text-end">@FormatAmount(change)</td>
                            <td>@plan.BaseCurrency</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h4>@L["Simulation_MortgageProjection"]</h4>

            @if (result.MortgagePrincipalPoints.Count == 0)
            {
                <div class="alert alert-info">
                    @L["Simulation_NoMortgagePrincipalProjection"]
                </div>
            }
            else
            {
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>@L["Date"]</th>
                            <th>@L["Simulation_Mortgage"]</th>
                            <th>@L["Type"]</th>
                            <th>@L["Simulation_Amortisation"]</th>
                            <th class="text-end">@L["Simulation_Principal"]</th>
                            <th>@L["Currency"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var point in result.MortgagePrincipalPoints
                            .OrderBy(x => x.Date)
                            .ThenBy(x => x.MortgageName))
                        {
                            var mortgage = plan.Mortgages.SingleOrDefault(x => x.Id == point.MortgageId);

                            <tr>
                                <td>@FormatDate(point.Date)</td>
                                <td>@point.MortgageName</td>
                                <td>@(mortgage is null ? string.Empty : EnumL.Translate(mortgage.Type))</td>
                                <td>@(mortgage is null ? string.Empty : EnumL.Translate(mortgage.AmortisationMode))</td>
                                <td class="text-end">@FormatAmount(point.Principal)</td>
                                <td>@point.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            var mortgageIds = plan.Mortgages
                .Select(x => x.Id)
                .ToHashSet();

            var mortgageEvents = result.Events
                .Where(x => mortgageIds.Contains(x.SourceTransactionId))
                .OrderBy(x => x.Date)
                .ThenBy(x => x.Priority)
                .ThenBy(x => x.Name)
                .ToList();

            <h4>@L["Simulation_MortgageEvents"]</h4>

            @if (mortgageEvents.Count == 0)
            {
                <div class="alert alert-info">
                    @L["Simulation_NoMortgageEvents"]
                </div>
            }
            else
            {
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>@L["Date"]</th>
                            <th>@L["Name"]</th>
                            <th>@L["Kind"]</th>
                            <th>@L["Transaction_FromAccount"]</th>
                            <th>@L["Transaction_ToAccount"]</th>
                            <th class="text-end">@L["Amount"]</th>
                            <th>@L["Category"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var cashFlowEvent in mortgageEvents)
                        {
                            <tr>
                                <td>@FormatDate(cashFlowEvent.Date)</td>
                                <td>@cashFlowEvent.Name</td>
                                <td>@EnumL.Translate(cashFlowEvent.Kind)</td>
                                <td>@GetAccountName(cashFlowEvent.FromAccountId)</td>
                                <td>@GetAccountName(cashFlowEvent.ToAccountId)</td>
                                <td class="text-end">@FormatAmount(cashFlowEvent.Amount) @cashFlowEvent.Currency</td>
                                <td>@cashFlowEvent.Category</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }

        @if (plan.CreditCards.Count > 0)
        {
            var creditCardIds = plan.CreditCards
                .Select(x => x.Id)
                .ToHashSet();

            var creditCardEvents = result.Events
                .Where(x => creditCardIds.Contains(x.SourceTransactionId))
                .OrderBy(x => x.Date)
                .ThenBy(x => x.Priority)
                .ThenBy(x => x.Name)
                .ToList();

            <h4>@L["Simulation_CreditCardPaymentEvents"]</h4>

            @if (creditCardEvents.Count == 0)
            {
                <div class="alert alert-info">
                    @L["Simulation_NoCreditCardPaymentEvents"]
                </div>
            }
            else
            {
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>@L["Date"]</th>
                            <th>@L["Name"]</th>
                            <th>@L["Transaction_FromAccount"]</th>
                            <th>@L["Transaction_ToAccount"]</th>
                            <th class="text-end">@L["Amount"]</th>
                            <th>@L["CreditCard_Method"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var cashFlowEvent in creditCardEvents)
                        {
                            <tr>
                                <td>@FormatDate(cashFlowEvent.Date)</td>
                                <td>@cashFlowEvent.Name</td>
                                <td>@GetAccountName(cashFlowEvent.FromAccountId)</td>
                                <td>@GetAccountName(cashFlowEvent.ToAccountId)</td>
                                <td class="text-end">@FormatAmount(cashFlowEvent.Amount) @cashFlowEvent.Currency</td>
                                <td>@EnumL.Translate(cashFlowEvent.PaymentMethod)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }

        var timelineRows = BuildTimelineRows(result)
            .Take(300)
            .ToList();

        <h4>@L["Simulation_EventsAndWarnings"]</h4>

        @if (timelineRows.Count == 0)
        {
            <div class="alert alert-info">
                @L["Simulation_NoEventsOrWarnings"]
            </div>
        }
        else
        {
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>@L["Date"]</th>
                        <th>@L["Type"]</th>
                        <th>@L["Simulation_NameOrCode"]</th>
                        <th>@L["Simulation_KindOrSeverity"]</th>
                        <th>@L["Transaction_FromAccount"]</th>
                        <th>@L["Transaction_ToAccount"]</th>
                        <th class="text-end">@L["Amount"]</th>
                        <th>@L["Currency"]</th>
                        <th>@L["Simulation_CategoryOrMessage"]</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var row in timelineRows)
                    {
                        <tr class="@row.RowCssClass">
                            <td>@FormatDate(row.Date)</td>
                            <td>
                                @if (row.IsWarning)
                                {
                                    <span class="badge bg-warning text-dark">@L["Simulation_Warning"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@L["Simulation_Event"]</span>
                                }
                            </td>
                            <td>@row.Title</td>
                            <td>@row.KindOrSeverity</td>
                            <td>@row.FromAccountName</td>
                            <td>@row.ToAccountName</td>
                            <td class="text-end">@row.AmountText</td>
                            <td>@row.Currency</td>
                            <td>@row.MessageOrCategory</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (result.Events.Count + result.Warnings.Count > timelineRows.Count)
            {
                <div class="alert alert-info">
                    @Text("Simulation_ShowingFirstCombinedRowsOnly", timelineRows.Count)
                </div>
            }
        }
    }
}

@code {
    private string GetAccountName(Guid? accountId)
    {
        if (accountId is null || AppState.CurrentPlan is null)
        {
            return "-";
        }

        return AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == accountId.Value)
            ?.Name ?? "?";
    }

    private static decimal GetProjectedMortgagePrincipal(
        MortgageContract mortgage,
        SimulationResult result,
        DateOnly date)
    {
        var projectedPrincipal = result.GetMortgagePrincipal(
            mortgage.Id,
            date);

        if (projectedPrincipal > 0)
        {
            return projectedPrincipal;
        }

        return mortgage.CalculationPrincipal ?? mortgage.InitialPrincipal;
    }

    private static bool IsFullMonthInsideSimulationRange(
        string monthLabel,
        DateOnly simulationStart,
        DateOnly simulationEnd)
    {
        if (!TryParseMonthLabel(monthLabel, out var monthStart, out var monthEnd))
        {
            return false;
        }

        return monthStart >= simulationStart &&
               monthEnd <= simulationEnd;
    }

    private static bool TryParseMonthLabel(
        string monthLabel,
        out DateOnly monthStart,
        out DateOnly monthEnd)
    {
        monthStart = default;
        monthEnd = default;

        var parts = monthLabel.Split('-', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length != 2)
        {
            return false;
        }

        if (!int.TryParse(parts[0], out var year))
        {
            return false;
        }

        if (!int.TryParse(parts[1], out var month))
        {
            return false;
        }

        if (month < 1 || month > 12)
        {
            return false;
        }

        monthStart = new DateOnly(year, month, 1);
        monthEnd = new DateOnly(
            year,
            month,
            DateTime.DaysInMonth(year, month));

        return true;
    }

    private IReadOnlyList<TimelineRow> BuildTimelineRows(SimulationResult result)
    {
        var rows = new List<TimelineRow>();

        foreach (var cashFlowEvent in result.Events)
        {
            rows.Add(new TimelineRow
            {
                Date = cashFlowEvent.Date,
                SortOrder = cashFlowEvent.Priority,
                IsWarning = false,
                Title = cashFlowEvent.Name,
                KindOrSeverity = EnumL.Translate(cashFlowEvent.Kind),
                FromAccountName = GetAccountName(cashFlowEvent.FromAccountId),
                ToAccountName = GetAccountName(cashFlowEvent.ToAccountId),
                AmountText = FormatAmount(cashFlowEvent.Amount),
                Currency = cashFlowEvent.Currency,
                MessageOrCategory = cashFlowEvent.Category ?? string.Empty,
                RowCssClass = string.Empty
            });
        }

        foreach (var warning in result.Warnings)
        {
            rows.Add(new TimelineRow
            {
                Date = warning.Date ?? result.StartDate,
                SortOrder = 10_000,
                IsWarning = true,
                Title = warning.Code,
                KindOrSeverity = warning.Severity.ToString(),
                FromAccountName = warning.AccountId is null
                    ? "-"
                    : GetAccountName(warning.AccountId),
                ToAccountName = "-",
                AmountText = string.Empty,
                Currency = string.Empty,
                MessageOrCategory = warning.Message,
                RowCssClass = "table-warning"
            });
        }

        return rows
            .OrderBy(x => x.Date)
            .ThenBy(x => x.SortOrder)
            .ThenBy(x => x.IsWarning)
            .ThenBy(x => x.Title)
            .ToList();
    }

    private static string FormatDate(DateOnly date)
    {
        return date.ToString("d", CultureInfo.CurrentCulture);
    }

    private static string FormatAmount(decimal amount)
    {
        return amount.ToString("N2", CultureInfo.CurrentCulture);
    }

    private static string FormatMonthLabel(string monthLabel)
    {
        if (!TryParseMonthLabel(monthLabel, out var monthStart, out _))
        {
            return monthLabel;
        }

        return monthStart.ToString("Y", CultureInfo.CurrentCulture);
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private sealed class TimelineRow
    {
        public DateOnly Date { get; init; }

        public int SortOrder { get; init; }

        public bool IsWarning { get; init; }

        public string Title { get; init; } = string.Empty;

        public string KindOrSeverity { get; init; } = string.Empty;

        public string FromAccountName { get; init; } = string.Empty;

        public string ToAccountName { get; init; } = string.Empty;

        public string AmountText { get; init; } = string.Empty;

        public string Currency { get; init; } = string.Empty;

        public string MessageOrCategory { get; init; } = string.Empty;

        public string RowCssClass { get; init; } = string.Empty;
    }
}