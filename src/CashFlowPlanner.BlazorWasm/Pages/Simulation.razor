@page "/simulation"

@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Components.Charts
@using CashFlowPlanner.Core.Mortgages
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject MonthlyCashflowSummaryService MonthlySummaryService
@inject CashFlowAppState AppState
@inject AppFormatter Formatter
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL

<PageScaffold Title='@L["Simulation"]'
              RequiresPlan="true"
              EmptyStateMessage='@L["Simulation_NoPlanLoaded"]'>

    @if (AppState.CurrentPlan is null || AppState.CurrentSimulationResult is null)
    {
        <div class="alert alert-info" role="alert">
            @L["Simulation_NoSimulationResult"]
        </div>
    }
    else
    {
        var plan = AppState.CurrentPlan;
        var result = AppState.CurrentSimulationResult;
        var monthlySummaries = MonthlySummaryService.CreateMonthlySummary(plan, result);
        var fullMonthSummaries = monthlySummaries
            .Where(x => IsFullMonthInsideSimulationRange(x.Label, result.StartDate, result.EndDate))
            .ToList();

        @*
            The warnings, before the numbers they qualify. They were only in the timeline table at
            the bottom of the page - as a raw code and an English sentence, sorted in among a few
            hundred events - which is a log rather than a warning. The table stays; this is the
            part a user actually reads.
        *@
        <SimulationWarningPanel Warnings="result.Warnings"
                                DescribeSource="DescribeWarningSource" />

        <div class="card mb-4">
            <div class="card-header">
                <strong>@L["Simulation_Result"]</strong>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">@L["Simulation_Range"]</dt>
                    <dd class="col-sm-9">@Formatter.Date(result.StartDate) - @Formatter.Date(result.EndDate)</dd>

                    <dt class="col-sm-3">@L["Simulation_Events"]</dt>
                    <dd class="col-sm-9">@result.Events.Count</dd>

                    <dt class="col-sm-3">@L["Simulation_BalancePoints"]</dt>
                    <dd class="col-sm-9">@result.BalancePoints.Count</dd>

                    <dt class="col-sm-3">@L["Simulation_MortgagePrincipalPoints"]</dt>
                    <dd class="col-sm-9">@result.MortgagePrincipalPoints.Count</dd>

                    <dt class="col-sm-3">@L["Simulation_Warnings"]</dt>
                    <dd class="col-sm-9">@result.Warnings.Count</dd>
                </dl>
            </div>
        </div>

        <h4>@L["Simulation_MonthlyCashflowSummary"]</h4>

        <DataTable Items="fullMonthSummaries"
                   RowKey="@(month => month.Label)"
                   EmptyText='@L["Simulation_NoCompleteMonthCovered"]'
                   Caption='@L["Simulation_MonthlyCashflowSummary"]'>
            <Column Title='@L["Simulation_Month"]' Text="@(month => Formatter.MonthLabel(month.Label))" />
            <Column Title='@L["Simulation_Income"]' Align="ColumnAlign.Number"
                    Text="@(month => Formatter.Money(month.Income))" />
            <Column Title='@L["Simulation_Expenses"]' Align="ColumnAlign.Number"
                    Text="@(month => Formatter.Money(month.Expenses))" />
            <Column Title='@L["Simulation_InternalOut"]' Align="ColumnAlign.Number"
                    Text="@(month => Formatter.Money(month.InternalTransfersOut))" />
            <Column Title='@L["Simulation_InternalIn"]' Align="ColumnAlign.Number"
                    Text="@(month => Formatter.Money(month.InternalTransfersIn))" />
            <Column Title='@L["Simulation_MortgagePayments"]' Align="ColumnAlign.Number"
                    Text="@(month => Formatter.Money(month.MortgagePayments))" />
            <Column Title='@L["Simulation_NetCashflow"]' Align="ColumnAlign.Number"
                    Text="@(month => Formatter.Money(month.NetCashflow))" />
            <Column Title='@L["Simulation_EndLiquidBalance"]' Align="ColumnAlign.Number"
                    Text="@(month => Formatter.Money(month.EndLiquidBalance))" />
            <Column Title='@L["Simulation_Warnings"]' Align="ColumnAlign.Number">
                <ChildContent>
                    @if (context.WarningCount > 0)
                    {
                        <span class="badge bg-warning text-dark">@context.WarningCount</span>
                    }
                    else
                    {
                        <span class="text-muted">0</span>
                    }
                </ChildContent>
            </Column>
        </DataTable>

        @* If/when a monthly chart is added here, use fullMonthSummaries as its data source.
           Do not use monthlySummaries directly, because monthlySummaries can contain partial edge months. *@

        @if (plan.Mortgages.Count > 0)
        {
            <h4>@L["Simulation_MortgageSummary"]</h4>

            <DataTable Items="@plan.Mortgages.OrderBy(x => x.Name).ToList()"
                       RowKey="@(mortgage => mortgage.Id)"
                       Caption='@L["Simulation_MortgageSummary"]'>
                <Column Title='@L["Simulation_Mortgage"]' Text="@(mortgage => mortgage.Name)" />
                <Column Title='@L["Type"]' Text="@(mortgage => EnumL.Translate(mortgage.Type))" />
                <Column Title='@L["Simulation_Amortisation"]'
                        Text="@(mortgage => EnumL.Translate(mortgage.AmortisationMode))" />
                <Column Title='@L["Simulation_StartPrincipal"]' Align="ColumnAlign.Number"
                        Text="@(mortgage => Formatter.Money(GetStartPrincipal(mortgage)))" />
                <Column Title='@L["Simulation_ProjectedEndPrincipal"]' Align="ColumnAlign.Number"
                        Text="@(mortgage => Formatter.Money(GetProjectedMortgagePrincipal(mortgage, result, result.EndDate)))" />
                <Column Title='@L["Simulation_PrincipalChange"]' Align="ColumnAlign.Number"
                        Text="@(mortgage => Formatter.Money(
                                   GetProjectedMortgagePrincipal(mortgage, result, result.EndDate)
                                   - GetStartPrincipal(mortgage)))" />
                <Column Title='@L["Currency"]' Text="@(mortgage => plan.BaseCurrency)" />
            </DataTable>

            <h4>@L["Simulation_MortgageProjection"]</h4>

            <DataTable Items="@result.MortgagePrincipalPoints.OrderBy(x => x.Date).ThenBy(x => x.MortgageName).ToList()"
                       EmptyText='@L["Simulation_NoMortgagePrincipalProjection"]'
                       Caption='@L["Simulation_MortgageProjection"]'>
                <Column Title='@L["Date"]' Text="@(point => Formatter.Date(point.Date))" />
                <Column Title='@L["Simulation_Mortgage"]' Text="@(point => point.MortgageName)" />
                <Column Title='@L["Type"]' Text="@(point => GetMortgageTypeName(plan, point.MortgageId))" />
                <Column Title='@L["Simulation_Amortisation"]'
                        Text="@(point => GetMortgageAmortisationName(plan, point.MortgageId))" />
                <Column Title='@L["Simulation_Principal"]' Align="ColumnAlign.Number"
                        Text="@(point => Formatter.Money(point.Principal))" />
                <Column Title='@L["Currency"]' Text="@(point => point.Currency)" />
            </DataTable>

            var mortgageIds = plan.Mortgages
                .Select(x => x.Id)
                .ToHashSet();

            var mortgageEvents = result.Events
                .Where(x => mortgageIds.Contains(x.SourceTransactionId))
                .OrderBy(x => x.Date)
                .ThenBy(x => x.Priority)
                .ThenBy(x => x.Name)
                .ToList();

            <h4>@L["Simulation_MortgageEvents"]</h4>

            <DataTable Items="mortgageEvents"
                       EmptyText='@L["Simulation_NoMortgageEvents"]'
                       Caption='@L["Simulation_MortgageEvents"]'>
                <Column Title='@L["Date"]' Text="@(x => Formatter.Date(x.Date))" />
                <Column Title='@L["Name"]' Text="@(x => x.Name)" />
                <Column Title='@L["Kind"]' Text="@(x => EnumL.Translate(x.Kind))" />
                <Column Title='@L["Transaction_FromAccount"]' Text="@(x => GetAccountName(x.FromAccountId))" />
                <Column Title='@L["Transaction_ToAccount"]' Text="@(x => GetAccountName(x.ToAccountId))" />
                <Column Title='@L["Amount"]' Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Money(x.Amount, x.Currency))" />
                <Column Title='@L["Category"]' Text="@(x => x.Category ?? string.Empty)" />
            </DataTable>
        }

        @if (plan.CreditCards.Count > 0)
        {
            var creditCardIds = plan.CreditCards
                .Select(x => x.Id)
                .ToHashSet();

            var creditCardEvents = result.Events
                .Where(x => creditCardIds.Contains(x.SourceTransactionId))
                .OrderBy(x => x.Date)
                .ThenBy(x => x.Priority)
                .ThenBy(x => x.Name)
                .ToList();

            <h4>@L["Simulation_CreditCardPaymentEvents"]</h4>

            <DataTable Items="creditCardEvents"
                       EmptyText='@L["Simulation_NoCreditCardPaymentEvents"]'
                       Caption='@L["Simulation_CreditCardPaymentEvents"]'>
                <Column Title='@L["Date"]' Text="@(x => Formatter.Date(x.Date))" />
                <Column Title='@L["Name"]' Text="@(x => x.Name)" />
                <Column Title='@L["Transaction_FromAccount"]' Text="@(x => GetAccountName(x.FromAccountId))" />
                <Column Title='@L["Transaction_ToAccount"]' Text="@(x => GetAccountName(x.ToAccountId))" />
                <Column Title='@L["Amount"]' Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Money(x.Amount, x.Currency))" />
                <Column Title='@L["CreditCard_Method"]' Text="@(x => EnumL.Translate(x.PaymentMethod))" />
            </DataTable>
        }

        var timelineRows = BuildTimelineRows(result)
            .Take(300)
            .ToList();

        <h4>@L["Simulation_EventsAndWarnings"]</h4>

        <DataTable Items="timelineRows"
                   RowCssClass="@(row => row.RowCssClass)"
                   EmptyText='@L["Simulation_NoEventsOrWarnings"]'
                   Caption='@L["Simulation_EventsAndWarnings"]'>
            <Column Title='@L["Date"]' Text="@(row => Formatter.Date(row.Date))" />
            <Column Title='@L["Type"]'>
                <ChildContent>
                    @if (context.IsWarning)
                    {
                        <span class="badge bg-warning text-dark">@L["Simulation_Warning"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@L["Simulation_Event"]</span>
                    }
                </ChildContent>
            </Column>
            <Column Title='@L["Simulation_NameOrCode"]' Text="@(row => row.Title)" />
            <Column Title='@L["Simulation_KindOrSeverity"]' Text="@(row => row.KindOrSeverity)" />
            <Column Title='@L["Transaction_FromAccount"]' Text="@(row => row.FromAccountName)" />
            <Column Title='@L["Transaction_ToAccount"]' Text="@(row => row.ToAccountName)" />
            <Column Title='@L["Amount"]' Align="ColumnAlign.Number" Text="@(row => row.AmountText)" />
            <Column Title='@L["Currency"]' Text="@(row => row.Currency)" />
            <Column Title='@L["Simulation_CategoryOrMessage"]' Text="@(row => row.MessageOrCategory)" />
        </DataTable>

        @if (result.Events.Count + result.Warnings.Count > timelineRows.Count)
        {
            <div class="alert alert-info">
                @Text("Simulation_ShowingFirstCombinedRowsOnly", timelineRows.Count)
            </div>
        }
    }
</PageScaffold>

@code {
    private string GetAccountName(Guid? accountId)
    {
        if (accountId is null || AppState.CurrentPlan is null)
        {
            return AppFormatter.EmptyMarker;
        }

        return AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == accountId.Value)
            ?.Name ?? "?";
    }

    /// <summary>
    /// The name of whatever a warning points at, so the localized text can say which contract,
    /// mortgage or account it means. The engine's own message already names it, in English.
    /// </summary>
    private string? DescribeWarningSource(SimulationWarning warning)
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            return null;
        }

        if (warning.SourceId is { } sourceId)
        {
            var named =
                plan.Pillar3aContracts.SingleOrDefault(x => x.Id == sourceId)?.Name
                ?? plan.Mortgages.SingleOrDefault(x => x.Id == sourceId)?.Name
                ?? plan.CreditCards.SingleOrDefault(x => x.Id == sourceId)?.Name
                ?? plan.Transactions.SingleOrDefault(x => x.Id == sourceId)?.Name;

            if (named is not null)
            {
                return named;
            }
        }

        return warning.AccountId is null ? null : GetAccountName(warning.AccountId);
    }

    private string GetMortgageTypeName(CashFlowPlan plan, Guid mortgageId)
    {
        var mortgage = plan.Mortgages.SingleOrDefault(x => x.Id == mortgageId);

        return mortgage is null ? string.Empty : EnumL.Translate(mortgage.Type);
    }

    private string GetMortgageAmortisationName(CashFlowPlan plan, Guid mortgageId)
    {
        var mortgage = plan.Mortgages.SingleOrDefault(x => x.Id == mortgageId);

        return mortgage is null ? string.Empty : EnumL.Translate(mortgage.AmortisationMode);
    }

    private static decimal GetStartPrincipal(MortgageContract mortgage) =>
        mortgage.CalculationPrincipal ?? mortgage.InitialPrincipal;

    private static decimal GetProjectedMortgagePrincipal(
        MortgageContract mortgage,
        SimulationResult result,
        DateOnly date)
    {
        var projectedPrincipal = result.GetMortgagePrincipal(
            mortgage.Id,
            date);

        if (projectedPrincipal > 0)
        {
            return projectedPrincipal;
        }

        return GetStartPrincipal(mortgage);
    }

    private static bool IsFullMonthInsideSimulationRange(
        string monthLabel,
        DateOnly simulationStart,
        DateOnly simulationEnd)
    {
        if (!TryParseMonthLabel(monthLabel, out var monthStart, out var monthEnd))
        {
            return false;
        }

        return monthStart >= simulationStart &&
               monthEnd <= simulationEnd;
    }

    private static bool TryParseMonthLabel(
        string monthLabel,
        out DateOnly monthStart,
        out DateOnly monthEnd)
    {
        monthStart = default;
        monthEnd = default;

        var parts = monthLabel.Split('-', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length != 2)
        {
            return false;
        }

        if (!int.TryParse(parts[0], out var year))
        {
            return false;
        }

        if (!int.TryParse(parts[1], out var month))
        {
            return false;
        }

        if (month < 1 || month > 12)
        {
            return false;
        }

        monthStart = new DateOnly(year, month, 1);
        monthEnd = new DateOnly(
            year,
            month,
            DateTime.DaysInMonth(year, month));

        return true;
    }

    private IReadOnlyList<TimelineRow> BuildTimelineRows(SimulationResult result)
    {
        var rows = new List<TimelineRow>();

        foreach (var cashFlowEvent in result.Events)
        {
            rows.Add(new TimelineRow
            {
                Date = cashFlowEvent.Date,
                SortOrder = cashFlowEvent.Priority,
                IsWarning = false,
                Title = cashFlowEvent.Name,
                KindOrSeverity = EnumL.Translate(cashFlowEvent.Kind),
                FromAccountName = GetAccountName(cashFlowEvent.FromAccountId),
                ToAccountName = GetAccountName(cashFlowEvent.ToAccountId),
                AmountText = Formatter.Money(cashFlowEvent.Amount),
                Currency = cashFlowEvent.Currency,
                MessageOrCategory = cashFlowEvent.Category ?? string.Empty,
                RowCssClass = string.Empty
            });
        }

        foreach (var warning in result.Warnings)
        {
            rows.Add(new TimelineRow
            {
                Date = warning.Date ?? result.StartDate,
                SortOrder = 10_000,
                IsWarning = true,
                Title = warning.Code,
                KindOrSeverity = warning.Severity.ToString(),
                FromAccountName = warning.AccountId is null
                    ? AppFormatter.EmptyMarker
                    : GetAccountName(warning.AccountId),
                ToAccountName = AppFormatter.EmptyMarker,
                AmountText = string.Empty,
                Currency = string.Empty,
                MessageOrCategory = warning.Message,
                RowCssClass = "table-warning"
            });
        }

        return rows
            .OrderBy(x => x.Date)
            .ThenBy(x => x.SortOrder)
            .ThenBy(x => x.IsWarning)
            .ThenBy(x => x.Title)
            .ToList();
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private sealed class TimelineRow
    {
        public DateOnly Date { get; init; }

        public int SortOrder { get; init; }

        public bool IsWarning { get; init; }

        public string Title { get; init; } = string.Empty;

        public string KindOrSeverity { get; init; } = string.Empty;

        public string FromAccountName { get; init; } = string.Empty;

        public string ToAccountName { get; init; } = string.Empty;

        public string AmountText { get; init; } = string.Empty;

        public string Currency { get; init; } = string.Empty;

        public string MessageOrCategory { get; init; } = string.Empty;

        public string RowCssClass { get; init; } = string.Empty;
    }
}
