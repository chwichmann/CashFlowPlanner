@page "/accounts"

@using System.Globalization
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core
@using CashFlowPlanner.Core.Accounts
@using CashFlowPlanner.Core.People
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Services
@using Microsoft.Extensions.Localization

@inject CashFlowAppState AppState
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL

<PageTitle>@L["Account_Title"] - CashFlow Planner</PageTitle>

<h2>@L["Account_Title"]</h2>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_infoMessage))
{
    <div class="alert alert-success">
        @_infoMessage
    </div>
}

@if (AppState.CurrentPlan is null)
{
    <p>@L["Account_NoPlan"]</p>
}
else
{
    var plan = AppState.CurrentPlan;
    var result = AppState.CurrentSimulationResult;

    <div class="mb-3">
        <button type="button" class="btn btn-primary" @onclick="NewAccount">
            @L["Account_AddAccount"]
        </button>
    </div>

    @if (_editModel is not null)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header">
                <strong>@(_isNewAccount ? L["Account_AddAccount"] : L["Account_EditAccount"])</strong>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@L["Account_Name"]</label>
                        <input class="form-control" @bind="_editModel.Name" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@L["Account_Type"]</label>
                        <select class="form-select" @bind="_editModel.Type">
                            @foreach (var accountType in Enum.GetValues<AccountType>())
                            {
                                <option value="@accountType">@EnumL.Translate(accountType)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@L["Account_Currency"]</label>
                        <input class="form-control" @bind="_editModel.Currency" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@L["Account_Owner"]</label>
                        <select class="form-select" @bind="_editModel.OwnerPersonId">
                            <option value="">@L["Account_NoOwner"]</option>
                            @foreach (var person in PersonList.OrderBy(x => x.DisplayName))
                            {
                                <option value="@person.Id">@person.DisplayName</option>
                            }
                        </select>

                        @if (_editModel.Type == AccountType.Pillar3a)
                        {
                            <div class="form-text">
                                @L["Account_RequiredForPillar3a"]
                            </div>
                        }
                    </div>

                    @if (_editModel.Type == AccountType.Pillar3a)
                    {
                        <div class="col-md-6">
                            <label class="form-label">@L["Account_Pillar3aSubType"]</label>
                            <select class="form-select" @bind="_editModel.Pillar3aSubtype">
                                <option value="">@L["Account_Pillar3aSelectSubType"]</option>
                                <option value="@Pillar3aAccountSubtype.BankAccount">
                                    @EnumL.Translate(Pillar3aAccountSubtype.BankAccount)
                                </option>
                                <option value="@Pillar3aAccountSubtype.FundSolution">
                                    @EnumL.Translate(Pillar3aAccountSubtype.FundSolution)
                                </option>
                            </select>

                            @if (PersonList.Count == 0)
                            {
                                <div class="form-text">
                                    @L["Account_NoOwners"]
                                </div>
                            }
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="form-label">@L["Account_BankName"]</label>
                        <input class="form-control" @bind="_editModel.BankName" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@L["Account_OpeningBalance"]</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editModel.OpeningBalance" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@L["Account_OpeningDate"]</label>
                        <input class="form-control" type="date" @bind="_editModel.OpeningDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@L["Account_IbanMasked"]</label>
                        <input class="form-control" @bind="_editModel.IbanMasked" />
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="account-active" @bind="_editModel.IsActive" />
                            <label class="form-check-label" for="account-active">
                                @L["Account_Active"]
                            </label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">@L["Account_Notes"]</label>
                        <textarea class="form-control" rows="3" @bind="_editModel.Notes"></textarea>
                    </div>
                </div>

                <hr />

                <h5>@L["Account_InterestContracts"]</h5>

                <p>@L["Account_InterestText"]</p>

                <button type="button" class="btn btn-secondary mb-3" @onclick="AddInterestContract">
                    @L["Account_InterestAdd"]
                </button>

                @if (_editModel.InterestContracts.Count == 0)
                {
                    <p>@L["Account_NoInterestContracts"]</p>
                }
                else
                {
                    @foreach (var contract in _editModel.InterestContracts)
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(contract.Name)
                                        ? L["Account_InterestContract"]
                                        : contract.Name)
                                </strong>

                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveInterestContract(contract)">
                                    @L["Remove"]
                                </button>
                            </div>

                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">@L["Account_Name"]</label>
                                        <input class="form-control" @bind="contract.Name" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">@L["Account_CalculationMethod"]</label>
                                        <select class="form-select" @bind="contract.CalculationMethod">
                                            @foreach (var method in Enum.GetValues<AccountInterestCalculationMethod>())
                                            {
                                                <option value="@method">@EnumL.Translate(method)</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">@L["Account_PostingFrequency"]</label>
                                        <select class="form-select" @bind="contract.PostingFrequency">
                                            @foreach (var frequency in Enum.GetValues<InterestPostingFrequency>())
                                            {
                                                <option value="@frequency">@EnumL.Translate(frequency)</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">@L["Account_DayCount"]</label>
                                        <select class="form-select" @bind="contract.DayCountConvention">
                                            @foreach (var convention in Enum.GetValues<InterestDayCountConvention>())
                                            {
                                                <option value="@convention">@EnumL.Translate(convention)</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label">@L["Account_StartDate"]</label>
                                        <input class="form-control" type="date" @bind="contract.StartDate" />
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label">@L["Account_EndDate"]</label>
                                        <input class="form-control" type="date" @bind="contract.EndDate" />
                                    </div>

                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @bind="contract.IsActive" />
                                            <label class="form-check-label">
                                                @L["Account_Active"]
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                @if (contract.CalculationMethod == AccountInterestCalculationMethod.FlatBalance)
                                {
                                    <hr />

                                    <h6>@L["Account_FlatInterestRate"]</h6>

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">@L["Account_AnnualRatePercent"]</label>
                                            <input class="form-control" type="number" step="0.0001" @bind="contract.FlatAnnualRatePercent" />
                                        </div>
                                    </div>

                                    <p class="mt-3">@L["Account_FlatBalanceModeText"]</p>
                                }
                                else
                                {
                                    <hr />

                                    <h6>@L["Account_InterestTiers"]</h6>

                                    <button type="button" class="btn btn-secondary btn-sm mb-3" @onclick="() => AddInterestTier(contract)">
                                        @L["Account_AddTier"]
                                    </button>

                                    @if (contract.Tiers.Count == 0)
                                    {
                                        <p>@L["Account_InterestTierRequired"]</p>
                                    }
                                    else
                                    {
                                        <table class="table table-sm table-striped align-middle">
                                            <thead>
                                                <tr>
                                                    <th>@L["Account_FromAmount"]</th>
                                                    <th>@L["Account_ToAmount"]</th>
                                                    <th>@L["Account_AnnualRatePercent"]</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var tier in contract.Tiers)
                                                {
                                                    <tr>
                                                        <td>
                                                            <input class="form-control form-control-sm" type="number" step="0.01" @bind="tier.FromAmount" />
                                                        </td>
                                                        <td>
                                                            <input class="form-control form-control-sm" type="number" step="0.01" @bind="tier.ToAmount" />
                                                        </td>
                                                        <td>
                                                            <input class="form-control form-control-sm" type="number" step="0.0001" @bind="tier.AnnualRatePercent" />
                                                        </td>
                                                        <td>
                                                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveInterestTier(contract, tier)">
                                                                @L["Remove"]
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                }
                            </div>
                        </div>
                    }
                }

                <div class="mt-3 no-wrap">
                    <button type="button" class="btn btn-primary" @onclick="SaveAccount">
                        @L["Account_Save"]
                    </button>

                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">
                        @L["Account_Cancel"]
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_balanceEditModel is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="setBalanceModalTitle">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="setBalanceModalTitle">
                        @L["Account_SetBalanceTitle", _balanceEditModel.AccountName]
                    </h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="@L["Cancel"]"
                            @onclick="CancelBalanceEdit">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        @Text(
                            "Account_SetBalanceDescription",
                            _balanceEditModel.AccountName)
                    </p>

                    <div class="mb-3">
                        <label class="form-label">@L["Account_Balance"]</label>

                        <div class="input-group">
                            <input class="form-control"
                                   type="number"
                                   step="0.01"
                                   autofocus
                                   @bind="_balanceEditModel.Balance" />

                            <span class="input-group-text">
                                @_balanceEditModel.Currency
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-warning mb-0">
                        @L["Account_SetBalanceTodayHint"]
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelBalanceEdit">
                        @L["Cancel"]
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveBalance">
                        @L["Save"]
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

    @if (plan.Accounts.Count == 0)
    {
        <p>@L["Account_NoAccounts"]</p>
    }
    else
    {
        <table class="table table-sm table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>@L["Account_Name"]</th>
                    <th>@L["Account_Type"]</th>
                    <th>@L["Account_Owner"]</th>
                    <th class="text-center">@L["Account_Bank"]</th>
                    <th class="text-center">@L["Account_Currency"]</th>
                    <th class="text-end">@L["Account_OpeningBalance"]</th>
                    <th class="text-center">@L["Account_OpeningDate"]</th>
                    <th class="text-end">@L["Account_EndBalance"]</th>
                    <th class="text-center">@L["Account_Interest"]</th>
                    <th class="text-center">@L["Account_Active"]</th>
                    <th class="text-end">@L["Account_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in plan.Accounts.OrderBy(x => x.Type).ThenBy(x => x.Name))
                {
                    var endBalance = result is null
                        ? (decimal?)null
                        : result.GetBalance(account.Id, plan.SimulationSettings.EndDate);

                    <tr>
                        <td>@account.Name</td>
                        <td>@EnumL.Translate(account.Type)</td>
                        <td>@GetOwnerName(account)</td>
                        <td class="text-center">@account.BankName</td>
                        <td class="text-center">@account.Currency</td>
                        <td class="text-end">@account.OpeningBalance.ToString("N2", CultureInfo.CurrentCulture)</td>
                        <td class="text-center">@FormatDate(account.OpeningDate)</td>
                        <td class="text-end">
                            @if (endBalance is null)
                            {
                                @L["Account_NotSimulated"]
                            }
                            else
                            {
                                @endBalance.Value.ToString("N2", CultureInfo.CurrentCulture)
                            }
                        </td>
                        <td class="text-center">@FormatInterestContracts(account)</td>
                        <td class="text-center">
                            @if (account.IsActive)
                            {
                                <span class="badge bg-success">@L["Account_Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@L["Inactive"]</span>
                            }
                        </td>
                        <td class="text-end text-nowrap" style="white-space: nowrap;">
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="() => OpenStatement(account)">
                                @L["Account_Statement"]
                            </button>

                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => EditAccount(account)">
                                @L["Edit"]
                            </button>

                            <button type="button" class="btn btn-sm btn-warning" @onclick="() => OpenBalanceEdit(account)">
                                @L["Account_SetBalance"]
                            </button>

                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteAccount(account)">
                                @L["Delete"]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private AccountEditModel? _editModel;
    private AccountBalanceEditModel? _balanceEditModel;
    private bool _isNewAccount;
    private string? _errorMessage;
    private string? _infoMessage;

    private IReadOnlyList<Person> PersonList =>
        AppState.CurrentPlan?.Persons ?? new List<Person>();

    private void NewAccount()
    {
        ClearMessages();
        _balanceEditModel = null;

        var openingDate = AppState.CurrentPlan?.SimulationSettings.StartDate
            ?? DateOnly.FromDateTime(DateTime.Today);

        _editModel = new AccountEditModel
        {
            Id = Guid.NewGuid(),
            Name = string.Empty,
            Type = AccountType.BankAccount,
            Currency = AppState.CurrentPlan?.BaseCurrency ?? "CHF",
            OpeningDate = openingDate,
            IsActive = true,
            OwnerPersonId = PersonList.Count == 1
                ? PersonList[0].Id
                : null
        };

        _isNewAccount = true;
    }

    private void EditAccount(Account account)
    {
        ClearMessages();
        _balanceEditModel = null;

        _editModel = AccountEditModel.FromAccount(account);
        _isNewAccount = false;
    }

    private void SaveAccount()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        try
        {
            if (string.IsNullOrWhiteSpace(_editModel.Name))
            {
                throw new InvalidOperationException(Text("Account_ErrorNameRequired"));
            }

            if (string.IsNullOrWhiteSpace(_editModel.Currency))
            {
                throw new InvalidOperationException(Text("Account_ErrorCurrencyRequired"));
            }

            if (_editModel.OwnerPersonId is not null &&
                !PersonList.Any(x => x.Id == _editModel.OwnerPersonId.Value))
            {
                throw new InvalidOperationException(Text("Account_ErrorOwnerDoesNotExist"));
            }

            if (_editModel.Type == AccountType.Pillar3a)
            {
                if (_editModel.OwnerPersonId is null)
                {
                    throw new InvalidOperationException(Text("Account_ErrorPillar3aOwnerRequired"));
                }

                if (_editModel.Pillar3aSubtype is null)
                {
                    throw new InvalidOperationException(Text("Account_ErrorPillar3aSubtypeRequired"));
                }
            }

            if (_editModel.Type != AccountType.Pillar3a)
            {
                _editModel.Pillar3aSubtype = null;
            }

            foreach (var interestContractEditModel in _editModel.InterestContracts)
            {
                var contract = interestContractEditModel.ToContract();
                contract.Validate();
            }

            var account = _editModel.ToAccount();

            if (!_isNewAccount)
            {
                account = PreserveBankImportIdentifiers(account);
            }

            AppState.AddOrUpdateAccount(account);

            _infoMessage = _isNewAccount
                ? Text("Account_Added", account.Name)
                : Text("Account_Updated", account.Name);

            _editModel = null;
            _isNewAccount = false;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void DeleteAccount(Account account)
    {
        ClearMessages();
        _balanceEditModel = null;

        try
        {
            AppState.DeleteAccount(account.Id);
            _infoMessage = Text("Account_Deleted", account.Name);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        ClearMessages();

        _editModel = null;
        _isNewAccount = false;
    }

    private void OpenBalanceEdit(Account account)
    {
        ClearMessages();

        _editModel = null;
        _isNewAccount = false;

        var today = DateOnly.FromDateTime(DateTime.Today);
        var simulatedTodayBalance = AppState.CurrentSimulationResult?.GetBalance(
            account.Id,
            today);

        _balanceEditModel = new AccountBalanceEditModel
        {
            AccountId = account.Id,
            AccountName = account.Name,
            Balance = simulatedTodayBalance ?? account.OpeningBalance,
            Currency = account.Currency
        };
    }

    private void SaveBalance()
    {
        ClearMessages();

        if (_balanceEditModel is null || AppState.CurrentPlan is null)
        {
            return;
        }

        try
        {
            var account = AppState.CurrentPlan.Accounts
                .SingleOrDefault(x => x.Id == _balanceEditModel.AccountId);

            if (account is null)
            {
                throw new InvalidOperationException(Text("Account_ErrorAccountNotFound"));
            }

            var updatedAccount = CopyAccount(
                account,
                openingBalance: _balanceEditModel.Balance,
                openingDate: DateOnly.FromDateTime(DateTime.Today),
                bankIdentifiers: account.BankIdentifiers);

            AppState.AddOrUpdateAccount(updatedAccount);

            _infoMessage = Text(
                "Account_BalanceUpdated",
                updatedAccount.Name,
                updatedAccount.OpeningBalance.ToString("N2", CultureInfo.CurrentCulture),
                FormatDate(updatedAccount.OpeningDate));

            _balanceEditModel = null;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void CancelBalanceEdit()
    {
        ClearMessages();
        _balanceEditModel = null;
    }

    private void AddInterestContract()
    {
        if (_editModel is null)
        {
            return;
        }

        _editModel.InterestContracts.Add(new AccountInterestContractEditModel
        {
            Id = Guid.NewGuid(),
            Name = string.IsNullOrWhiteSpace(_editModel.Name)
                ? Text("Account_DefaultInterestContractName")
                : Text("Account_DefaultNamedInterestContractName", _editModel.Name),
            CalculationMethod = AccountInterestCalculationMethod.FlatBalance,
            PostingFrequency = InterestPostingFrequency.Yearly,
            DayCountConvention = InterestDayCountConvention.Actual360,
            StartDate = _editModel.OpeningDate,
            IsActive = true,
            FlatAnnualRatePercent = 0m,
            Tiers =
            [
                new AccountInterestTierEditModel
                {
                    FromAmount = 0m,
                    ToAmount = null,
                    AnnualRatePercent = 0m
                }
            ]
        });
    }

    private void RemoveInterestContract(AccountInterestContractEditModel contract)
    {
        if (_editModel is null)
        {
            return;
        }

        _editModel.InterestContracts.Remove(contract);
    }

    private static void AddInterestTier(AccountInterestContractEditModel contract)
    {
        var nextFromAmount = 0m;

        if (contract.Tiers.Count > 0)
        {
            var highestToAmount = contract.Tiers
                .Where(x => x.ToAmount is not null)
                .Select(x => x.ToAmount!.Value)
                .DefaultIfEmpty(0m)
                .Max();

            var highestFromAmount = contract.Tiers
                .Select(x => x.FromAmount)
                .DefaultIfEmpty(0m)
                .Max();

            nextFromAmount = Math.Max(highestToAmount, highestFromAmount);
        }

        contract.Tiers.Add(new AccountInterestTierEditModel
        {
            FromAmount = nextFromAmount,
            ToAmount = null,
            AnnualRatePercent = 0m
        });
    }

    private static void RemoveInterestTier(
        AccountInterestContractEditModel contract,
        AccountInterestTierEditModel tier)
    {
        contract.Tiers.Remove(tier);
    }

    private string GetOwnerName(Account account)
    {
        if (AppState.CurrentPlan is null)
        {
            return "-";
        }

        if (account.Owners is null || account.Owners.Count == 0)
        {
            return "-";
        }

        var ownerNames = account.Owners
            .Select(owner => AppState.CurrentPlan.Persons
                .SingleOrDefault(person => person.Id == owner.PersonId)
                ?.DisplayName ?? "?")
            .ToList();

        return ownerNames.Count == 0
            ? "-"
            : string.Join(", ", ownerNames);
    }

    private string FormatPillar3aSubtype(Account account)
    {
        if (account.Type != AccountType.Pillar3a)
        {
            return "-";
        }

        return EnumL.TranslateNullable(account.Pillar3aSubtype);
    }

    private static string FormatInterestContracts(Account account)
    {
        if (account.InterestContracts.Count == 0)
        {
            return "-";
        }

        var activeCount = account.InterestContracts.Count(x => x.IsActive);

        return $"{activeCount}/{account.InterestContracts.Count}";
    }

    private static string FormatDate(DateOnly date)
    {
        return date.ToString("d", CultureInfo.CurrentCulture);
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object?[] arguments)
    {
        return L[key, arguments].Value;
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
    }

    private void OpenStatement(Account account)
    {
        NavigationManager.NavigateTo($"accounts/{account.Id}/statement");
    }

    private Account PreserveBankImportIdentifiers(Account updatedAccount)
    {
        if (AppState.CurrentPlan is null)
        {
            return updatedAccount;
        }

        var existingAccount = AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == updatedAccount.Id);

        if (existingAccount is null)
        {
            return updatedAccount;
        }

        return CopyAccount(
            updatedAccount,
            openingBalance: updatedAccount.OpeningBalance,
            openingDate: updatedAccount.OpeningDate,
            bankIdentifiers: existingAccount.BankIdentifiers,
            iban: existingAccount.Iban);
    }

    private static Account CopyAccount(
        Account account,
        decimal openingBalance,
        DateOnly openingDate,
        List<AccountBankIdentifier> bankIdentifiers,
        string? iban = null)
    {
        return new Account
        {
            Id = account.Id,
            InterestContracts = account.InterestContracts,
            Name = account.Name,
