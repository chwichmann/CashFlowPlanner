@page "/accounts"

@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core
@using CashFlowPlanner.Core.Accounts
@using CashFlowPlanner.Core.People
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Services
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject CashFlowAppState AppState
@inject AppFormatter Formatter
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL

<ConfirmDialog @ref="_confirmDialog" />

<PageScaffold Title="@L["Account_Title"]"
              RequiresPlan="true"
              EmptyStateMessage="@L["Account_NoPlan"]">

    <Notifications>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_infoMessage))
        {
            <div class="alert alert-success">
                @_infoMessage
            </div>
        }
    </Notifications>

    <ChildContent>
        @{
            // PageScaffold only renders ChildContent once AppState.HasPlan, and HasPlan is
            // CurrentPlan is not null. The guard the page used to write itself now lives there.
            var plan = AppState.CurrentPlan!;
            var result = AppState.CurrentSimulationResult;

            var accounts = plan.Accounts
                .OrderBy(x => x.Type)
                .ThenBy(x => x.Name)
                .ToList();
        }

        <div class="mb-3 d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" @onclick="NewAccount">
                @L["Account_AddAccount"]
            </button>

            @* Bank import lives here rather than on its own navigation entry: a statement is
               imported *into* an account, and the bar was carrying twelve destinations. *@
            <button type="button" class="btn btn-outline-secondary"
                    @onclick="() => _showImport = !_showImport">
                @(_showImport ? L["Account_HideImport"] : L["Account_ShowImport"])
            </button>
        </div>

        @if (_showImport)
        {
            <section class="card mb-4">
                <div class="card-body">
                    <BankStatementImport />
                </div>
            </section>
        }

        @if (_editModel is not null)
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header">
                    <strong>@(_isNewAccount ? L["Account_AddAccount"] : L["Account_EditAccount"])</strong>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <FormField Label="@L["Account_Name"]" CssClass="mb-0">
                                <input id="@context.Id"
                                       aria-describedby="@context.DescribedBy"
                                       class="form-control"
                                       @bind="_editModel.Name" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label="@L["Account_Type"]" CssClass="mb-0">
                                <select id="@context.Id"
                                        aria-describedby="@context.DescribedBy"
                                        class="form-select"
                                        @bind="_editModel.Type">
                                    @foreach (var accountType in Enum.GetValues<AccountType>())
                                    {
                                        <option value="@accountType">@EnumL.Translate(accountType)</option>
                                    }
                                </select>
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label="@L["Account_Currency"]" CssClass="mb-0">
                                <input id="@context.Id"
                                       aria-describedby="@context.DescribedBy"
                                       class="form-control"
                                       @bind="_editModel.Currency" />
                            </FormField>
                        </div>

                        <div class="col-md-6">
                            <FormField Label="@L["Account_Owner"]"
                                       CssClass="mb-0"
                                       Hint="@OwnerHint">
                                <select id="@context.Id"
                                        aria-describedby="@context.DescribedBy"
                                        class="form-select"
                                        @bind="_editModel.OwnerPersonId">
                                    <option value="">@L["Account_NoOwner"]</option>
                                    @foreach (var person in PersonList.OrderBy(x => x.DisplayName))
                                    {
                                        <option value="@person.Id">@person.DisplayName</option>
                                    }
                                </select>
                            </FormField>
                        </div>

                        @if (_editModel.Type == AccountType.Pillar3a)
                        {
                            <div class="col-md-6">
                                <FormField Label="@L["Account_Pillar3aSubType"]"
                                           CssClass="mb-0"
                                           Hint="@Pillar3aSubtypeHint">
                                    <select id="@context.Id"
                                            aria-describedby="@context.DescribedBy"
                                            class="form-select"
                                            @bind="_editModel.Pillar3aSubtype">
                                        <option value="">@L["Account_Pillar3aSelectSubType"]</option>
                                        <option value="@Pillar3aAccountSubtype.BankAccount">
                                            @EnumL.Translate(Pillar3aAccountSubtype.BankAccount)
                                        </option>
                                        <option value="@Pillar3aAccountSubtype.FundSolution">
                                            @EnumL.Translate(Pillar3aAccountSubtype.FundSolution)
                                        </option>
                                    </select>
                                </FormField>
                            </div>
                        }

                        <div class="col-md-6">
                            <FormField Label="@L["Account_BankName"]" CssClass="mb-0">
                                <input id="@context.Id"
                                       aria-describedby="@context.DescribedBy"
                                       class="form-control"
                                       @bind="_editModel.BankName" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label="@L["Account_OpeningBalance"]" CssClass="mb-0">
                                <MoneyInput Id="@context.Id"
                                            AriaDescribedBy="@context.DescribedBy"
                                            @bind-Value="_editModel.OpeningBalance" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label="@L["Account_OpeningDate"]" CssClass="mb-0">
                                <input id="@context.Id"
                                       aria-describedby="@context.DescribedBy"
                                       class="form-control"
                                       type="date"
                                       @bind="_editModel.OpeningDate" />
                            </FormField>
                        </div>

                        <div class="col-md-6">
                            <FormField Label="@L["Account_IbanMasked"]" CssClass="mb-0">
                                <input id="@context.Id"
                                       aria-describedby="@context.DescribedBy"
                                       class="form-control"
                                       @bind="_editModel.IbanMasked" />
                            </FormField>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <FormField Label="@L["Account_Active"]"
                                       Layout="FormFieldLayout.Checkbox"
                                       CssClass="mb-0">
                                <input id="@context.Id"
                                       class="form-check-input"
                                       type="checkbox"
                                       @bind="_editModel.IsActive" />
                            </FormField>
                        </div>

                        <div class="col-12">
                            <FormField Label="@L["Account_Notes"]" CssClass="mb-0">
                                <textarea id="@context.Id"
                                          aria-describedby="@context.DescribedBy"
                                          class="form-control"
                                          rows="3"
                                          @bind="_editModel.Notes"></textarea>
                            </FormField>
                        </div>
                    </div>

                    <hr />

                    <h5>@L["Account_InterestContracts"]</h5>

                    <p>@L["Account_InterestText"]</p>

                    <button type="button" class="btn btn-secondary mb-3" @onclick="AddInterestContract">
                        @L["Account_InterestAdd"]
                    </button>

                    @if (_editModel.InterestContracts.Count == 0)
                    {
                        <p>@L["Account_NoInterestContracts"]</p>
                    }
                    else
                    {
                        @foreach (var contract in _editModel.InterestContracts)
                        {
                            <div class="card mb-3">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(contract.Name)
                                            ? L["Account_InterestContract"]
                                            : contract.Name)
                                    </strong>

                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveInterestContract(contract)">
                                        @L["Remove"]
                                    </button>
                                </div>

                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <FormField Label="@L["Account_Name"]" CssClass="mb-0">
                                                <input id="@context.Id"
                                                       aria-describedby="@context.DescribedBy"
                                                       class="form-control"
                                                       @bind="contract.Name" />
                                            </FormField>
                                        </div>

                                        <div class="col-md-6">
                                            <FormField Label="@L["Account_CalculationMethod"]" CssClass="mb-0">
                                                <select id="@context.Id"
                                                        aria-describedby="@context.DescribedBy"
                                                        class="form-select"
                                                        @bind="contract.CalculationMethod">
                                                    @foreach (var method in Enum.GetValues<AccountInterestCalculationMethod>())
                                                    {
                                                        <option value="@method">@EnumL.Translate(method)</option>
                                                    }
                                                </select>
                                            </FormField>
                                        </div>

                                        <div class="col-md-4">
                                            <FormField Label="@L["Account_PostingFrequency"]" CssClass="mb-0">
                                                <select id="@context.Id"
                                                        aria-describedby="@context.DescribedBy"
                                                        class="form-select"
                                                        @bind="contract.PostingFrequency">
                                                    @foreach (var frequency in Enum.GetValues<InterestPostingFrequency>())
                                                    {
                                                        <option value="@frequency">@EnumL.Translate(frequency)</option>
                                                    }
                                                </select>
                                            </FormField>
                                        </div>

                                        <div class="col-md-4">
                                            <FormField Label="@L["Account_DayCount"]" CssClass="mb-0">
                                                <select id="@context.Id"
                                                        aria-describedby="@context.DescribedBy"
                                                        class="form-select"
                                                        @bind="contract.DayCountConvention">
                                                    @foreach (var convention in Enum.GetValues<InterestDayCountConvention>())
                                                    {
                                                        <option value="@convention">@EnumL.Translate(convention)</option>
                                                    }
                                                </select>
                                            </FormField>
                                        </div>

                                        <div class="col-md-2">
                                            <FormField Label="@L["Account_StartDate"]" CssClass="mb-0">
                                                <input id="@context.Id"
                                                       aria-describedby="@context.DescribedBy"
                                                       class="form-control"
                                                       type="date"
                                                       @bind="contract.StartDate" />
                                            </FormField>
                                        </div>

                                        <div class="col-md-2">
                                            <FormField Label="@L["Account_EndDate"]" CssClass="mb-0">
                                                <input id="@context.Id"
                                                       aria-describedby="@context.DescribedBy"
                                                       class="form-control"
                                                       type="date"
                                                       @bind="contract.EndDate" />
                                            </FormField>
                                        </div>

                                        <div class="col-12">
                                            <FormField Label="@L["Account_Active"]"
                                                       Layout="FormFieldLayout.Checkbox"
                                                       CssClass="mb-0">
                                                <input id="@context.Id"
                                                       class="form-check-input"
                                                       type="checkbox"
                                                       @bind="contract.IsActive" />
                                            </FormField>
                                        </div>
                                    </div>

                                    @if (contract.CalculationMethod == AccountInterestCalculationMethod.FlatBalance)
                                    {
                                        <hr />

                                        <h6>@L["Account_FlatInterestRate"]</h6>

                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <FormField Label="@L["Account_AnnualRatePercent"]" CssClass="mb-0">
                                                    <MoneyInput Id="@context.Id"
                                                                AriaDescribedBy="@context.DescribedBy"
                                                                Decimals="4"
                                                                @bind-Value="contract.FlatAnnualRatePercent" />
                                                </FormField>
                                            </div>
                                        </div>

                                        <p class="mt-3">@L["Account_FlatBalanceModeText"]</p>
                                    }
                                    else
                                    {
                                        <hr />

                                        <h6>@L["Account_InterestTiers"]</h6>

                                        <button type="button" class="btn btn-secondary btn-sm mb-3" @onclick="() => AddInterestTier(contract)">
                                            @L["Account_AddTier"]
                                        </button>

                                        <DataTable Items="contract.Tiers"
                                                   TableCssClass="table table-sm table-striped align-middle"
                                                   Caption="@L["Account_InterestTiers"]"
                                                   EmptyText="@L["Account_InterestTierRequired"]">

                                            <Column Title="@L["Account_FromAmount"]" Align="ColumnAlign.Number">
                                                <ChildContent Context="tier">
                                                    <MoneyInput @bind-Value="tier.FromAmount"
                                                                CssClass="form-control form-control-sm num"
                                                                aria-label="@L["Account_FromAmount"]" />
                                                </ChildContent>
                                            </Column>

                                            @*
                                                An empty upper bound is what makes a tier open-ended, so this
                                                binds decimal? - clearing the box means "no bound", not zero.
                                            *@
                                            <Column Title="@L["Account_ToAmount"]" Align="ColumnAlign.Number">
                                                <ChildContent Context="tier">
                                                    <MoneyInput @bind-Value="tier.ToAmount"
                                                                CssClass="form-control form-control-sm num"
                                                                aria-label="@L["Account_ToAmount"]" />
                                                </ChildContent>
                                            </Column>

                                            <Column Title="@L["Account_AnnualRatePercent"]" Align="ColumnAlign.Number">
                                                <ChildContent Context="tier">
                                                    <MoneyInput @bind-Value="tier.AnnualRatePercent"
                                                                Decimals="4"
                                                                CssClass="form-control form-control-sm num"
                                                                aria-label="@L["Account_AnnualRatePercent"]" />
                                                </ChildContent>
                                            </Column>

                                            <Column HeaderCssClass="text-end" CellCssClass="text-end">
                                                <ChildContent Context="tier">
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm"
                                                            @onclick="() => RemoveInterestTier(contract, tier)">
                                                        @L["Remove"]
                                                    </button>
                                                </ChildContent>
                                            </Column>
                                        </DataTable>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <div class="mt-3 d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary" @onclick="SaveAccount">
                            @L["Account_Save"]
                        </button>

                        <button type="button" class="btn btn-secondary" @onclick="CancelEdit">
                            @L["Account_Cancel"]
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (_balanceEditModel is not null)
        {
            @*
                Bound to a local rather than to the field. The dialog's body is a RenderFragment the
                AppModal holds on to, and cancelling clears the field before the modal has rendered
                itself away - so a fragment reading _balanceEditModel directly dereferences null on
                the way out.
            *@
            var balanceEdit = _balanceEditModel;

            <AppModal Visible="true"
                      Title="@(Text("Account_SetBalanceTitle", balanceEdit.AccountName))"
                      ConfirmText="@L["Save"]"
                      CancelText="@L["Cancel"]"
                      OnConfirm="SaveBalance"
                      OnCancel="CancelBalanceEdit">

                <p>
                    @Text("Account_SetBalanceDescription", balanceEdit.AccountName)
                </p>

                <FormField Label="@L["Account_Balance"]">
                    <MoneyInput Id="@context.Id"
                                AriaDescribedBy="@context.DescribedBy"
                                Suffix="@balanceEdit.Currency"
                                @bind-Value="balanceEdit.Balance" />
                </FormField>

                <div class="alert alert-warning mb-0">
                    @L["Account_SetBalanceTodayHint"]
                </div>
            </AppModal>
        }

        <DataTable Items="accounts"
                   RowKey="@(account => (object)account.Id)"
                   TableCssClass="table table-sm table-striped table-hover align-middle"
                   Caption="@L["Account_Title"]"
                   EmptyText="@L["Account_NoAccounts"]">

            <Column Title="@L["Account_Name"]" Text="@(account => account.Name)" />

            <Column Title="@L["Account_Type"]" Text="@(account => EnumL.Translate(account.Type))" />

            <Column Title="@L["Account_Owner"]" Text="@(account => GetOwnerName(account))" />

            @* Bank, Currency, OpeningDate and Interest are prose and dates, so they read from the
               left like every other table in the app. They used to be centred here alone. *@
            <Column Title="@L["Account_Bank"]" Text="@(account => account.BankName ?? string.Empty)" />

            <Column Title="@L["Account_Currency"]" Text="@(account => account.Currency)" />

            <Column Title="@L["Account_OpeningBalance"]"
                    Align="ColumnAlign.Number"
                    Text="@(account => Formatter.Money(account.OpeningBalance))" />

            <Column Title="@L["Account_OpeningDate"]"
                    Text="@(account => Formatter.Date(account.OpeningDate))" />

            <Column Title="@L["Account_EndBalance"]"
                    Align="ColumnAlign.Number"
                    Text="@(account => result is null
                               ? L["Account_NotSimulated"].Value
                               : Formatter.Money(result.GetBalance(account.Id, plan.SimulationSettings.EndDate)))" />

            <Column Title="@L["Account_Interest"]" Text="@(account => FormatInterestContracts(account))" />

            <Column Title="@L["Account_Active"]" HeaderCssClass="text-center" CellCssClass="text-center">
                <ChildContent Context="account">
                    @if (account.IsActive)
                    {
                        <span class="badge bg-success">@L["Account_Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@L["Inactive"]</span>
                    }
                </ChildContent>
            </Column>

            <Column Title="@L["Account_Actions"]" HeaderCssClass="text-end">
                <ChildContent Context="account">
                    @* Four buttons that used to sit flush against each other. *@
                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => OpenStatement(account)">
                            @L["Account_Statement"]
                        </button>

                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => EditAccount(account)">
                            @L["Edit"]
                        </button>

                        <button type="button" class="btn btn-sm btn-warning" @onclick="() => OpenBalanceEdit(account)">
                            @L["Account_SetBalance"]
                        </button>

                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteAccount(account)">
                            @L["Delete"]
                        </button>
                    </div>
                </ChildContent>
            </Column>
        </DataTable>
    </ChildContent>
</PageScaffold>

@code {
    private bool _showImport;

    private AccountEditModel? _editModel;
    private AccountBalanceEditModel? _balanceEditModel;
    private bool _isNewAccount;
    private string? _errorMessage;
    private string? _infoMessage;
    private ConfirmDialog? _confirmDialog;

    private IReadOnlyList<Person> PersonList =>
        AppState.CurrentPlan?.Persons ?? new List<Person>();

    private string? OwnerHint =>
        _editModel?.Type == AccountType.Pillar3a
            ? Text("Account_RequiredForPillar3a")
            : null;

    private string? Pillar3aSubtypeHint =>
        PersonList.Count == 0
            ? Text("Account_NoOwners")
            : null;

    private void NewAccount()
    {
        ClearMessages();
        _balanceEditModel = null;

        var openingDate = AppState.CurrentPlan?.SimulationSettings.StartDate
            ?? DateOnly.FromDateTime(DateTime.Today);

        _editModel = new AccountEditModel
        {
            Id = Guid.NewGuid(),
            Name = string.Empty,
            Type = AccountType.BankAccount,
            Currency = AppState.CurrentPlan?.BaseCurrency ?? "CHF",
            OpeningDate = openingDate,
            IsActive = true,
            OwnerPersonId = PersonList.Count == 1
                ? PersonList[0].Id
                : null
        };

        _isNewAccount = true;
    }

    private void EditAccount(Account account)
    {
        ClearMessages();
        _balanceEditModel = null;

        _editModel = AccountEditModel.FromAccount(account);
        _isNewAccount = false;
    }

    private void SaveAccount()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        try
        {
            if (string.IsNullOrWhiteSpace(_editModel.Name))
            {
                throw new InvalidOperationException(Text("Account_ErrorNameRequired"));
            }

            if (string.IsNullOrWhiteSpace(_editModel.Currency))
            {
                throw new InvalidOperationException(Text("Account_ErrorCurrencyRequired"));
            }

            if (_editModel.OwnerPersonId is not null &&
                !PersonList.Any(x => x.Id == _editModel.OwnerPersonId.Value))
            {
                throw new InvalidOperationException(Text("Account_ErrorOwnerDoesNotExist"));
            }

            if (_editModel.Type == AccountType.Pillar3a)
            {
                if (_editModel.OwnerPersonId is null)
                {
                    throw new InvalidOperationException(Text("Account_ErrorPillar3aOwnerRequired"));
                }

                if (_editModel.Pillar3aSubtype is null)
                {
                    throw new InvalidOperationException(Text("Account_ErrorPillar3aSubtypeRequired"));
                }
            }

            if (_editModel.Type != AccountType.Pillar3a)
            {
                _editModel.Pillar3aSubtype = null;
            }

            foreach (var interestContractEditModel in _editModel.InterestContracts)
            {
                var contract = interestContractEditModel.ToContract();
                contract.Validate();
            }

            var account = _editModel.ToAccount();

            if (!_isNewAccount)
            {
                account = PreserveBankImportIdentifiers(account);
            }

            AppState.AddOrUpdateAccount(account);

            _infoMessage = _isNewAccount
                ? Text("Account_Added", account.Name)
                : Text("Account_Updated", account.Name);

            _editModel = null;
            _isNewAccount = false;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Deleting an account takes its postings with it and, until recently, could leave the plan in a
    /// state it refused to save. It is the one destructive action on this page and it used to happen
    /// on a single click with no way back.
    /// </summary>
    private async Task DeleteAccount(Account account)
    {
        ClearMessages();
        _balanceEditModel = null;

        if (_confirmDialog is null)
        {
            return;
        }

        // Name the account. A generic "Are you sure?" on a destructive action tells the
        // user nothing about what is about to disappear, and this is the delete that could
        // strand the plan if the account is still referenced.
        var confirmed = await _confirmDialog.ShowAsync(
            Text("Account_DeleteTitle"),
            Text("Account_DeleteConfirm", account.Name));

        if (!confirmed)
        {
            return;
        }

        try
        {
            AppState.DeleteAccount(account.Id);
            _infoMessage = Text("Account_Deleted", account.Name);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        ClearMessages();

        _editModel = null;
        _isNewAccount = false;
    }

    private void OpenBalanceEdit(Account account)
    {
        ClearMessages();

        _editModel = null;
        _isNewAccount = false;

        var today = DateOnly.FromDateTime(DateTime.Today);
        var simulatedTodayBalance = AppState.CurrentSimulationResult?.GetBalance(
            account.Id,
            today);

        _balanceEditModel = new AccountBalanceEditModel
        {
            AccountId = account.Id,
            AccountName = account.Name,
            Balance = simulatedTodayBalance ?? account.OpeningBalance,
            Currency = account.Currency
        };
    }

    private void SaveBalance()
    {
        ClearMessages();

        if (_balanceEditModel is null || AppState.CurrentPlan is null)
        {
            return;
        }

        try
        {
            var account = AppState.CurrentPlan.Accounts
                .SingleOrDefault(x => x.Id == _balanceEditModel.AccountId);

            if (account is null)
            {
                throw new InvalidOperationException(Text("Account_ErrorAccountNotFound"));
            }

            var updatedAccount = CopyAccount(
                account,
                openingBalance: _balanceEditModel.Balance,
                openingDate: DateOnly.FromDateTime(DateTime.Today),
                bankIdentifiers: account.BankIdentifiers);

            AppState.AddOrUpdateAccount(updatedAccount);

            _infoMessage = Text(
                "Account_BalanceUpdated",
                updatedAccount.Name,
                Formatter.Money(updatedAccount.OpeningBalance),
                Formatter.Date(updatedAccount.OpeningDate));

            _balanceEditModel = null;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void CancelBalanceEdit()
    {
        ClearMessages();
        _balanceEditModel = null;
    }

    private void AddInterestContract()
    {
        if (_editModel is null)
        {
            return;
        }

        _editModel.InterestContracts.Add(new AccountInterestContractEditModel
        {
            Id = Guid.NewGuid(),
            Name = string.IsNullOrWhiteSpace(_editModel.Name)
                ? Text("Account_DefaultInterestContractName")
                : Text("Account_DefaultNamedInterestContractName", _editModel.Name),
            CalculationMethod = AccountInterestCalculationMethod.FlatBalance,
            PostingFrequency = InterestPostingFrequency.Yearly,
            DayCountConvention = InterestDayCountConvention.Actual360,
            StartDate = _editModel.OpeningDate,
            IsActive = true,
            FlatAnnualRatePercent = 0m,
            Tiers =
            [
                new AccountInterestTierEditModel
                {
                    FromAmount = 0m,
                    ToAmount = null,
                    AnnualRatePercent = 0m
                }
            ]
        });
    }

    private void RemoveInterestContract(AccountInterestContractEditModel contract)
    {
        if (_editModel is null)
        {
            return;
        }

        _editModel.InterestContracts.Remove(contract);
    }

    private static void AddInterestTier(AccountInterestContractEditModel contract)
    {
        var nextFromAmount = 0m;

        if (contract.Tiers.Count > 0)
        {
            var highestToAmount = contract.Tiers
                .Where(x => x.ToAmount is not null)
                .Select(x => x.ToAmount!.Value)
                .DefaultIfEmpty(0m)
                .Max();

            var highestFromAmount = contract.Tiers
                .Select(x => x.FromAmount)
                .DefaultIfEmpty(0m)
                .Max();

            nextFromAmount = Math.Max(highestToAmount, highestFromAmount);
        }

        contract.Tiers.Add(new AccountInterestTierEditModel
        {
            FromAmount = nextFromAmount,
            ToAmount = null,
            AnnualRatePercent = 0m
        });
    }

    private static void RemoveInterestTier(
        AccountInterestContractEditModel contract,
        AccountInterestTierEditModel tier)
    {
        contract.Tiers.Remove(tier);
    }

    private string GetOwnerName(Account account)
    {
        if (AppState.CurrentPlan is null)
        {
            return AppFormatter.EmptyMarker;
        }

        if (account.Owners is null || account.Owners.Count == 0)
        {
            return AppFormatter.EmptyMarker;
        }

        var ownerNames = account.Owners
            .Select(owner => AppState.CurrentPlan.Persons
                .SingleOrDefault(person => person.Id == owner.PersonId)
                ?.DisplayName ?? "?")
            .ToList();

        return ownerNames.Count == 0
            ? AppFormatter.EmptyMarker
            : string.Join(", ", ownerNames);
    }

    private string FormatPillar3aSubtype(Account account)
    {
        if (account.Type != AccountType.Pillar3a)
        {
            return AppFormatter.EmptyMarker;
        }

        return EnumL.TranslateNullable(account.Pillar3aSubtype);
    }

    private static string FormatInterestContracts(Account account)
    {
        if (account.InterestContracts.Count == 0)
        {
            return AppFormatter.EmptyMarker;
        }

        var activeCount = account.InterestContracts.Count(x => x.IsActive);

        return $"{activeCount}/{account.InterestContracts.Count}";
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object?[] arguments)
    {
        // IStringLocalizer forwards to string.Format, which renders null args as empty.
        return L[key, arguments!].Value;
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
    }

    private void OpenStatement(Account account)
    {
        NavigationManager.NavigateTo($"accounts/{account.Id}/statement");
    }

    private Account PreserveBankImportIdentifiers(Account updatedAccount)
    {
        if (AppState.CurrentPlan is null)
        {
            return updatedAccount;
        }

        var existingAccount = AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == updatedAccount.Id);

        if (existingAccount is null)
        {
            return updatedAccount;
        }

        return CopyAccount(
            updatedAccount,
            openingBalance: updatedAccount.OpeningBalance,
            openingDate: updatedAccount.OpeningDate,
            bankIdentifiers: existingAccount.BankIdentifiers,
            iban: existingAccount.Iban);
    }

    private static Account CopyAccount(
        Account account,
        decimal openingBalance,
        DateOnly openingDate,
        List<AccountBankIdentifier> bankIdentifiers,
        string? iban = null)
    {
        return new Account
        {
            Id = account.Id,
            InterestContracts = account.InterestContracts,
            Name = account.Name,
            Type = account.Type,
            Currency = account.Currency,
            OpeningBalance = openingBalance,
            OpeningDate = openingDate,
            IsActive = account.IsActive,
            BankName = account.BankName,
            Iban = iban ?? account.Iban,
            IbanMasked = account.IbanMasked,
            BankIdentifiers = bankIdentifiers,
            Notes = account.Notes,
            Owners = account.Owners,
            Pillar3aSubtype = account.Pillar3aSubtype
        };
    }

