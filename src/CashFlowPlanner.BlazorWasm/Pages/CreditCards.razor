@page "/creditcards"

@using System.Globalization
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core.Accounts
@using CashFlowPlanner.Core.CreditCards
@using Microsoft.Extensions.Localization

@inject CashFlowAppState AppState
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL

<PageTitle>@L["CreditCard_Title"] - CashFlow Planner</PageTitle>

<h1>@L["CreditCard_Title"]</h1>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_infoMessage))
{
    <div class="alert alert-success">
        @_infoMessage
    </div>
}

@if (AppState.CurrentPlan is null)
{
    <PlanEmptyState Message='@L["CreditCard_NoPlanLoaded"]' />
}
else
{
    var plan = AppState.CurrentPlan;

    <div class="alert alert-secondary">
        <strong>@L["CreditCard_InfoTitle"]</strong>
        @L["CreditCard_InfoText"]
    </div>

    <div class="mb-3">
        <button class="btn btn-primary me-2" @onclick="NewCreditCard">
            @L["CreditCard_AddContract"]
        </button>
    </div>

    @if (_editModel is not null)
    {
        <div class="card mb-4">
            <div class="card-header">
                @(_isNewCreditCard ? L["CreditCard_AddContract"] : L["CreditCard_EditContract"])
            </div>

            <div class="card-body">
                <EditForm Model="_editModel" OnValidSubmit="SaveCreditCard">
                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label">@L["Name"]</label>
                            <InputText class="form-control" @bind-Value="_editModel.Name" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">@L["CreditCard_CreditCardAccount"]</label>
                            <InputSelect class="form-select" @bind-Value="_editModel.CreditCardAccountIdText">
                                <option value="">@L["CreditCard_SelectCreditCardAccount"]</option>
                                @foreach (var account in CreditCardAccounts)
                                {
                                    <option value="@account.Id">@account.Name (@EnumL.Translate(account.Type))</option>
                                }
                            </InputSelect>
                            <div class="form-text">
                                @L["CreditCard_CreditCardAccountHint"]
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">@L["CreditCard_PaymentAccount"]</label>
                            <InputSelect class="form-select" @bind-Value="_editModel.PaymentAccountIdText">
                                <option value="">@L["CreditCard_SelectPaymentAccount"]</option>
                                @foreach (var account in PaymentAccounts)
                                {
                                    <option value="@account.Id">@account.Name (@EnumL.Translate(account.Type))</option>
                                }
                            </InputSelect>
                            <div class="form-text">
                                @L["CreditCard_PaymentAccountHint"]
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">@L["CreditCard_ClosingDay"]</label>
                            <InputNumber class="form-control" @bind-Value="_editModel.ClosingDayOfMonth" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">@L["CreditCard_PaymentDay"]</label>
                            <InputNumber class="form-control" @bind-Value="_editModel.PaymentDayOfMonth" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">@L["CreditCard_PaymentMethod"]</label>
                            <InputSelect class="form-select" @bind-Value="_editModel.PaymentMethod">
                                @foreach (var method in Enum.GetValues<CreditCardPaymentMethod>())
                                {
                                    <option value="@method">@EnumL.Translate(method)</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">@L["CreditCard_BusinessDayAdjustment"]</label>
                            <InputSelect class="form-select" @bind-Value="_editModel.PaymentBusinessDayAdjustment">
                                @foreach (var adjustment in Enum.GetValues<BusinessDayAdjustment>())
                                {
                                    <option value="@adjustment">@EnumL.Translate(adjustment)</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">@L["Active"]</label>
                            <div class="form-check mt-2">
                                <InputCheckbox class="form-check-input" @bind-Value="_editModel.IsActive" />
                                <label class="form-check-label">@L["Active"]</label>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">@L["CreditCard_StartDate"]</label>
                            <InputDate class="form-control" @bind-Value="_editModel.StartDate" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">@L["CreditCard_EndDate"]</label>
                            <InputDate class="form-control" @bind-Value="_editModel.EndDate" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">@L["Notes"]</label>
                            <InputTextArea class="form-control" @bind-Value="_editModel.Notes" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-success me-2" type="submit">
                            @L["Save"]
                        </button>

                        <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">
                            @L["Cancel"]
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Active"]</th>
                <th>@L["CreditCard_CreditCardAccount"]</th>
                <th>@L["CreditCard_PaymentAccount"]</th>
                <th>@L["CreditCard_ClosingDay"]</th>
                <th>@L["CreditCard_PaymentDay"]</th>
                <th>@L["CreditCard_Method"]</th>
                <th>@L["CreditCard_Adjustment"]</th>
                <th class="text-end">@L["CreditCard_CurrentBalance"]</th>
                
                <th class="text-end">@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var creditCard in plan.CreditCards.OrderBy(x => x.Name))
            {
                var currentBalance = GetAccountBalance(creditCard.CreditCardAccountId);

                <tr>
                    <td>@creditCard.Name</td>
                    <td>
                        @if (creditCard.IsActive)
                        {
                            <span class="badge bg-success">@L["Active"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@L["Inactive"]</span>
                        }
                    </td>
                    <td>@GetAccountName(creditCard.CreditCardAccountId)</td>
                    <td>@GetAccountName(creditCard.PaymentAccountId)</td>
                    <td>@creditCard.ClosingDayOfMonth</td>
                    <td>@creditCard.PaymentDayOfMonth</td>
                    <td>@EnumL.Translate(creditCard.PaymentMethod)</td>
                    <td>@EnumL.Translate(creditCard.PaymentBusinessDayAdjustment)</td>
                    <td class="text-end">@currentBalance.ToString("N2", CultureInfo.CurrentCulture)</td>
                    
                    <td class="text-end" style="white-space: nowrap;">
                        <button class="btn btn-sm btn-primary me-1" @onclick="() => EditCreditCard(creditCard)">
                            @L["Edit"]
                        </button>

                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteCreditCard(creditCard)">
                            @L["Delete"]
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (plan.CreditCards.Count == 0)
    {
        <div class="alert alert-info">
            @L["CreditCard_NoContractsDefined"]
        </div>
    }
}

@code {
    private CreditCardEditModel? _editModel;
    private bool _isNewCreditCard;

    private string? _errorMessage;
    private string? _infoMessage;

    private IReadOnlyList<Account> CreditCardAccounts =>
        AppState.CurrentPlan?.Accounts
            .Where(x => x.Type == AccountType.CreditCard)
            .OrderBy(x => x.Name)
            .ToList()
        ?? [];

    private IReadOnlyList<Account> PaymentAccounts =>
        AppState.CurrentPlan?.Accounts
            .Where(x => x.Type is AccountType.BankAccount or AccountType.SavingsAccount or AccountType.Cash)
            .OrderBy(x => x.Name)
            .ToList()
        ?? [];

    private void NewCreditCard()
    {
        ClearMessages();

        var plan = AppState.CurrentPlan;
        var startDate = plan?.SimulationSettings.StartDate ?? DateOnly.FromDateTime(DateTime.Today);

        _editModel = new CreditCardEditModel
        {
            Id = Guid.NewGuid(),
            Name = string.Empty,
            CreditCardAccountIdText = CreditCardAccounts.FirstOrDefault()?.Id.ToString() ?? string.Empty,
            PaymentAccountIdText = PaymentAccounts.FirstOrDefault()?.Id.ToString() ?? string.Empty,
            ClosingDayOfMonth = 15,
            PaymentDayOfMonth = 25,
            PaymentMethod = CreditCardPaymentMethod.AutomaticLsv,
            PaymentBusinessDayAdjustment = BusinessDayAdjustment.NextBusinessDay,
            StartDate = startDate,
            IsActive = true
        };

        _isNewCreditCard = true;
    }

    private void EditCreditCard(CreditCardContract creditCard)
    {
        ClearMessages();

        _editModel = CreditCardEditModel.FromCreditCard(creditCard);
        _isNewCreditCard = false;
    }

    private void SaveCreditCard()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        try
        {
            ValidateEditModel();

            var creditCard = _editModel.ToCreditCard();

            AppState.AddOrUpdateCreditCard(creditCard);

            _infoMessage = _isNewCreditCard
                ? Text("CreditCard_Added", creditCard.Name)
                : Text("CreditCard_Updated", creditCard.Name);

            _editModel = null;
            _isNewCreditCard = false;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void DeleteCreditCard(CreditCardContract creditCard)
    {
        ClearMessages();

        try
        {
            AppState.DeleteCreditCard(creditCard.Id);
            _infoMessage = Text("CreditCard_Deleted", creditCard.Name);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        ClearMessages();

        _editModel = null;
        _isNewCreditCard = false;
    }

    private void ValidateEditModel()
    {
        if (_editModel is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editModel.Name))
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorNameRequired"));
        }

        if (string.IsNullOrWhiteSpace(_editModel.CreditCardAccountIdText))
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorCreditCardAccountRequired"));
        }

        if (string.IsNullOrWhiteSpace(_editModel.PaymentAccountIdText))
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorPaymentAccountRequired"));
        }

        if (_editModel.CreditCardAccountIdText == _editModel.PaymentAccountIdText)
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorAccountsMustBeDifferent"));
        }

        if (_editModel.ClosingDayOfMonth is < 1 or > 31)
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorClosingDayRange"));
        }

        if (_editModel.PaymentDayOfMonth is < 1 or > 31)
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorPaymentDayRange"));
        }

        if (_editModel.EndDate is not null && _editModel.EndDate < _editModel.StartDate)
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorEndDateBeforeStartDate"));
        }
    }

    private string GetAccountName(Guid accountId)
    {
        if (AppState.CurrentPlan is null)
        {
            return "?";
        }

        return AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == accountId)
            ?.Name ?? "?";
    }

    private decimal GetAccountBalance(Guid accountId)
    {
        if (AppState.CurrentPlan is null)
        {
            return 0m;
        }

        if (AppState.CurrentSimulationResult is not null)
        {
            return AppState.CurrentSimulationResult.GetBalance(
                accountId,
                AppState.CurrentPlan.SimulationSettings.EndDate);
        }

        return AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == accountId)
            ?.OpeningBalance ?? 0m;
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
    }
}