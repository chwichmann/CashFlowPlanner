@page "/creditcards"

@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core.Accounts
@using CashFlowPlanner.Core.CreditCards
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject CashFlowAppState AppState
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL
@inject AppFormatter Formatter

@* Outside the scaffold: the dialog has to survive the body being replaced by the empty state. *@
<ConfirmDialog @ref="_confirmDialog" />

<PageScaffold Title='@L["CreditCard_Title"]'
              RequiresPlan="true"
              EmptyStateMessage='@L["CreditCard_NoPlanLoaded"]'>
    <Actions>
        @if (AppState.CurrentPlan is not null)
        {
            <button class="btn btn-primary" @onclick="NewCreditCard">
                @L["CreditCard_AddContract"]
            </button>
        }
    </Actions>

    <Notifications>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_infoMessage))
        {
            <div class="alert alert-success" role="alert">
                @_infoMessage
            </div>
        }
    </Notifications>

    <ChildContent>
        <div class="alert alert-secondary">
            <strong>@L["CreditCard_InfoTitle"]</strong>
            @L["CreditCard_InfoText"]
        </div>

        @if (_editModel is not null)
        {
            <div class="card mb-4">
                <div class="card-header">
                    @(_isNewCreditCard ? L["CreditCard_AddContract"] : L["CreditCard_EditContract"])
                </div>

                <div class="card-body">
                    @* Named so that `context` inside the fields below is the FormField's, not the EditContext. *@
                    <EditForm Model="_editModel" OnValidSubmit="SaveCreditCard" Context="editContext">
                        <div class="row g-3">

                            <div class="col-md-4">
                                <FormField Label='@L["Name"]' CssClass="">
                                    <InputText id="@context.Id"
                                               class="form-control"
                                               @bind-Value="_editModel.Name" />
                                </FormField>
                            </div>

                            <div class="col-md-4">
                                <FormField Label='@L["CreditCard_CreditCardAccount"]'
                                           Hint='@L["CreditCard_CreditCardAccountHint"]'
                                           CssClass="">
                                    <InputSelect id="@context.Id"
                                                 aria-describedby="@context.DescribedBy"
                                                 class="form-select"
                                                 @bind-Value="_editModel.CreditCardAccountIdText">
                                        <option value="">@L["CreditCard_SelectCreditCardAccount"]</option>
                                        @foreach (var account in CreditCardAccounts)
                                        {
                                            <option value="@account.Id">@account.Name (@EnumL.Translate(account.Type))</option>
                                        }
                                    </InputSelect>
                                </FormField>
                            </div>

                            <div class="col-md-4">
                                <FormField Label='@L["CreditCard_PaymentAccount"]'
                                           Hint='@L["CreditCard_PaymentAccountHint"]'
                                           CssClass="">
                                    <InputSelect id="@context.Id"
                                                 aria-describedby="@context.DescribedBy"
                                                 class="form-select"
                                                 @bind-Value="_editModel.PaymentAccountIdText">
                                        <option value="">@L["CreditCard_SelectPaymentAccount"]</option>
                                        @foreach (var account in PaymentAccounts)
                                        {
                                            <option value="@account.Id">@account.Name (@EnumL.Translate(account.Type))</option>
                                        }
                                    </InputSelect>
                                </FormField>
                            </div>

                            <div class="col-md-2">
                                <FormField Label='@L["CreditCard_ClosingDay"]' CssClass="">
                                    <InputNumber id="@context.Id"
                                                 class="form-control num"
                                                 @bind-Value="_editModel.ClosingDayOfMonth" />
                                </FormField>
                            </div>

                            <div class="col-md-2">
                                <FormField Label='@L["CreditCard_PaymentDay"]' CssClass="">
                                    <InputNumber id="@context.Id"
                                                 class="form-control num"
                                                 @bind-Value="_editModel.PaymentDayOfMonth" />
                                </FormField>
                            </div>

                            <div class="col-md-3">
                                <FormField Label='@L["CreditCard_PaymentMethod"]' CssClass="">
                                    <InputSelect id="@context.Id"
                                                 class="form-select"
                                                 @bind-Value="_editModel.PaymentMethod">
                                        @foreach (var method in Enum.GetValues<CreditCardPaymentMethod>())
                                        {
                                            <option value="@method">@EnumL.Translate(method)</option>
                                        }
                                    </InputSelect>
                                </FormField>
                            </div>

                            <div class="col-md-3">
                                <FormField Label='@L["CreditCard_BusinessDayAdjustment"]' CssClass="">
                                    <InputSelect id="@context.Id"
                                                 class="form-select"
                                                 @bind-Value="_editModel.PaymentBusinessDayAdjustment">
                                        @foreach (var adjustment in Enum.GetValues<BusinessDayAdjustment>())
                                        {
                                            <option value="@adjustment">@EnumL.Translate(adjustment)</option>
                                        }
                                    </InputSelect>
                                </FormField>
                            </div>

                            <div class="col-md-2 d-flex align-items-end">
                                @* One label, associated with the box. This used to be two. *@
                                <FormField Label='@L["Active"]'
                                           Layout="FormFieldLayout.Checkbox"
                                           CssClass="">
                                    <InputCheckbox id="@context.Id"
                                                   class="form-check-input"
                                                   @bind-Value="_editModel.IsActive" />
                                </FormField>
                            </div>

                            <div class="col-md-3">
                                <FormField Label='@L["CreditCard_StartDate"]' CssClass="">
                                    <InputDate id="@context.Id"
                                               class="form-control"
                                               @bind-Value="_editModel.StartDate" />
                                </FormField>
                            </div>

                            <div class="col-md-3">
                                <FormField Label='@L["CreditCard_EndDate"]' CssClass="">
                                    <InputDate id="@context.Id"
                                               class="form-control"
                                               @bind-Value="_editModel.EndDate" />
                                </FormField>
                            </div>

                            <div class="col-12">
                                <FormField Label='@L["Notes"]' CssClass="">
                                    <InputTextArea id="@context.Id"
                                                   class="form-control"
                                                   @bind-Value="_editModel.Notes" />
                                </FormField>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-primary" type="submit">
                                @L["Save"]
                            </button>

                            <button class="btn btn-outline-secondary ms-2" type="button" @onclick="CancelEdit">
                                @L["Cancel"]
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <DataTable Items="CreditCardRows"
                   RowKey="@(x => x.Id)"
                   Caption='@L["CreditCard_Title"]'
                   TableCssClass="table table-sm table-striped table-hover align-middle"
                   EmptyText='@L["CreditCard_NoContractsDefined"]'>
            <Column Title='@L["Name"]' Text="@(x => x.Name)" />

            <Column Title='@L["Active"]'>
                <ChildContent Context="creditCard">
                    @if (creditCard.IsActive)
                    {
                        <span class="badge bg-success">@L["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@L["Inactive"]</span>
                    }
                </ChildContent>
            </Column>

            <Column Title='@L["CreditCard_CreditCardAccount"]'
                    Text="@(x => GetAccountName(x.CreditCardAccountId))" />

            <Column Title='@L["CreditCard_PaymentAccount"]'
                    Text="@(x => GetAccountName(x.PaymentAccountId))" />

            <Column Title='@L["CreditCard_ClosingDay"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Number(x.ClosingDayOfMonth, 0))" />

            <Column Title='@L["CreditCard_PaymentDay"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Number(x.PaymentDayOfMonth, 0))" />

            <Column Title='@L["CreditCard_Method"]'
                    Text="@(x => EnumL.Translate(x.PaymentMethod))" />

            <Column Title='@L["CreditCard_Adjustment"]'
                    Text="@(x => EnumL.Translate(x.PaymentBusinessDayAdjustment))" />

            <Column Title='@L["CreditCard_CurrentBalance"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Money(GetAccountBalance(x.CreditCardAccountId)))" />

            <Column Title='@L["Actions"]'
                    HeaderCssClass="text-end"
                    CellCssClass="text-end text-nowrap">
                <ChildContent Context="creditCard">
                    <button class="btn btn-sm btn-primary me-1" @onclick="() => EditCreditCard(creditCard)">
                        @L["Edit"]
                    </button>

                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteCreditCardAsync(creditCard)">
                        @L["Delete"]
                    </button>
                </ChildContent>
            </Column>
        </DataTable>
    </ChildContent>
</PageScaffold>

@code {
    private CreditCardEditModel? _editModel;
    private bool _isNewCreditCard;

    private string? _errorMessage;
    private string? _infoMessage;

    private ConfirmDialog? _confirmDialog;

    private IReadOnlyList<CreditCardContract> CreditCardRows =>
        AppState.CurrentPlan?.CreditCards
            .OrderBy(x => x.Name)
            .ToList()
        ?? [];

    private IReadOnlyList<Account> CreditCardAccounts =>
        AppState.CurrentPlan?.Accounts
            .Where(x => x.Type == AccountType.CreditCard)
            .OrderBy(x => x.Name)
            .ToList()
        ?? [];

    private IReadOnlyList<Account> PaymentAccounts =>
        AppState.CurrentPlan?.Accounts
            .Where(x => x.Type is AccountType.BankAccount or AccountType.SavingsAccount or AccountType.Cash)
            .OrderBy(x => x.Name)
            .ToList()
        ?? [];

    private void NewCreditCard()
    {
        ClearMessages();

        var plan = AppState.CurrentPlan;
        var startDate = plan?.SimulationSettings.StartDate ?? DateOnly.FromDateTime(DateTime.Today);

        _editModel = new CreditCardEditModel
        {
            Id = Guid.NewGuid(),
            Name = string.Empty,
            CreditCardAccountIdText = CreditCardAccounts.FirstOrDefault()?.Id.ToString() ?? string.Empty,
            PaymentAccountIdText = PaymentAccounts.FirstOrDefault()?.Id.ToString() ?? string.Empty,
            ClosingDayOfMonth = 15,
            PaymentDayOfMonth = 25,
            PaymentMethod = CreditCardPaymentMethod.AutomaticLsv,
            PaymentBusinessDayAdjustment = BusinessDayAdjustment.NextBusinessDay,
            StartDate = startDate,
            IsActive = true
        };

        _isNewCreditCard = true;
    }

    private void EditCreditCard(CreditCardContract creditCard)
    {
        ClearMessages();

        _editModel = CreditCardEditModel.FromCreditCard(creditCard);
        _isNewCreditCard = false;
    }

    private void SaveCreditCard()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        try
        {
            ValidateEditModel();

            var creditCard = _editModel.ToCreditCard();

            AppState.AddOrUpdateCreditCard(creditCard);

            _infoMessage = _isNewCreditCard
                ? Text("CreditCard_Added", creditCard.Name)
                : Text("CreditCard_Updated", creditCard.Name);

            _editModel = null;
            _isNewCreditCard = false;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    // The plan autosaves to the browser working copy, so an accidental click here is not
    // recoverable without re-importing a file.
    private async Task DeleteCreditCardAsync(CreditCardContract creditCard)
    {
        ClearMessages();

        if (_confirmDialog is null)
        {
            return;
        }

        var confirmed = await _confirmDialog.ShowAsync(
            Text("Delete"),
            Text("Dialog_ConfirmMessage"));

        if (!confirmed)
        {
            return;
        }

        try
        {
            AppState.DeleteCreditCard(creditCard.Id);
            _infoMessage = Text("CreditCard_Deleted", creditCard.Name);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        ClearMessages();

        _editModel = null;
        _isNewCreditCard = false;
    }

    private void ValidateEditModel()
    {
        if (_editModel is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editModel.Name))
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorNameRequired"));
        }

        if (string.IsNullOrWhiteSpace(_editModel.CreditCardAccountIdText))
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorCreditCardAccountRequired"));
        }

        if (string.IsNullOrWhiteSpace(_editModel.PaymentAccountIdText))
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorPaymentAccountRequired"));
        }

        if (_editModel.CreditCardAccountIdText == _editModel.PaymentAccountIdText)
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorAccountsMustBeDifferent"));
        }

        if (_editModel.ClosingDayOfMonth is < 1 or > 31)
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorClosingDayRange"));
        }

        if (_editModel.PaymentDayOfMonth is < 1 or > 31)
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorPaymentDayRange"));
        }

        if (_editModel.EndDate is not null && _editModel.EndDate < _editModel.StartDate)
        {
            throw new InvalidOperationException(Text("CreditCard_ErrorEndDateBeforeStartDate"));
        }
    }

    private string GetAccountName(Guid accountId)
    {
        if (AppState.CurrentPlan is null)
        {
            return "?";
        }

        return AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == accountId)
            ?.Name ?? "?";
    }

    private decimal GetAccountBalance(Guid accountId)
    {
        if (AppState.CurrentPlan is null)
        {
            return 0m;
        }

        if (AppState.CurrentSimulationResult is not null)
        {
            return AppState.CurrentSimulationResult.GetBalance(
                accountId,
                AppState.CurrentPlan.SimulationSettings.EndDate);
        }

        return AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == accountId)
            ?.OpeningBalance ?? 0m;
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
    }
}
