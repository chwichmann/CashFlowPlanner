@page "/settings"

@using System.Globalization
@using CashFlowPlanner.BlazorWasm
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop

@inject BrowserPlanCacheService BrowserCache
@inject CashFlowAppState AppState
@inject IStringLocalizer<SharedResource> L
@inject BrowserCultureService CultureService
@inject IJSRuntime JsRuntime
@inject EnumLocalizer EnumL

<PageTitle>@L["Settings"] - CashFlow Planner</PageTitle>

<div class="container py-3">
    <h1 class="mb-3">@L["Settings"]</h1>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_infoMessage))
    {
        <div class="alert alert-success">
            @_infoMessage
        </div>
    }

    @if (AppState.CurrentPlan is null)
    {
        <div class="alert alert-warning">
            @L["Settings_NoPlanLoaded"]
        </div>
    }
    else if (_editModel is not null)
    {
        <div class="card mb-3">
            <div class="card-header">
                @L["Plan"]
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="plan-title">
                        @L["PlanTitle"]
                    </label>

                    <input id="plan-title"
                           class="form-control"
                           @bind="_planName" />
                </div>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="SavePlanName">
                    @L["SavePlanTitle"]
                </button>
            </div>
        </div>

        @if (_planDefaultsEditModel is not null && AppState.CurrentPlan is not null)
        {
            <div class="card mb-3">
                <div class="card-header">
                    @L["Settings_PlanDefaults"]
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="default-payment-account">
                            @L["Settings_DefaultPaymentAccount"]
                        </label>

                        <select id="default-payment-account"
                                class="form-select"
                                @bind="_planDefaultsEditModel.DefaultPaymentAccountId">
                            <option value="">
                                @L["Settings_NoDefaultPaymentAccount"]
                            </option>

                            @foreach (var account in AppState.CurrentPlan.Accounts.OrderBy(x => x.Name))
                            {
                                <option value="@account.Id">
                                    @account.Name
                                </option>
                            }
                        </select>

                        <div class="form-text">
                            @L["Settings_DefaultPaymentAccountHelp"]
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input id="treat-weekends-as-bank-off-days"
                               class="form-check-input"
                               type="checkbox"
                               @bind="_planDefaultsEditModel.TreatWeekendsAsBankOffDays" />

                        <label class="form-check-label" for="treat-weekends-as-bank-off-days">
                            @L["Settings_TreatWeekendsAsBankOffDays"]
                        </label>
                    </div>

                    <h5>@L["Settings_BankOffDays"]</h5>

                    <p class="text-muted">
                        @L["Settings_BankOffDaysHelp"]
                    </p>

                    @if (_planDefaultsEditModel.BankOffDays.Count == 0)
                    {
                        <div class="alert alert-light">
                            @L["Settings_NoBankOffDaysDefined"]
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>@L["Date"]</th>
                                        <th>@L["Name"]</th>
                                        <th>@L["Note"]</th>
                                        <th class="text-end">@L["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bankOffDay in _planDefaultsEditModel.BankOffDays.OrderBy(x => x.Date))
                                    {
                                        <tr>
                                            <td style="width: 12rem;">
                                                <input type="date"
                                                       class="form-control"
                                                       @bind="bankOffDay.Date" />
                                            </td>
                                            <td>
                                                <input class="form-control"
                                                       @bind="bankOffDay.Name" />
                                            </td>
                                            <td>
                                                <input class="form-control"
                                                       @bind="bankOffDay.Note" />
                                            </td>
                                            <td class="text-end">
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        @onclick="() => RemoveBankOffDay(bankOffDay)">
                                                    @L["Delete"]
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="AddBankOffDay">
                            @L["Settings_AddBankOffDay"]
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                @onclick="SavePlanDefaults">
                            @L["Settings_SavePlanDefaults"]
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="ReloadFromPlan">
                            @L["Reset"]
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">
                @L["Settings_SimulationSettings"]
            </div>

            <div class="card-body">
                <p class="text-muted">
                    @L["Settings_SimulationSettingsText"]
                </p>

                <div class="mb-3">
                    <label class="form-label" for="date-mode">
                        @L["Settings_DateMode"]
                    </label>

                    <select id="date-mode"
                            class="form-select"
                            @bind="_editModel.DateMode">
                        @foreach (var mode in Enum.GetValues<SimulationDateMode>())
                        {
                            <option value="@mode">
                                @EnumL.Translate(mode)
                            </option>
                        }
                    </select>
                </div>

                @if (_editModel.DateMode == SimulationDateMode.RollingHorizon)
                {
                    <div class="mb-3">
                        <label class="form-label" for="start-anchor">
                            @L["Settings_StartAnchor"]
                        </label>

                        <select id="start-anchor"
                                class="form-select"
                                @bind="_editModel.StartAnchor">
                            @foreach (var anchor in Enum.GetValues<SimulationStartAnchor>())
                            {
                                <option value="@anchor">
                                    @EnumL.Translate(anchor)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="horizon-months">
                            @L["Settings_HorizonMonths"]
                        </label>

                        <input id="horizon-months"
                               type="number"
                               min="1"
                               class="form-control"
                               @bind="_editModel.HorizonMonths" />
                    </div>

                    <div class="alert alert-light">
                        <strong>@L["Settings_EffectiveRangePreview"]</strong>
                        <div>
                            @FormatDate(GetPreviewRange().StartDate) - @FormatDate(GetPreviewRange().EndDate)
                        </div>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label" for="simulation-start-date">
                            @L["Settings_StartDate"]
                        </label>

                        <input id="simulation-start-date"
                               type="date"
                               class="form-control"
                               @bind="_editModel.StartDate" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="simulation-end-date">
                            @L["Settings_EndDate"]
                        </label>

                        <input id="simulation-end-date"
                               type="date"
                               class="form-control"
                               @bind="_editModel.EndDate" />
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label" for="granularity">
                        @L["Settings_Granularity"]
                    </label>

                    <select id="granularity"
                            class="form-select"
                            @bind="_editModel.Granularity">
                        @foreach (var granularity in Enum.GetValues<SimulationGranularity>())
                        {
                            <option value="@granularity">
                                @EnumL.Translate(granularity)
                            </option>
                        }
                    </select>
                </div>

                <div class="form-check mb-3">
                    <input id="include-inactive-accounts"
                           class="form-check-input"
                           type="checkbox"
                           @bind="_editModel.IncludeInactiveAccounts" />

                    <label class="form-check-label" for="include-inactive-accounts">
                        @L["Settings_IncludeInactiveAccounts"]
                    </label>
                </div>

                <div class="form-check mb-3">
                    <input id="warn-on-negative-bank-balance"
                           class="form-check-input"
                           type="checkbox"
                           @bind="_editModel.WarnOnNegativeBankBalance" />

                    <label class="form-check-label" for="warn-on-negative-bank-balance">
                        @L["Settings_WarnOnNegativeBankBalance"]
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveSettings">
                        @L["Settings_SaveSettings"]
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="ReloadFromPlan">
                        @L["Reset"]
                    </button>
                </div>

                @if (AppState.CurrentSimulationResult is not null)
                {
                    <div class="alert alert-info mt-3">
                        @Text(
                            "Settings_CurrentSimulationResult",
                            FormatDate(AppState.CurrentSimulationResult.StartDate),
                            FormatDate(AppState.CurrentSimulationResult.EndDate),
                            AppState.CurrentSimulationResult.Events.Count,
                            AppState.CurrentSimulationResult.BalancePoints.Count,
                            AppState.CurrentSimulationResult.Warnings.Count)
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                @L["BrowserWorkingCopy"]
            </div>

            <div class="card-body">
                <p class="text-muted">
                    @L["Settings_BrowserWorkingCopyText"]
                </p>

                <button type="button"
                        class="btn btn-outline-danger"
                        @onclick="ClearBrowserCacheAsync">
                    @L["ClearBrowserCache"]
                </button>

                @if (!string.IsNullOrWhiteSpace(_browserCacheMessage))
                {
                    <div class="alert alert-info mt-3">
                        @_browserCacheMessage
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                @L["LanguageAndRegion"]
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="language-culture">
                        @L["Language"]
                    </label>

                    <select id="language-culture"
                            class="form-select"
                            @bind="_cultureEditModel.LanguageCulture">
                        <option value="en">@L["Language_English"]</option>
                        <option value="de">@L["Language_German"]</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="region-culture">
                        @L["Region"]
                    </label>

                    <select id="region-culture"
                            class="form-select"
                            @bind="_cultureEditModel.RegionCulture">
                        <option value="en-CH">@L["Region_SwitzerlandEnglish"]</option>
                        <option value="de-CH">@L["Region_SwitzerlandGerman"]</option>
                        <option value="en-US">@L["Region_UnitedStatesEnglish"]</option>
                        <option value="de-DE">@L["Region_GermanyGerman"]</option>
                    </select>
                </div>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="SaveCulturePreferencesAsync">
                    @L["SaveLanguageAndRegion"]
                </button>

                <div class="form-text mt-2">
                    @L["LanguageChangeReloadHint"]
                </div>
            </div>
        </div>
    }
</div>

@code {
    private SimulationSettingsEditModel? _editModel;
    private PlanDefaultsEditModel? _planDefaultsEditModel;

    private string? _planName;
    private Guid? _loadedPlanId;

    private string? _browserCacheMessage;
    private string? _errorMessage;
    private string? _infoMessage;

    private CulturePreferenceEditModel _cultureEditModel = new();

    protected override async Task OnInitializedAsync()
    {
        var preferences = await CultureService.LoadAsync();

        _cultureEditModel = new CulturePreferenceEditModel
        {
            LanguageCulture = preferences.LanguageCulture,
            RegionCulture = preferences.RegionCulture
        };
    }

    protected override void OnParametersSet()
    {
        if (AppState.CurrentPlan is null)
        {
            _editModel = null;
            _planDefaultsEditModel = null;
            _planName = null;
            _loadedPlanId = null;

            return;
        }

        if (_editModel is null || _loadedPlanId != AppState.CurrentPlan.Id)
        {
            ReloadFromPlan();
        }
    }

    private void ReloadFromPlan()
    {
        ClearMessages();

        if (AppState.CurrentPlan is null)
        {
            _editModel = null;
            _planDefaultsEditModel = null;
            _planName = null;
            _loadedPlanId = null;

            return;
        }

        _loadedPlanId = AppState.CurrentPlan.Id;
        _planName = AppState.CurrentPlan.Name;

        _editModel = SimulationSettingsEditModel.FromSettings(
            AppState.CurrentPlan.SimulationSettings);

        _planDefaultsEditModel = PlanDefaultsEditModel.FromPlan(
            AppState.CurrentPlan);
    }

    private void SavePlanName()
    {
        ClearMessages();

        try
        {
            if (string.IsNullOrWhiteSpace(_planName))
            {
                throw new InvalidOperationException(Text("Settings_ErrorPlanTitleRequired"));
            }

            AppState.UpdatePlanName(_planName);

            _infoMessage = Text("Settings_PlanTitleSaved");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void SavePlanDefaults()
    {
        ClearMessages();

        if (_planDefaultsEditModel is null || AppState.CurrentPlan is null)
        {
            return;
        }

        try
        {
            var bankOffDays = _planDefaultsEditModel.ToBankOffDays();

            ValidatePlanDefaults(
                _planDefaultsEditModel.DefaultPaymentAccountId,
                bankOffDays);

            AppState.UpdatePlanDefaultsAndBankCalendar(
                _planDefaultsEditModel.DefaultPaymentAccountId,
                _planDefaultsEditModel.TreatWeekendsAsBankOffDays,
                bankOffDays);

            _infoMessage = Text("Settings_PlanDefaultsSaved");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void AddBankOffDay()
    {
        ClearMessages();

        if (_planDefaultsEditModel is null)
        {
            return;
        }

        _planDefaultsEditModel.BankOffDays.Add(new BankOffDayEditModel
        {
            Date = DateOnly.FromDateTime(DateTime.Today),
            Name = string.Empty,
            Note = null
        });
    }

    private void RemoveBankOffDay(BankOffDayEditModel bankOffDay)
    {
        ClearMessages();

        _planDefaultsEditModel?.BankOffDays.Remove(bankOffDay);
    }

    private void ValidatePlanDefaults(
        Guid? defaultPaymentAccountId,
        IReadOnlyCollection<BankOffDay> bankOffDays)
    {
        if (AppState.CurrentPlan is null)
        {
            return;
        }

        var accountIds = AppState.CurrentPlan.Accounts
            .Select(x => x.Id)
            .ToHashSet();

        if (defaultPaymentAccountId is not null &&
            !accountIds.Contains(defaultPaymentAccountId.Value))
        {
            throw new InvalidOperationException(
                Text("Settings_ErrorDefaultPaymentAccountUnknown"));
        }

        var duplicateDates = bankOffDays
            .GroupBy(x => x.Date)
            .Where(x => x.Count() > 1)
            .Select(x => x.Key)
            .OrderBy(x => x)
            .ToList();

        if (duplicateDates.Count > 0)
        {
            throw new InvalidOperationException(
                Text("Settings_ErrorDuplicateBankOffDays"));
        }

        foreach (var bankOffDay in bankOffDays)
        {
            bankOffDay.Validate();
        }
    }

    private async Task ClearBrowserCacheAsync()
    {
        ClearMessages();

        try
        {
            await BrowserCache.ClearAsync();

            AppState.Clear();

            _browserCacheMessage = Text("Settings_BrowserWorkingCopyCleared");
        }
        catch (Exception ex)
        {
            _browserCacheMessage = ex.Message;
        }
    }

    private void SaveSettings()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        try
        {
            ValidateEditModel();

            var settings = _editModel.ToSettings();

            AppState.UpdateSimulationSettings(settings);

            _infoMessage = Text("Settings_SimulationSettingsSaved");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void ValidateEditModel()
    {
        if (_editModel is null)
        {
            return;
        }

        var settings = _editModel.ToSettings();

        settings.Validate();
    }

    private SimulationDateRange GetPreviewRange()
    {
        if (_editModel is null)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);

            return new SimulationDateRange(today, today);
        }

        return _editModel
            .ToSettings()
            .GetEffectiveDateRange(DateOnly.FromDateTime(DateTime.Today));
    }

    private static string FormatDate(DateOnly date)
    {
        return date.ToString("d", CultureInfo.CurrentCulture);
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
        _browserCacheMessage = null;
    }

    private async Task SaveCulturePreferencesAsync()
    {
        ClearMessages();

        try
        {
            var preferences = new CulturePreferences
            {
                LanguageCulture = _cultureEditModel.LanguageCulture,
                RegionCulture = _cultureEditModel.RegionCulture
            };

            await CultureService.SaveAsync(preferences);

            _infoMessage = Text("LanguageAndRegionSaved");

            await JsRuntime.InvokeVoidAsync("location.reload");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }
}