@page "/settings"

@using CashFlowPlanner.BlazorWasm
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop

@inherits AppStateAwarePage

@inject BrowserPlanCacheService BrowserCache
@inject CashFlowAppState AppState
@inject AppFormatter Formatter
@inject IStringLocalizer<SharedResource> L
@inject BrowserCultureService CultureService
@inject IJSRuntime JsRuntime
@inject EnumLocalizer EnumL
@inject PlanExportPreferences ExportPreferences
@inject PlanCryptoService Crypto

<PageScaffold Title='@L["Settings"]'
              RequiresPlan="true"
              EmptyStateMessage='@L["Settings_NoPlanLoaded"]'>

    <Notifications>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_infoMessage))
        {
            <div class="alert alert-success" role="alert">@_infoMessage</div>
        }
    </Notifications>

    <ChildContent>
        @if (_editModel is { } editModel)
        {
            <div class="card mb-3">
                <div class="card-header">
                    @L["Settings_EncryptionTitle"]
                </div>

                <div class="card-body">
                    <FormField Label='@L["Settings_EncryptExports"]'
                               Hint='@L["Settings_EncryptExportsHint"]'
                               Layout="FormFieldLayout.Checkbox">
                        <input id="@context.Id"
                               class="form-check-input"
                               type="checkbox"
                               aria-describedby="@context.DescribedBy"
                               checked="@ExportPreferences.EncryptExports"
                               @onchange="OnEncryptExportsChangedAsync" />
                    </FormField>

                    @if (ExportPreferences.EncryptExports)
                    {
                        <p class="mb-2">
                            <span class="badge @(Crypto.IsUnlocked ? "text-bg-success" : "text-bg-secondary")">
                                @(Crypto.IsUnlocked
                                    ? L["Settings_EncryptionUnlocked"]
                                    : L["Settings_EncryptionLocked"])
                            </span>

                            @if (Crypto.IsUnlocked)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary ms-2"
                                        @onclick="LockNowAsync">
                                    @L["Settings_LockNow"]
                                </button>
                            }
                        </p>

                        <div class="alert alert-warning mb-0" role="alert">
                            <div><strong>@L["Passphrase_NoRecoveryTitle"]</strong></div>
                            <div>@L["Settings_RecoveryHint"]</div>
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    @L["Plan"]
                </div>

                <div class="card-body">
                    <FormField Label='@L["PlanTitle"]' Required="true">
                        <input id="@context.Id"
                               class="form-control"
                               aria-describedby="@context.DescribedBy"
                               @bind="_planName" />
                    </FormField>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SavePlanName">
                        @L["SavePlanTitle"]
                    </button>
                </div>
            </div>

            @if (_planDefaultsEditModel is { } planDefaults && AppState.CurrentPlan is { } plan)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        @L["Settings_PlanDefaults"]
                    </div>

                    <div class="card-body">
                        <FormField Label='@L["Settings_DefaultPaymentAccount"]'
                                   Hint='@L["Settings_DefaultPaymentAccountHelp"]'>
                            <select id="@context.Id"
                                    class="form-select"
                                    aria-describedby="@context.DescribedBy"
                                    @bind="planDefaults.DefaultPaymentAccountId">
                                <option value="">
                                    @L["Settings_NoDefaultPaymentAccount"]
                                </option>

                                @foreach (var account in plan.Accounts.OrderBy(x => x.Name))
                                {
                                    <option value="@account.Id">
                                        @account.Name
                                    </option>
                                }
                            </select>
                        </FormField>

                        <FormField Label='@L["Settings_TreatWeekendsAsBankOffDays"]'
                                   Layout="FormFieldLayout.Checkbox">
                            <input id="@context.Id"
                                   class="form-check-input"
                                   type="checkbox"
                                   @bind="planDefaults.TreatWeekendsAsBankOffDays" />
                        </FormField>

                        <h5>@L["Settings_BankOffDays"]</h5>

                        <p class="text-muted">
                            @L["Settings_BankOffDaysHelp"]
                        </p>

                        <DataTable Items="@planDefaults.BankOffDays.OrderBy(x => x.Date).ToList()"
                                   EmptyText='@L["Settings_NoBankOffDaysDefined"]'
                                   Caption='@L["Settings_BankOffDays"]'>
                            <Column Title='@L["Date"]'>
                                <ChildContent>
                                    <input type="date"
                                           class="form-control"
                                           style="max-width: 12rem;"
                                           aria-label='@L["Date"]'
                                           @bind="context.Date" />
                                </ChildContent>
                            </Column>
                            <Column Title='@L["Name"]'>
                                <ChildContent>
                                    <input class="form-control"
                                           aria-label='@L["Name"]'
                                           @bind="context.Name" />
                                </ChildContent>
                            </Column>
                            <Column Title='@L["Note"]'>
                                <ChildContent>
                                    <input class="form-control"
                                           aria-label='@L["Note"]'
                                           @bind="context.Note" />
                                </ChildContent>
                            </Column>
                            <Column Title='@L["Actions"]' Align="ColumnAlign.Number">
                                <ChildContent>
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            @onclick="() => RemoveBankOffDay(context)">
                                        @L["Delete"]
                                    </button>
                                </ChildContent>
                            </Column>
                        </DataTable>

                        <div class="d-flex gap-2">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="AddBankOffDay">
                                @L["Settings_AddBankOffDay"]
                            </button>

                            <button type="button"
                                    class="btn btn-primary"
                                    @onclick="SavePlanDefaults">
                                @L["Settings_SavePlanDefaults"]
                            </button>

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="ReloadFromPlan">
                                @L["Reset"]
                            </button>
                        </div>
                    </div>
                </div>
            }

            <div class="card mb-3">
                <div class="card-header">
                    @L["Settings_SimulationSettings"]
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        @L["Settings_SimulationSettingsText"]
                    </p>

                    <FormField Label='@L["Settings_DateMode"]'>
                        <select id="@context.Id"
                                class="form-select"
                                aria-describedby="@context.DescribedBy"
                                @bind="editModel.DateMode">
                            @foreach (var mode in Enum.GetValues<SimulationDateMode>())
                            {
                                <option value="@mode">
                                    @EnumL.Translate(mode)
                                </option>
                            }
                        </select>
                    </FormField>

                    @if (editModel.DateMode == SimulationDateMode.RollingHorizon)
                    {
                        <FormField Label='@L["Settings_StartAnchor"]'>
                            <select id="@context.Id"
                                    class="form-select"
                                    aria-describedby="@context.DescribedBy"
                                    @bind="editModel.StartAnchor">
                                @foreach (var anchor in Enum.GetValues<SimulationStartAnchor>())
                                {
                                    <option value="@anchor">
                                        @EnumL.Translate(anchor)
                                    </option>
                                }
                            </select>
                        </FormField>

                        <FormField Label='@L["Settings_HorizonMonths"]'>
                            <input id="@context.Id"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   aria-describedby="@context.DescribedBy"
                                   @bind="editModel.HorizonMonths" />
                        </FormField>

                        var previewRange = GetPreviewRange();

                        <div class="alert alert-light">
                            <strong>@L["Settings_EffectiveRangePreview"]</strong>
                            <div>
                                @Formatter.Date(previewRange.StartDate) - @Formatter.Date(previewRange.EndDate)
                            </div>
                        </div>
                    }
                    else
                    {
                        <FormField Label='@L["Settings_StartDate"]'>
                            <input id="@context.Id"
                                   type="date"
                                   class="form-control"
                                   aria-describedby="@context.DescribedBy"
                                   @bind="editModel.StartDate" />
                        </FormField>

                        <FormField Label='@L["Settings_EndDate"]'>
                            <input id="@context.Id"
                                   type="date"
                                   class="form-control"
                                   aria-describedby="@context.DescribedBy"
                                   @bind="editModel.EndDate" />
                        </FormField>
                    }

                    <FormField Label='@L["Settings_Granularity"]'>
                        <select id="@context.Id"
                                class="form-select"
                                aria-describedby="@context.DescribedBy"
                                @bind="editModel.Granularity">
                            @foreach (var granularity in Enum.GetValues<SimulationGranularity>())
                            {
                                <option value="@granularity">
                                    @EnumL.Translate(granularity)
                                </option>
                            }
                        </select>
                    </FormField>

                    <FormField Label='@L["Settings_IncludeInactiveAccounts"]'
                               Layout="FormFieldLayout.Checkbox">
                        <input id="@context.Id"
                               class="form-check-input"
                               type="checkbox"
                               @bind="editModel.IncludeInactiveAccounts" />
                    </FormField>

                    <FormField Label='@L["Settings_WarnOnNegativeBankBalance"]'
                               Layout="FormFieldLayout.Checkbox">
                        <input id="@context.Id"
                               class="form-check-input"
                               type="checkbox"
                               @bind="editModel.WarnOnNegativeBankBalance" />
                    </FormField>

                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-primary"
                                @onclick="SaveSettings">
                            @L["Settings_SaveSettings"]
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="ReloadFromPlan">
                            @L["Reset"]
                        </button>
                    </div>

                    @if (AppState.CurrentSimulationResult is { } simulationResult)
                    {
                        <div class="alert alert-info mt-3">
                            @Text(
                                "Settings_CurrentSimulationResult",
                                Formatter.Date(simulationResult.StartDate),
                                Formatter.Date(simulationResult.EndDate),
                                simulationResult.Events.Count,
                                simulationResult.BalancePoints.Count,
                                simulationResult.Warnings.Count)
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    @L["BrowserWorkingCopy"]
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        @L["Settings_BrowserWorkingCopyText"]
                    </p>

                    <button type="button"
                            class="btn btn-outline-danger"
                            @onclick="ClearBrowserCacheAsync">
                        @L["ClearBrowserCache"]
                    </button>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    @L["LanguageAndRegion"]
                </div>

                <div class="card-body">
                    <FormField Label='@L["Language"]'>
                        <select id="@context.Id"
                                class="form-select"
                                aria-describedby="@context.DescribedBy"
                                @bind="_cultureEditModel.LanguageCulture">
                            <option value="en">@L["Language_English"]</option>
                            <option value="de">@L["Language_German"]</option>
                        </select>
                    </FormField>

                    <FormField Label='@L["Region"]'>
                        <select id="@context.Id"
                                class="form-select"
                                aria-describedby="@context.DescribedBy"
                                @bind="_cultureEditModel.RegionCulture">
                            <option value="en-CH">@L["Region_SwitzerlandEnglish"]</option>
                            <option value="de-CH">@L["Region_SwitzerlandGerman"]</option>
                            <option value="en-US">@L["Region_UnitedStatesEnglish"]</option>
                            <option value="de-DE">@L["Region_GermanyGerman"]</option>
                        </select>
                    </FormField>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveCulturePreferencesAsync">
                        @L["SaveLanguageAndRegion"]
                    </button>

                    <div class="form-text mt-2">
                        @L["LanguageChangeReloadHint"]
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</PageScaffold>

<ConfirmDialog @ref="_confirmDialog" />

@code {
    private async Task OnEncryptExportsChangedAsync(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;

        await ExportPreferences.SetAsync(enabled);

        // Turning encryption off should not leave a derived key sitting in memory.
        if (!enabled)
        {
            await Crypto.LockAsync();
        }
    }

    private async Task LockNowAsync()
    {
        await Crypto.LockAsync();
    }

    private SimulationSettingsEditModel? _editModel;
    private PlanDefaultsEditModel? _planDefaultsEditModel;

    private string? _planName;
    private Guid? _loadedPlanId;

    private string? _errorMessage;
    private string? _infoMessage;

    private ConfirmDialog? _confirmDialog;

    private CulturePreferenceEditModel _cultureEditModel = new();

    protected override async Task OnInitializedAsync()
    {
        // The lock state changes from outside this page - an export unlocks the key -
        // so without this the badge below keeps showing whatever it said on first render.
        Crypto.LockStateChanged += OnCryptoStateChanged;
        ExportPreferences.Changed += OnCryptoStateChanged;

        var preferences = await CultureService.LoadAsync();

        _cultureEditModel = new CulturePreferenceEditModel
        {
            LanguageCulture = preferences.LanguageCulture,
            RegionCulture = preferences.RegionCulture
        };
    }

    protected override void OnParametersSet()
    {
        if (AppState.CurrentPlan is null)
        {
            _editModel = null;
            _planDefaultsEditModel = null;
            _planName = null;
            _loadedPlanId = null;

            return;
        }

        if (_editModel is null || _loadedPlanId != AppState.CurrentPlan.Id)
        {
            ReloadFromPlan();
        }
    }

    private void ReloadFromPlan()
    {
        ClearMessages();

        if (AppState.CurrentPlan is null)
        {
            _editModel = null;
            _planDefaultsEditModel = null;
            _planName = null;
            _loadedPlanId = null;

            return;
        }

        _loadedPlanId = AppState.CurrentPlan.Id;
        _planName = AppState.CurrentPlan.Name;

        _editModel = SimulationSettingsEditModel.FromSettings(
            AppState.CurrentPlan.SimulationSettings);

        _planDefaultsEditModel = PlanDefaultsEditModel.FromPlan(
            AppState.CurrentPlan);
    }

    private void SavePlanName()
    {
        ClearMessages();

        try
        {
            if (string.IsNullOrWhiteSpace(_planName))
            {
                throw new InvalidOperationException(Text("Settings_ErrorPlanTitleRequired"));
            }

            AppState.UpdatePlanName(_planName);

            _infoMessage = Text("Settings_PlanTitleSaved");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void SavePlanDefaults()
    {
        ClearMessages();

        if (_planDefaultsEditModel is null || AppState.CurrentPlan is null)
        {
            return;
        }

        try
        {
            var bankOffDays = _planDefaultsEditModel.ToBankOffDays();

            ValidatePlanDefaults(
                _planDefaultsEditModel.DefaultPaymentAccountId,
                bankOffDays);

            AppState.UpdatePlanDefaultsAndBankCalendar(
                _planDefaultsEditModel.DefaultPaymentAccountId,
                _planDefaultsEditModel.TreatWeekendsAsBankOffDays,
                bankOffDays);

            _infoMessage = Text("Settings_PlanDefaultsSaved");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void AddBankOffDay()
    {
        ClearMessages();

        if (_planDefaultsEditModel is null)
        {
            return;
        }

        _planDefaultsEditModel.BankOffDays.Add(new BankOffDayEditModel
        {
            Date = DateOnly.FromDateTime(DateTime.Today),
            Name = string.Empty,
            Note = null
        });
    }

    private void RemoveBankOffDay(BankOffDayEditModel bankOffDay)
    {
        ClearMessages();

        _planDefaultsEditModel?.BankOffDays.Remove(bankOffDay);
    }

    private void ValidatePlanDefaults(
        Guid? defaultPaymentAccountId,
        IReadOnlyCollection<BankOffDay> bankOffDays)
    {
        if (AppState.CurrentPlan is null)
        {
            return;
        }

        var accountIds = AppState.CurrentPlan.Accounts
            .Select(x => x.Id)
            .ToHashSet();

        if (defaultPaymentAccountId is not null &&
            !accountIds.Contains(defaultPaymentAccountId.Value))
        {
            throw new InvalidOperationException(
                Text("Settings_ErrorDefaultPaymentAccountUnknown"));
        }

        var duplicateDates = bankOffDays
            .GroupBy(x => x.Date)
            .Where(x => x.Count() > 1)
            .Select(x => x.Key)
            .OrderBy(x => x)
            .ToList();

        if (duplicateDates.Count > 0)
        {
            throw new InvalidOperationException(
                Text("Settings_ErrorDuplicateBankOffDays"));
        }

        foreach (var bankOffDay in bankOffDays)
        {
            bankOffDay.Validate();
        }
    }

    private async Task ClearBrowserCacheAsync()
    {
        ClearMessages();

        if (_confirmDialog is null)
        {
            return;
        }

        // The single most destructive button in the app: one click used to wipe both the browser
        // working copy and the in-memory plan, with nothing asked and nothing to undo it.
        var confirmed = await _confirmDialog.ShowAsync(
            Text("ClearBrowserCache"),
            Text("Nav_ExportNeededHint"),
            confirmText: Text("ClearBrowserCache"),
            confirmCssClass: "btn btn-danger");

        if (!confirmed)
        {
            return;
        }

        try
        {
            await BrowserCache.ClearAsync();

            AppState.Clear();

            _infoMessage = Text("Settings_BrowserWorkingCopyCleared");
        }
        catch (Exception ex)
        {
            // Was reported in a blue "info" box beside the button, which is where a failure is
            // least likely to be read as one.
            _errorMessage = ex.Message;
        }
    }

    private void SaveSettings()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        try
        {
            ValidateEditModel();

            var settings = _editModel.ToSettings();

            AppState.UpdateSimulationSettings(settings);

            _infoMessage = Text("Settings_SimulationSettingsSaved");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void ValidateEditModel()
    {
        if (_editModel is null)
        {
            return;
        }

        var settings = _editModel.ToSettings();

        settings.Validate();
    }

    private SimulationDateRange GetPreviewRange()
    {
        if (_editModel is null)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);

            return new SimulationDateRange(today, today);
        }

        return _editModel
            .ToSettings()
            .GetEffectiveDateRange(DateOnly.FromDateTime(DateTime.Today));
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
    }

    private async Task SaveCulturePreferencesAsync()
    {
        ClearMessages();

        try
        {
            var preferences = new CulturePreferences
            {
                LanguageCulture = _cultureEditModel.LanguageCulture,
                RegionCulture = _cultureEditModel.RegionCulture
            };

            await CultureService.SaveAsync(preferences);

            _infoMessage = Text("LanguageAndRegionSaved");

            await JsRuntime.InvokeVoidAsync("location.reload");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private void OnCryptoStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        base.Dispose();

        Crypto.LockStateChanged -= OnCryptoStateChanged;
        ExportPreferences.Changed -= OnCryptoStateChanged;
    }
}
