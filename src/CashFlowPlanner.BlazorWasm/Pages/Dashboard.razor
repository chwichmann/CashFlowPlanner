@page "/dashboard"

@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core
@using CashFlowPlanner.Core.Mortgages
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject CashFlowAppState AppState
@inject DashboardSummaryService SummaryService
@inject AppFormatter Formatter
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL

<PageScaffold Title='@L["Dashboard_Title"]'
              RequiresPlan="true"
              EmptyStateMessage='@L["Dashboard_NoPlanLoaded"]'>

    @if (AppState.CurrentPlan is null || AppState.CurrentSimulationResult is null)
    {
        <div class="alert alert-warning" role="alert">
            @L["Dashboard_NoSimulationRun"]
        </div>
    }
    else
    {
        var plan = AppState.CurrentPlan;
        var result = AppState.CurrentSimulationResult;
        var summary = SummaryService.CreateSummary(plan, result);
        var endDate = plan.SimulationSettings.EndDate;

        @*
            Only the codes that make the numbers on this page wrong, not every warning the run
            produced - the full list lives on the Simulation page. An unlinked Pillar 3a contract
            means the net-worth tile below is understated by everything that contract holds, and a
            withdrawal that could not be posted means a payout the plan shows nowhere.
        *@
        <SimulationWarningPanel Warnings="result.Warnings"
                                Codes="NetWorthAffectingWarningCodes"
                                DescribeSource="DescribeWarningSource" />

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted">@L["Dashboard_LiquidAssets"]</div>
                        <div class="fs-4">@Formatter.Money(summary.LiquidAssets) @summary.Currency</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted">@L["Dashboard_TotalLiabilities"]</div>
                        <div class="fs-4">@Formatter.Money(summary.TotalLiabilities) @summary.Currency</div>
                        <div class="small text-muted">
                            @L["Dashboard_Mortgages"]: @Formatter.Money(summary.MortgageLiabilities)<br />
                            @L["Dashboard_Other"]: @Formatter.Money(summary.AccountLiabilities)
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted">@L["Dashboard_NetWorth"]</div>
                        <div class="fs-4">@Formatter.Money(summary.NetWorth) @summary.Currency</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <div class="text-muted">@L["Dashboard_Warnings"]</div>
                        <div class="fs-4">@summary.WarningCount</div>
                        @if (summary.CriticalWarningCount > 0)
                        {
                            <div class="text-danger">
                                @Text("Dashboard_CriticalWarnings", summary.CriticalWarningCount)
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                @L["Dashboard_LiquidityRisk"]
            </div>
            <div class="card-body">
                <p>
                    @L["Dashboard_LowestTotalLiquidBalance"]:
                    <strong>@Formatter.Money(summary.LowestLiquidBalance) @summary.Currency</strong>

                    @if (summary.LowestLiquidBalanceDate is not null)
                    {
                        <span>
                            @L["Dashboard_On"] <strong>@Formatter.Date(summary.LowestLiquidBalanceDate.Value)</strong>
                        </span>
                    }
                </p>
            </div>
        </div>

        <LiquidBalanceChart Plan="plan" Result="result" />

        <NetWorthChart Plan="plan" Result="result" />

        <h3>@L["Dashboard_EndBalances"]</h3>

        <DataTable Items="@plan.Accounts.OrderBy(x => x.Type).ThenBy(x => x.Name).ToList()"
                   RowKey="@(account => account.Id)"
                   EmptyText='@L["Account_NoAccounts"]'
                   Caption='@L["Dashboard_EndBalances"]'>
            <Column Title='@L["Account"]' Text="@(account => account.Name)" />
            <Column Title='@L["Type"]' Text="@(account => EnumL.Translate(account.Type))" />
            <Column Title='@L["Dashboard_Balance"]'
                    Align="ColumnAlign.Number"
                    Text="@(account => Formatter.Money(result.GetBalance(account.Id, endDate)))" />
            <Column Title='@L["Currency"]' Text="@(account => account.Currency)" />
        </DataTable>

        @if (plan.Mortgages.Count > 0)
        {
            <h3>@L["Dashboard_MortgagePrincipals"]</h3>

            <DataTable Items="@plan.Mortgages.OrderBy(x => x.Name).ToList()"
                       RowKey="@(mortgage => mortgage.Id)"
                       Caption='@L["Dashboard_MortgagePrincipals"]'>
                <Column Title='@L["Dashboard_Mortgage"]' Text="@(mortgage => mortgage.Name)" />
                <Column Title='@L["Type"]' Text="@(mortgage => EnumL.Translate(mortgage.Type))" />
                <Column Title='@L["Dashboard_Amortisation"]'
                        Text="@(mortgage => EnumL.Translate(mortgage.AmortisationMode))" />
                <Column Title='@L["Dashboard_ProjectedPrincipal"]'
                        Align="ColumnAlign.Number"
                        Text="@(mortgage => Formatter.Money(GetProjectedMortgagePrincipal(mortgage, result, endDate)))" />
                <Column Title='@L["Currency"]' Text="@(mortgage => plan.BaseCurrency)" />
            </DataTable>
        }
    }
</PageScaffold>

@code {
    private static readonly string[] NetWorthAffectingWarningCodes =
    [
        "PILLAR3A_CONTRACT_NOT_LINKED",
        "PILLAR3A_ACCOUNT_NOT_SIMULATED",
        "PILLAR3A_WITHDRAWAL_NOT_POSTED"
    ];

    private string? DescribeWarningSource(SimulationWarning warning)
    {
        var plan = AppState.CurrentPlan;

        if (plan is null || warning.SourceId is not { } sourceId)
        {
            return null;
        }

        return plan.Pillar3aContracts.SingleOrDefault(x => x.Id == sourceId)?.Name;
    }

    private static decimal GetProjectedMortgagePrincipal(
        MortgageContract mortgage,
        SimulationResult result,
        DateOnly date)
    {
        var projectedPrincipal = result.GetMortgagePrincipal(
            mortgage.Id,
            date);

        if (projectedPrincipal > 0)
        {
            return projectedPrincipal;
        }

        return mortgage.CalculationPrincipal ?? mortgage.InitialPrincipal;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }
}
