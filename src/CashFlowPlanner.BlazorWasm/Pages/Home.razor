@page "/"

@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core
@using CashFlowPlanner.BlazorWasm.Services
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject CashFlowAppState AppState
@inject AppFormatter Formatter
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL

@*
    The landing page deliberately does not set RequiresPlan: it is the one route that has to be
    useful with nothing loaded, and its own PlanEmptyState sits between the two cards rather than
    replacing the page body.
*@
<PageScaffold Title="CashFlow Planner"
              DocumentTitle="CashFlow Planner"
              Subtitle='@L["Home_Text"]'>

    @if (AppState.CurrentPlan is null)
    {
        <PlanEmptyState Message='@L["Home_NoPlanLoaded"]' />
    }
    else
    {
        var plan = AppState.CurrentPlan;

        <div class="card mb-4">
            <div class="card-header">
                <strong>@L["Home_LoadedPlan"]</strong>
            </div>

            <div class="card-body">
                <h6>@plan.Name</h6>

                <dl class="row mb-0">
                    <dt class="col-sm-3">@L["Home_BaseCurrency"]</dt>
                    <dd class="col-sm-9">@plan.BaseCurrency</dd>

                    <dt class="col-sm-3">@L["Home_Accounts"]</dt>
                    <dd class="col-sm-9">@plan.Accounts.Count</dd>

                    <dt class="col-sm-3">@L["Home_Transactions"]</dt>
                    <dd class="col-sm-9">@plan.Transactions.Count</dd>

                    <dt class="col-sm-3">@L["Home_Morgages"]</dt>
                    <dd class="col-sm-9">@plan.Mortgages.Count</dd>

                    <dt class="col-sm-3">@L["Home_CreditCards"]</dt>
                    <dd class="col-sm-9">@plan.CreditCards.Count</dd>

                    <dt class="col-sm-3">@L["Home_Persons"]</dt>
                    <dd class="col-sm-9">@plan.Persons.Count</dd>

                    <dt class="col-sm-3">@L["Home_Simulation"]</dt>
                    <dd class="col-sm-9">
                        @Text(
                            "Home_SimulationDateRange",
                            Formatter.Date(plan.SimulationSettings.StartDate),
                            Formatter.Date(plan.SimulationSettings.EndDate))
                    </dd>
                </dl>
            </div>
        </div>
    }

    @if (AppState.CurrentSimulationResult is not null && AppState.CurrentPlan is not null)
    {
        var result = AppState.CurrentSimulationResult;
        var plan = AppState.CurrentPlan;
        var endDate = plan.SimulationSettings.EndDate;

        <div class="card mb-4">
            <div class="card-header">
                <strong>@L["Home_SimulationResult"]</strong>
            </div>

            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">@L["Home_SimulationEvents"]</dt>
                    <dd class="col-sm-9">@result.Events.Count</dd>

                    <dt class="col-sm-3">@L["Home_SimulationBalancePoints"]</dt>
                    <dd class="col-sm-9">@result.BalancePoints.Count</dd>

                    <dt class="col-sm-3">@L["Home_SimulationWarnings"]</dt>
                    <dd class="col-sm-9">@result.Warnings.Count</dd>
                </dl>

                <h6>@L["Home_EndBalances"]</h6>

                <DataTable Items="@plan.Accounts.OrderBy(x => x.Name).ToList()"
                           RowKey="@(account => account.Id)"
                           EmptyText='@L["Account_NoAccounts"]'
                           Caption='@L["Home_EndBalances"]'>
                    <Column Title='@L["Home_EndBalancesAccount"]' Text="@(account => account.Name)" />
                    <Column Title='@L["Home_EndBalancesType"]' Text="@(account => EnumL.Translate(account.Type))" />
                    <Column Title='@L["Home_EndBalancesEndBalance"]'
                            Align="ColumnAlign.Number"
                            Text="@(account => Formatter.Money(result.GetBalance(account.Id, endDate)))" />
                    <Column Title='@L["Home_EndBalancesCurrency"]' Text="@(account => account.Currency)" />
                </DataTable>

                @if (result.Warnings.Count > 0)
                {
                    <h6>@L["Home_EndBalancesWarnings"]</h6>

                    <DataTable Items="@result.Warnings.Take(50).ToList()"
                               Caption='@L["Home_EndBalancesWarnings"]'>
                        <Column Title='@L["Home_EndBalancesWarningsDate"]'
                                Text="@(warning => Formatter.Date(warning.Date ?? DateOnly.MinValue))" />
                        <Column Title='@L["Home_EndBalancesWarningsSeverity"]'
                                Text="@(warning => warning.Severity.ToString())" />
                        <Column Title='@L["Home_EndBalancesWarningsCode"]' Text="@(warning => warning.Code)" />
                        <Column Title='@L["Home_EndBalancesWarningsMessage"]' Text="@(warning => warning.Message)" />
                    </DataTable>

                    @if (result.Warnings.Count > 50)
                    {
                        <div class="alert alert-info">
                            @L["Home_EndBalancesWarningsInfo"]
                        </div>
                    }
                }

                <h6>@L["Home_UpcomingEvents"]</h6>

                <DataTable Items="@result.Events.Take(100).ToList()"
                           Caption='@L["Home_UpcomingEvents"]'>
                    <Column Title='@L["Home_UpcomingEventsDate"]'
                            Text="@(cashFlowEvent => Formatter.Date(cashFlowEvent.Date))" />
                    <Column Title='@L["Home_UpcomingEventsName"]' Text="@(cashFlowEvent => cashFlowEvent.Name)" />
                    <Column Title='@L["Home_UpcomingEventsKind"]'
                            Text="@(cashFlowEvent => EnumL.Translate(cashFlowEvent.Kind))" />
                    <Column Title='@L["Home_UpcomingEventsAmount"]'
                            Align="ColumnAlign.Number"
                            Text="@(cashFlowEvent => Formatter.Money(cashFlowEvent.Amount))" />
                    <Column Title='@L["Home_UpcomingEventsCurrency"]' Text="@(cashFlowEvent => cashFlowEvent.Currency)" />
                </DataTable>

                @if (result.Events.Count > 100)
                {
                    <div class="alert alert-info">
                        @L["Home_UpcomingEventsInfo"]
                    </div>
                }
            </div>
        </div>
    }
</PageScaffold>

@code {
    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }
}
