@page "/accounts/{AccountId:guid}/statement"

@using System.Globalization
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core.Accounts
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject CashFlowAppState AppState
@inject AppFormatter Formatter
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL

<PageScaffold Title="@L["AccountStatement_Title"]"
              RequiresPlan="true"
              EmptyStateMessage="@L["AccountStatement_NoPlanLoaded"]">

    @if (Account is null)
    {
        <div class="alert alert-warning">
            @L["AccountStatement_AccountNotFound"]
        </div>
    }
    else
    {
        var closingBalanceByDate = BuildClosingBalanceByDate();
        var lines = BuildLines(closingBalanceByDate);
        var chartPoints = BuildBalanceChartPoints(closingBalanceByDate);

        <div class="card mb-3">
            <div class="card-header fw-bold">
                @Account.Name
            </div>

            <div class="card-body">
                <div class="row g-4 align-items-stretch">
                    <div class="col-12 col-lg-4">
                        <dl class="row mb-0 account-info-list">
                            <dt class="col-sm-5">@L["Account_Type"]</dt>
                            <dd class="col-sm-7">@EnumL.Translate(Account.Type)</dd>

                            <dt class="col-sm-5">@L["Account_Currency"]</dt>
                            <dd class="col-sm-7">@Account.Currency</dd>

                            <dt class="col-sm-5">@L["Account_OpeningBalance"]</dt>
                            <dd class="col-sm-7">
                                @Formatter.Money(Account.OpeningBalance, Account.Currency)
                            </dd>

                            <dt class="col-sm-5">@L["Account_OpeningDate"]</dt>
                            <dd class="col-sm-7">@Formatter.Date(Account.OpeningDate)</dd>
                        </dl>
                    </div>

                    <div class="col-12 col-lg-8">
                        <div class="statement-chart-panel">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-semibold">
                                        @L["AccountStatement_BalanceOverTime"]
                                    </div>

                                    @if (chartPoints.Count > 0)
                                    {
                                        var latestPoint = chartPoints[^1];

                                        <div class="text-muted small">
                                            @Formatter.Date(latestPoint.Date):
                                            @Formatter.Money(latestPoint.Balance, latestPoint.Currency)
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (chartPoints.Count < 2)
                            {
                                <div class="text-muted small py-4">
                                    @L["AccountStatement_NotEnoughChartData"]
                                </div>
                            }
                            else
                            {
                                var svgPoints = BuildSvgBalanceChartPoints(chartPoints);
                                var polyline = BuildSvgPolyline(svgPoints);
                                var area = BuildSvgArea(svgPoints);
                                var minBalance = chartPoints.Min(x => x.Balance);
                                var maxBalance = chartPoints.Max(x => x.Balance);

                                <svg class="statement-balance-chart"
                                     viewBox="0 0 640 220"
                                     role="img"
                                     aria-label="@L["AccountStatement_BalanceOverTime"]">

                                    <line x1="52" y1="20" x2="52" y2="178" class="statement-chart-axis" />
                                    <line x1="52" y1="178" x2="620" y2="178" class="statement-chart-axis" />

                                    <line x1="52" y1="60" x2="620" y2="60" class="statement-chart-grid" />
                                    <line x1="52" y1="105" x2="620" y2="105" class="statement-chart-grid" />
                                    <line x1="52" y1="150" x2="620" y2="150" class="statement-chart-grid" />

                                    <polygon points="@area" class="statement-chart-area" />
                                    <polyline points="@polyline" class="statement-chart-line" />

                                    @foreach (var point in svgPoints)
                                    {
                                        <circle cx="@FormatSvg(point.X)"
                                                cy="@FormatSvg(point.Y)"
                                                r="3"
                                                class="statement-chart-point">
                                            <title>
                                                @Formatter.Date(point.Date):
                                                @Formatter.Money(point.Balance, point.Currency)
                                            </title>
                                        </circle>
                                    }
                                </svg>

                                <div class="d-flex justify-content-between small text-muted mt-1">
                                    <span>@Formatter.Date(chartPoints[0].Date)</span>
                                    <span>
                                        @Formatter.MoneyRounded(minBalance)
                                        -
                                        @Formatter.MoneyRounded(maxBalance)
                                        @chartPoints[^1].Currency
                                    </span>
                                    <span>@Formatter.Date(chartPoints[^1].Date)</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (AppState.CurrentSimulationResult is null)
        {
            <div class="alert alert-info">
                @L["AccountStatement_NoSimulationResult"]
            </div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-header fw-bold">
                    @L["AccountStatement_Range"]
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <FormField Label="@L["AccountStatement_From"]" CssClass="mb-0">
                                <input type="date" id="@context.Id" class="form-control" @bind="_fromDate" />
                            </FormField>
                        </div>

                        <div class="col-12 col-md-3">
                            <FormField Label="@L["AccountStatement_To"]" CssClass="mb-0">
                                <input type="date" id="@context.Id" class="form-control" @bind="_toDate" />
                            </FormField>
                        </div>
                    </div>
                </div>
            </div>

            <DataTable Items="lines"
                       RowKey="@(line => (object)line.Index)"
                       TableCssClass="table table-sm table-striped align-middle"
                       Caption="@L["AccountStatement_Title"]"
                       EmptyText="@L["AccountStatement_NoMovementsInRange"]">

                <Column Title="@L["AccountStatement_ValutaDate"]"
                        Text="@(line => Formatter.Date(line.ValutaDate))" />

                <Column Title="@L["AccountStatement_TitleColumn"]">
                    <ChildContent Context="line">
                        @line.Title

                        @if (!string.IsNullOrWhiteSpace(line.Notes))
                        {
                            <div class="small text-muted">
                                @line.Notes
                            </div>
                        }
                    </ChildContent>
                </Column>

                <Column Title="@L["Category"]" Text="@(line => line.Category ?? string.Empty)" />

                <Column Title="@L["Transaction_Counterparty"]"
                        Text="@(line => line.Counterparty ?? string.Empty)" />

                <Column Title="@L["AccountStatement_Incoming"]"
                        Align="ColumnAlign.Number"
                        CellCssClass="text-success"
                        Text="@(line => Formatter.Money(line.Incoming))" />

                <Column Title="@L["AccountStatement_Outgoing"]"
                        Align="ColumnAlign.Number"
                        CellCssClass="text-danger"
                        Text="@(line => Formatter.Money(line.Outgoing))" />

                @*
                    A closing balance is reported once per valuta date, on that date's last line.
                    The other lines get a genuinely empty cell rather than AppFormatter.EmptyMarker:
                    the balance is not missing there, it is simply not where this table reports it.
                *@
                <Column Title="@L["AccountStatement_Balance"]"
                        Align="ColumnAlign.Number"
                        CellCssClass="fw-semibold"
                        Text="@(line => line.ClosingBalance is null
                                   ? string.Empty
                                   : Formatter.Money(line.ClosingBalance.Value))" />
            </DataTable>
        }
    }
</PageScaffold>

@code {
    [Parameter]
    public Guid AccountId { get; set; }

    private DateOnly _fromDate;
    private DateOnly _toDate;
    private Guid? _initializedForAccountId;

    private Account? Account =>
        AppState.CurrentPlan?.Accounts.SingleOrDefault(x => x.Id == AccountId);

    protected override void OnParametersSet()
    {
        if (AppState.CurrentPlan is null)
        {
            return;
        }

        if (_initializedForAccountId == AccountId)
        {
            return;
        }

        _initializedForAccountId = AccountId;
        _fromDate = AppState.CurrentPlan.SimulationSettings.StartDate;
        _toDate = AppState.CurrentPlan.SimulationSettings.EndDate;
    }

    private IReadOnlyList<AccountStatementRow> BuildRows()
    {
        if (Account is null || AppState.CurrentSimulationResult is null)
        {
            return [];
        }

        var rows = AccountStatementBuilder.Build(
            Account,
            AppState.CurrentSimulationResult.Events,
            _fromDate,
            _toDate);

        // Important:
        // The displayed closing balance no longer depends on row.Balance.
        // We still sort the visible movement rows so that daily grouping is stable.
        return rows
            .Select((row, index) => new { Row = row, Index = index })
            .OrderBy(x => x.Row.ValutaDate)
            .ThenBy(x => IsOpeningBalanceRow(x.Row) ? 0 : 1)
            .ThenBy(x => x.Index)
            .Select(x => x.Row)
            .ToList();
    }

    /// <summary>
    /// Flattens the statement into what the table actually draws.
    ///
    /// The balance column used to be resolved in the markup from the row's position in the list -
    /// a cell reaching back into the collection to ask whether it was the last one of its day.
    /// A <see cref="DataTable{TItem}"/> cell only ever sees its own row, so the "is this the day's
    /// last line" question is answered once, here, where the list is in hand anyway.
    /// </summary>
    private IReadOnlyList<StatementLine> BuildLines(
        IReadOnlyDictionary<DateOnly, DailyClosingBalance> closingBalanceByDate)
    {
        var rows = BuildRows();
        var lines = new List<StatementLine>(rows.Count);

        for (var index = 0; index < rows.Count; index++)
        {
            var row = rows[index];

            var isLastOfDay = index == rows.Count - 1
                || rows[index + 1].ValutaDate != row.ValutaDate;

            decimal? closingBalance = null;

            if (isLastOfDay)
            {
                closingBalance = closingBalanceByDate.TryGetValue(row.ValutaDate, out var daily)
                    ? daily.Balance
                    : row.Balance;
            }

            lines.Add(new StatementLine(
                index,
                row.ValutaDate,
                row.Title,
                row.Notes,
                row.Category,
                row.Counterparty,
                row.Incoming,
                row.Outgoing,
                closingBalance));
        }

        return lines;
    }

    private IReadOnlyDictionary<DateOnly, DailyClosingBalance> BuildClosingBalanceByDate()
    {
        if (Account is null || AppState.CurrentSimulationResult is null)
        {
            return new Dictionary<DateOnly, DailyClosingBalance>();
        }

        return AppState.CurrentSimulationResult.BalancePoints
            .Where(x => x.AccountId == Account.Id)
            .Where(x => x.Date >= _fromDate && x.Date <= _toDate)
            .GroupBy(x => x.Date)
            .OrderBy(x => x.Key)
            .ToDictionary(
                x => x.Key,
                x =>
                {
                    var point = x.Last();

                    return new DailyClosingBalance(
                        point.Date,
                        point.Balance,
                        point.Currency);
                });
    }

    private static bool IsOpeningBalanceRow(AccountStatementRow row)
    {
        return string.Equals(
                row.Title,
                "Opening balance",
                StringComparison.OrdinalIgnoreCase)
            || string.Equals(
                row.Category,
                "Opening Balance",
                StringComparison.OrdinalIgnoreCase);
    }

    private sealed record StatementLine(
        int Index,
        DateOnly ValutaDate,
        string Title,
        string? Notes,
        string? Category,
        string? Counterparty,
        decimal? Incoming,
        decimal? Outgoing,
        decimal? ClosingBalance);

    private sealed record DailyClosingBalance(
        DateOnly Date,
        decimal Balance,
        string Currency);

    private sealed record AccountBalanceChartPoint(
        DateOnly Date,
        decimal Balance,
        string Currency);

    private sealed record SvgBalanceChartPoint(
        double X,
        double Y,
        DateOnly Date,
        decimal Balance,
        string Currency);

    private static IReadOnlyList<AccountBalanceChartPoint> BuildBalanceChartPoints(
        IReadOnlyDictionary<DateOnly, DailyClosingBalance> closingBalanceByDate)
    {
        return closingBalanceByDate
            .OrderBy(x => x.Key)
            .Select(x => new AccountBalanceChartPoint(
                x.Value.Date,
                x.Value.Balance,
                x.Value.Currency))
            .ToList();
    }

    private static IReadOnlyList<SvgBalanceChartPoint> BuildSvgBalanceChartPoints(
        IReadOnlyList<AccountBalanceChartPoint> points)
    {
        const double plotLeft = 52;
        const double plotTop = 20;
        const double plotWidth = 568;
        const double plotHeight = 158;

        if (points.Count == 0)
        {
            return [];
        }

        var minDate = points.Min(x => x.Date);
        var maxDate = points.Max(x => x.Date);

        var minBalance = points.Min(x => x.Balance);
        var maxBalance = points.Max(x => x.Balance);

        var dayRange = Math.Max(
            1,
            maxDate.DayNumber - minDate.DayNumber);

        var minValue = (double)minBalance;
        var maxValue = (double)maxBalance;

        if (Math.Abs(maxValue - minValue) < 0.0001)
        {
            var padding = Math.Max(
                1d,
                Math.Abs(maxValue) * 0.05d);

            minValue -= padding;
            maxValue += padding;
        }

        var valueRange = maxValue - minValue;

        return points
            .Select(point =>
            {
                var x = plotLeft
                    + ((point.Date.DayNumber - minDate.DayNumber) / (double)dayRange) * plotWidth;

                var y = plotTop
                    + ((maxValue - (double)point.Balance) / valueRange) * plotHeight;

                return new SvgBalanceChartPoint(
                    x,
                    y,
                    point.Date,
                    point.Balance,
                    point.Currency);
            })
            .ToList();
    }

    private static string BuildSvgPolyline(
        IReadOnlyList<SvgBalanceChartPoint> points)
    {
        return string.Join(
            " ",
            points.Select(point => $"{FormatSvg(point.X)},{FormatSvg(point.Y)}"));
    }

    private static string BuildSvgArea(
        IReadOnlyList<SvgBalanceChartPoint> points)
    {
        if (points.Count == 0)
        {
            return string.Empty;
        }

        const double baselineY = 178;

        var first = points[0];
        var last = points[^1];
        var linePoints = BuildSvgPolyline(points);

        return $"{FormatSvg(first.X)},{FormatSvg(baselineY)} " +
               $"{linePoints} " +
               $"{FormatSvg(last.X)},{FormatSvg(baselineY)}";
    }

    // Deliberately invariant and deliberately NOT AppFormatter: these are SVG path coordinates,
    // not display text. Under de-DE a culture-formatted "52,5" would split into two coordinates
    // and corrupt the geometry.
    private static string FormatSvg(double value)
    {
        return value.ToString("0.###", CultureInfo.InvariantCulture);
    }
}
