@page "/house-buy-simulator"

@using System.Globalization
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core.RealEstate
@using CashFlowPlanner.Core
@using CashFlowPlanner.BlazorWasm.Components
@using CashFlowPlanner.BlazorWasm.Services
@using Microsoft.Extensions.Localization

@inject CashFlowAppState AppState
@inject IStringLocalizer<SharedResource> L

<div class="page-header">
    <h1>@L["HouseBuy_Title"]</h1>
    <p>@L["HouseBuy_Subtitle"]</p>
</div>

@if (AppState.CurrentPlan is null)
{
    <section class="card">
        <p>@L["HouseBuy_LoadPlanFirst"]</p>
    </section>
}
else
{
    <section class="card">
    <div class="section-header">
        <div>
            <h2>@L["HouseBuy_Scenarios"]</h2>
            <p>@L["HouseBuy_ScenariosText"]</p>
        </div>

        <span class="status-pill @(CurrentScenarioExists ? "status-ok" : "status-fail")">
            @(CurrentScenarioExists ? L["HouseBuy_Saved"] : L["HouseBuy_Unsaved"])
        </span>
    </div>

    <div class="scenario-toolbar">
        <div class="scenario-select-row">
            <label>@L["HouseBuy_SelectedScenario"]</label>

            <select class="select-input scenario-select"
                    value="@GetScenarioIdString(CurrentScenarioId)"
                    @onchange="OnScenarioSelected">
                @if (SavedScenarios.Count == 0 || !CurrentScenarioExists)
                {
                    <option value="">@L["HouseBuy_CurrentUnsavedScenario"]</option>
                }

                @foreach (var scenario in SavedScenarios)
                {
                    <option value="@scenario.Id">@scenario.Name</option>
                }
            </select>
        </div>

        <div class="scenario-name-row">
            <label>@L["HouseBuy_ScenarioName"]</label>
            <InputText class="text-input scenario-name-input" @bind-Value="ScenarioName" />
        </div>

        <div class="scenario-button-row">
            <button type="button" class="btn btn-primary" @onclick="SaveScenario">
                @L["Save"]
            </button>

            <button type="button" class="btn btn-secondary" @onclick="CreateNewScenario">
                @L["New"]
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="DuplicateScenario">
                @L["Duplicate"]
            </button>

            <button type="button"
                    class="btn btn-danger"
                    disabled="@(!CurrentScenarioExists)"
                    @onclick="DeleteScenario">
                @L["Delete"]
            </button>
        </div>
    </div>
</section>

    <div class="simulator-grid">

        <section class="card">
            <h2>@L["HouseBuy_CurrentRealEstateSale"]</h2>

            <div class="field-stack">
                <div class="field-row">
                    <label>@L["HouseBuy_ExpectedSalePrice"]</label>
                    <div class="field-control">
                        <InputNumber class="currency-input" @bind-Value="SalePrice" />
                    </div>
                </div>

                <div class="field-row">
                    <label>@L["HouseBuy_RemainingMortgagePrincipal"]</label>
                    <div class="field-control">
                        <InputNumber class="currency-input" @bind-Value="SaleRemainingMortgage" />
                    </div>
                </div>

                <div class="field-row">
                    <label>@L["HouseBuy_SellingCosts"]</label>
                    <div class="field-control">
                        <InputNumber class="currency-input" @bind-Value="SaleCosts" />
                    </div>
                </div>

                <div class="field-row">
                    <label>@L["HouseBuy_Pillar2BoundAmount"]</label>
                    <div class="field-control">
                        <InputNumber class="currency-input" @bind-Value="SalePillar2BoundAmount" />
                    </div>
                </div>
            </div>

            @if (SaleResult is not null)
            {
                <div class="kv-list">
                    <div class="kv-row">
                        <span>@L["HouseBuy_NetProceeds"]</span>
                        <strong>@Money(SaleResult.NetProceeds)</strong>
                    </div>

                    <div class="kv-row">
                        <span>@L["HouseBuy_FreeCash"]</span>
                        <strong>@Money(SaleResult.FreeCashAmount)</strong>
                    </div>

                    <div class="kv-row">
                        <span>@L["HouseBuy_PurposeBoundPillar2"]</span>
                        <strong>@Money(SaleResult.Pillar2BoundAmount)</strong>
                    </div>

                    <div class="kv-row kv-total">
                        <span>@L["HouseBuy_TotalUsableForNextPurchase"]</span>
                        <strong>@Money(SaleResult.TotalAvailable)</strong>
                    </div>
                </div>

                <div class="button-row">
                    <button type="button" class="btn btn-secondary" @onclick="UseSaleProceedsAsEquity">
                        @L["HouseBuy_UseSaleProceedsAsEquity"]
                    </button>
                </div>
            }
        </section>

        <section class="card">
            <h2>@L["HouseBuy_NewRealEstate"]</h2>

            <div class="field-stack">
                <div class="field-row">
                    <label>@L["HouseBuy_BuyPrice"]</label>
                    <div class="field-control">
                        <InputNumber class="currency-input" @bind-Value="BuyPrice" />
                    </div>
                </div>

                <div class="field-row">
                    <label>@L["HouseBuy_RenovationPrice"]</label>
                    <div class="field-control">
                        <InputNumber class="currency-input" @bind-Value="RenovationPrice" />
                    </div>
                </div>

                <div class="field-row">
                    <label>@L["HouseBuy_DesiredMortgage"]</label>
                    <div class="field-control">
                        <InputNumber class="currency-input" @bind-Value="DesiredMortgage" />
                    </div>
                </div>

                <div class="field-row">
                    <label>@L["HouseBuy_TotalFinancingBasis"]</label>
                    <div class="field-control">
                        <strong>@Money(TotalPrice)</strong>
                    </div>
                </div>
            </div>

            <div class="button-row">
                <button type="button" class="btn btn-secondary" @onclick="SetMortgageToMaximum80Percent">
                    @L["HouseBuy_SetMortgageToMax80"]
                </button>

                <button type="button" class="btn btn-secondary" @onclick="SetMortgageFromEquity">
                    @L["HouseBuy_SetMortgageFromCurrentEquity"]
                </button>
            </div>
        </section>

        <section class="card">
            <h2>@L["HouseBuy_PersonsAndIncome"]</h2>
            <p>@L["HouseBuy_PersonsAndIncomeText"]</p>

            <div class="data-table">
                <div class="data-table-header person-grid">
                    <div>@L["Name"]</div>
                    <div>@L["HouseBuy_GrossSalaryYear"]</div>
                    <div></div>
                </div>

                @foreach (var person in Persons)
                {
                    <div class="data-table-row person-grid">
                        <InputText class="text-input" @bind-Value="person.Name" />
                        <InputNumber class="currency-input" @bind-Value="person.GrossAnnualIncome" />

                        <button type="button"
                                class="btn btn-danger btn-sm"
                                @onclick="() => RemovePerson(person.Id)">
                            @L["Remove"]
                        </button>
                    </div>
                }
            </div>

            <div class="button-row">
                <button type="button" class="btn btn-secondary" @onclick="AddPerson">
                    @L["HouseBuy_AddPerson"]
                </button>
            </div>

            <div class="kv-list">
                <div class="kv-row">
                    <span>@L["HouseBuy_TotalGrossIncomeYear"]</span>
                    <strong>@Money(TotalGrossIncome)</strong>
                </div>

                <div class="kv-row">
                    <span>@L["HouseBuy_MaxYearlyHousingCost"]</span>
                    <strong>@Money(TotalGrossIncome * Rules.MaxAffordabilityPercent / 100m)</strong>
                </div>

                <div class="kv-row">
                    <span>@L["HouseBuy_MaxMonthlyHousingCost"]</span>
                    <strong>@Money(TotalGrossIncome * Rules.MaxAffordabilityPercent / 100m / 12m)</strong>
                </div>
            </div>
        </section>

        <section class="card span-2">
            <h2>@L["HouseBuy_EquitySources"]</h2>
            <p>@L["HouseBuy_EquitySourcesText"]</p>

            <div class="data-table">
                <div class="data-table-header equity-grid">
                    <div>@L["Name"]</div>
                    <div>@L["HouseBuy_Person"]</div>
                    <div>@L["Type"]</div>
                    <div>@L["Amount"]</div>
                    <div></div>
                </div>

                @foreach (var equity in EquitySources)
                {
                    <div class="data-table-row equity-grid">
                        <InputText class="text-input" @bind-Value="equity.Name" />

                        <select class="select-input"
                                value="@GetPersonIdString(equity.PersonId)"
                                @onchange="e => SetEquityPerson(equity.Id, e.Value?.ToString())">
                            <option value="">@L["HouseBuy_HouseholdUnassigned"]</option>
                            @foreach (var person in Persons)
                            {
                                <option value="@person.Id.ToString()">@person.Name</option>
                            }
                        </select>

                        <select class="select-input"
                                value="@equity.Type.ToString()"
                                @onchange="e => SetEquityType(equity.Id, e.Value?.ToString())">
                            <option value="@EquitySourceType.Cash.ToString()">@L["HouseBuy_Cash"]</option>
                            <option value="@EquitySourceType.Pillar2Bvg.ToString()">@L["HouseBuy_Pillar2Bvg"]</option>
                        </select>

                        <InputNumber class="currency-input" @bind-Value="equity.Amount" />

                        <button type="button"
                                class="btn btn-danger btn-sm"
                                @onclick="() => RemoveEquitySource(equity.Id)">
                            @L["Remove"]
                        </button>
                    </div>
                }
            </div>

            <div class="equity-actions-summary">
                <div class="equity-actions">
                    <div class="button-row">
                        <button type="button" class="btn btn-secondary" @onclick="AddEquitySource">
                            @L["HouseBuy_AddEquitySource"]
                        </button>
                    </div>
                </div>

                <div class="equity-summary">
                    <div class="kv-list equity-kv">
                        <div class="kv-row">
                            <span>@L["HouseBuy_CashEquity"]</span>
                            <strong>@Money(CashEquity)</strong>
                        </div>

                        <div class="kv-row">
                            <span>@L["HouseBuy_Pillar2BvgEquity"]</span>
                            <strong>@Money(Pillar2Equity)</strong>
                        </div>

                        <div class="kv-row kv-total">
                            <span>@L["HouseBuy_TotalEquity"]</span>
                            <strong>@Money(TotalEquity)</strong>
                        </div>

                        <div class="kv-row">
                            <span>@L["HouseBuy_RequiredTotalEquity"]</span>
                            <strong>@Money(TotalPrice * Rules.MinTotalEquityPercent / 100m)</strong>
                        </div>

                        <div class="kv-row">
                            <span>@L["HouseBuy_RequiredHardEquity"]</span>
                            <strong>@Money(TotalPrice * Rules.MinHardEquityPercent / 100m)</strong>
                        </div>

                        <div class="kv-row">
                            <span>@L["HouseBuy_MaxPillar2Bvg"]</span>
                            <strong>@Money(TotalPrice * Rules.MaxPillar2Percent / 100m)</strong>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="card bank-assumptions-card">
            <h2>@L["HouseBuy_BankAssumptions"]</h2>

            <div class="settings-table">
                <div class="settings-row">
                    <label>@L["HouseBuy_ImputedInterestRatePercent"]</label>
                    <InputNumber class="percent-input" @bind-Value="ImputedInterestPercent" />
                </div>

                <div class="settings-row">
                    <label>@L["HouseBuy_MaintenancePercent"]</label>
                    <InputNumber class="percent-input" @bind-Value="MaintenancePercent" />
                </div>

                <div class="settings-row">
                    <label>@L["HouseBuy_AffordabilityLimitPercent"]</label>
                    <InputNumber class="percent-input" @bind-Value="MaxAffordabilityPercent" />
                </div>

                <div class="settings-row">
                    <label>@L["HouseBuy_FirstMortgageThresholdPercent"]</label>
                    <InputNumber class="percent-input" @bind-Value="FirstMortgageThresholdPercent" />
                </div>

                <div class="settings-row">
                    <label>@L["HouseBuy_AmortisationYears"]</label>
                    <InputNumber class="year-input" @bind-Value="AmortisationYearsDecimal" />
                </div>
            </div>
        </section>

        @if (Result is not null)
        {
            <section class="card wide-card result-rule-card">
                <div class="section-header">
                    <div class="result-title">
                        <span class="result-title-icon @(Result.IsViable ? "result-title-ok" : "result-title-fail")">
                            @if (Result.IsViable)
                            {
                                <svg class="icon-svg icon-svg-lg"
                                     width="22"
                                     height="22"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="3"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M20 6L9 17l-5-5" />
                                </svg>
                                <span class="sr-only">@L["HouseBuy_Viable"]</span>
                            }
                            else
                            {
                                <svg class="icon-svg icon-svg-lg"
                                     width="22"
                                     height="22"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="3"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M18 6L6 18" />
                                    <path d="M6 6l12 12" />
                                </svg>
                                <span class="sr-only">@L["HouseBuy_NotViable"]</span>
                            }
                        </span>

                        <div>
                            <h2>@L["HouseBuy_SummaryAndRuleChecks"]</h2>
                            <p>@L["HouseBuy_SummaryAndRuleChecksText"]</p>
                        </div>
                    </div>

                    <span class="status-pill @(Result.IsViable ? "status-ok" : "status-fail")">
                        @(Result.IsViable ? L["HouseBuy_Viable"] : L["HouseBuy_NotViable"])
                    </span>
                </div>

                <div class="result-rule-layout">
                    <div class="result-panel">
                        <h3>@L["HouseBuy_Summary"]</h3>

                        <div class="summary-table">
                            <div class="summary-table-row">
                                <span>@L["HouseBuy_TotalPrice"]</span>
                                <strong>@Money(Result.TotalPrice)</strong>
                            </div>

                            <div class="summary-table-row">
                                <span>@L["HouseBuy_Mortgage"]</span>
                                <strong>@Money(DesiredMortgage)</strong>
                            </div>

                            <div class="summary-table-row">
                                <span>@L["HouseBuy_LoanToValue"]</span>
                                <strong>@Percent(Result.LoanToValuePercent)</strong>
                            </div>

                            <div class="summary-table-row">
                                <span>@L["HouseBuy_CashEquity"]</span>
                                <strong>@Money(Result.CashEquity)</strong>
                            </div>

                            <div class="summary-table-row">
                                <span>@L["HouseBuy_Pillar2BvgEquity"]</span>
                                <strong>@Money(Result.Pillar2Equity)</strong>
                            </div>

                            <div class="summary-table-row summary-table-total">
                                <span>@L["HouseBuy_TotalEquity"]</span>
                                <strong>@Money(Result.TotalEquity)</strong>
                            </div>

                            <div class="summary-table-row">
                                <span>@L["HouseBuy_GrossIncomeYear"]</span>
                                <strong>@Money(Result.GrossAnnualIncome)</strong>
                            </div>

                            <div class="summary-table-row">
                                <span>@L["HouseBuy_MaxAllowedYearlyCost"]</span>
                                <strong>@Money(Result.MaxAllowedYearlyCost)</strong>
                            </div>

                            <div class="summary-table-row">
                                <span>@L["HouseBuy_TheoreticalYearlyCost"]</span>
                                <strong>@Money(Result.TheoreticalYearlyCost)</strong>
                            </div>

                            <div class="summary-table-row">
                                <span>@L["HouseBuy_TheoreticalMonthlyCost"]</span>
                                <strong>@Money(Result.TheoreticalYearlyCost / 12m)</strong>
                            </div>

                            <div class="summary-table-row summary-table-total">
                                <span>@L["HouseBuy_AffordabilityRatio"]</span>
                                <strong>@AffordabilityRatioText(Result.AffordabilityRatio)</strong>
                            </div>
                        </div>

                        @if (!Result.IsAffordable)
                        {
                            <div class="warning-box">
                                <strong>@L["HouseBuy_RequiredIncomeForAffordabilityTarget"]</strong>
                                <div>@Text("HouseBuy_PerYearAmount", Money(Result.RequiredGrossAnnualIncomeForAffordability))</div>
                                <div>@Text("HouseBuy_MissingIncomePerYear", Money(Result.MissingGrossAnnualIncomeForAffordability))</div>
                            </div>
                        }
                    </div>

                    <div class="rule-panel">
                        <h3>@L["HouseBuy_RuleChecks"]</h3>

                        <div class="checklist">
                            @foreach (var check in Result.Checks)
                            {
                                <div class="checklist-item @(check.Passed ? "checklist-ok" : "checklist-fail")">
                                    <div class="checklist-icon">
                                        @if (check.Passed)
                                        {
                                            <svg class="icon-svg"
                                                 width="20"
                                                 height="20"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="3"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <path d="M20 6L9 17l-5-5" />
                                            </svg>
                                            <span class="sr-only">@L["HouseBuy_Passed"]</span>
                                        }
                                        else
                                        {
                                            <svg class="icon-svg"
                                                 width="20"
                                                 height="20"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="3"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <path d="M18 6L6 18" />
                                                <path d="M6 6l12 12" />
                                            </svg>
                                            <span class="sr-only">@L["HouseBuy_Failed"]</span>
                                        }
                                    </div>

                                    <div class="checklist-content">
                                        <div class="checklist-title-row">
                                            <strong>@RuleTitle(check.Code)</strong>

                                            <span class="mini-pill @(check.Passed ? "mini-ok" : "mini-fail")">
                                                @(check.Passed ? L["HouseBuy_Ok"] : L["HouseBuy_Failed"])
                                            </span>
                                        </div>

                                        <div class="checklist-description">
                                            @RuleDescription(check.Code, check.Description)
                                        </div>

                                        <div class="checklist-values">
                                            <div>
                                                <span>@L["HouseBuy_Actual"]</span>
                                                <strong>@Money(check.ActualValue)</strong>
                                            </div>

                                            <div>
                                                <span>@L["HouseBuy_Limit"]</span>
                                                <strong>@Money(check.RequiredValue)</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>
}

@code {
    private static readonly CultureInfo SwissCulture = CultureInfo.GetCultureInfo("de-CH");
    private readonly HouseBuyScenarioManager _scenarioManager = new();

    private Guid CurrentScenarioId { get; set; } = Guid.NewGuid();

    private string ScenarioName { get; set; } = "House buy scenario";

    private decimal SalePrice { get; set; } = 920_000m;
    private decimal SaleRemainingMortgage { get; set; } = 720_000m;
    private decimal SaleCosts { get; set; } = 0m;
    private decimal SalePillar2BoundAmount { get; set; } = 74_000m;

    private decimal BuyPrice { get; set; } = 1_000_000m;
    private decimal RenovationPrice { get; set; } = 0m;
    private decimal DesiredMortgage { get; set; } = 800_000m;

    private decimal ImputedInterestPercent { get; set; } = 5m;
    private decimal MaintenancePercent { get; set; } = 1m;
    private decimal MaxAffordabilityPercent { get; set; } = 33m;
    private decimal FirstMortgageThresholdPercent { get; set; } = 66m;
    private int AmortisationYears { get; set; } = 15;

    private decimal AmortisationYearsDecimal
    {
        get => AmortisationYears;
        set => AmortisationYears = Math.Max(1, (int)Math.Round(value, 0));
    }

    private List<PersonUiModel> Persons { get; set; } =
    [
        new()
        {
            Id = Guid.NewGuid(),
            Name = "Person 1",
            GrossAnnualIncome = 200_000m
        }
    ];

    private List<EquitySourceUiModel> EquitySources { get; set; } =
    [
        new()
        {
            Id = Guid.NewGuid(),
            Name = "Cash equity",
            Type = EquitySourceType.Cash,
            Amount = 150_000m
        },
        new()
        {
            Id = Guid.NewGuid(),
            Name = "Pillar 2 BVG",
            Type = EquitySourceType.Pillar2Bvg,
            Amount = 50_000m
        }
    ];

    private IReadOnlyList<HouseBuySimulatorScenario> SavedScenarios =>
        AppState.CurrentPlan?.HouseBuyScenarios
            .OrderBy(x => x.Name)
            .ToList()
        ?? new List<HouseBuySimulatorScenario>();

    private bool CurrentScenarioExists =>
        AppState.CurrentPlan?.HouseBuyScenarios.Any(x => x.Id == CurrentScenarioId) == true;

    private decimal TotalPrice => BuyPrice + RenovationPrice;

    private decimal TotalGrossIncome => Persons.Sum(x => x.GrossAnnualIncome);

    private decimal CashEquity => EquitySources
        .Where(x => x.Type == EquitySourceType.Cash)
        .Sum(x => x.Amount);

    private decimal Pillar2Equity => EquitySources
        .Where(x => x.Type == EquitySourceType.Pillar2Bvg)
        .Sum(x => x.Amount);

    private decimal TotalEquity => CashEquity + Pillar2Equity;

    private SwissMortgageRuleSettings Rules => new()
    {
        ImputedInterestPercent = ImputedInterestPercent,
        MaintenancePercent = MaintenancePercent,
        MaxAffordabilityPercent = MaxAffordabilityPercent,
        FirstMortgageThresholdPercent = FirstMortgageThresholdPercent,
        AmortisationYears = AmortisationYears
    };

    private HouseSaleResult? SaleResult
    {
        get
        {
            try
            {
                return new HouseSaleCalculator().Calculate(new HouseSaleScenario
                {
                    ExpectedSalePrice = SalePrice,
                    RemainingMortgagePrincipal = SaleRemainingMortgage,
                    SellingCosts = SaleCosts,
                    Pillar2BvgBoundAmount = SalePillar2BoundAmount
                });
            }
            catch
            {
                return null;
            }
        }
    }

    private HousePurchaseResult? Result
    {
        get
        {
            if (BuyPrice <= 0)
            {
                return null;
            }

            try
            {
                var scenario = new HousePurchaseScenario
                {
                    BuyPrice = BuyPrice,
                    RenovationPrice = RenovationPrice,
                    DesiredMortgage = DesiredMortgage,
                    Rules = Rules,
                    EquitySources = EquitySources
                        .Select(x => new EquitySource
                        {
                            Name = x.Name,
                            Type = x.Type,
                            Amount = x.Amount,
                            PersonId = x.PersonId,
                            Origin = x.Origin
                        })
                        .ToList(),
                    Incomes = Persons
                        .Select(x => new PersonIncome
                        {
                            PersonId = x.Id,
                            Name = x.Name,
                            GrossAnnualIncome = x.GrossAnnualIncome
                        })
                        .ToList()
                };

                return new SwissMortgageAffordabilityCalculator().Calculate(scenario);
            }
            catch
            {
                return null;
            }
        }
    }

    protected override void OnInitialized()
    {
        var scenario = AppState.CurrentPlan?.HouseBuyScenarios
            .OrderBy(x => x.Name)
            .FirstOrDefault();

        if (scenario is not null)
        {
            LoadScenarioIntoUi(scenario);
            return;
        }

        LoadScenarioIntoUi(
            HouseBuySimulatorScenario.CreateDefault(Text("HouseBuy_DefaultScenarioName")));
    }

    private void SaveScenario()
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            return;
        }

        var scenarioToSave = ToScenario();

        var updatedScenarios = _scenarioManager
            .AddOrUpdate(plan.HouseBuyScenarios, scenarioToSave)
            .ToList();

        ReplaceHouseBuyScenariosAndSelect(
            updatedScenarios,
            scenarioToSave.Id);
    }

    private void LoadSavedScenario()
    {
        var scenario = AppState.CurrentPlan?.HouseBuyScenarios
            .OrderBy(x => x.Name)
            .FirstOrDefault();

        if (scenario is null)
        {
            return;
        }

        LoadScenarioIntoUi(scenario);
    }

    private void CreateNewScenario()
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            LoadScenarioIntoUi(
                HouseBuySimulatorScenario.CreateDefault(Text("HouseBuy_DefaultScenarioName")));

            return;
        }

        var newScenario = _scenarioManager.CreateDefault(plan.HouseBuyScenarios);

        var updatedScenarios = _scenarioManager
            .AddOrUpdate(plan.HouseBuyScenarios, newScenario)
            .ToList();

        ReplaceHouseBuyScenariosAndSelect(
            updatedScenarios,
            newScenario.Id);
    }

    private void DuplicateScenario()
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            return;
        }

        var currentScenario = ToScenario();

        var savedCurrentScenarios = _scenarioManager
            .AddOrUpdate(plan.HouseBuyScenarios, currentScenario)
            .ToList();

        var duplicateResult = _scenarioManager.Duplicate(
            savedCurrentScenarios,
            currentScenario.Id);

        ReplaceHouseBuyScenariosAndSelect(
            duplicateResult.Scenarios.ToList(),
            duplicateResult.Scenario.Id);
    }

    private void DeleteScenario()
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            return;
        }

        if (!CurrentScenarioExists)
        {
            return;
        }

        var updatedScenarios = _scenarioManager
            .Delete(plan.HouseBuyScenarios, CurrentScenarioId)
            .ToList();

        var nextScenario = updatedScenarios
            .OrderBy(x => x.Name)
            .FirstOrDefault();

        ReplaceHouseBuyScenariosAndSelect(
            updatedScenarios,
            nextScenario?.Id);

        if (nextScenario is null)
        {
            LoadScenarioIntoUi(
                HouseBuySimulatorScenario.CreateDefault(Text("HouseBuy_DefaultScenarioName")));
        }
    }

    private void OnScenarioSelected(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();

        if (!Guid.TryParse(value, out var scenarioId))
        {
            return;
        }

        var scenario = AppState.CurrentPlan?.HouseBuyScenarios
            .SingleOrDefault(x => x.Id == scenarioId);

        if (scenario is null)
        {
            return;
        }

        LoadScenarioIntoUi(scenario);
    }

    private void ReplaceHouseBuyScenariosAndSelect(
    List<HouseBuySimulatorScenario> scenarios,
    Guid? scenarioIdToSelect)
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            return;
        }

        AppState.SetPlan(new CashFlowPlan
        {
            Id = plan.Id,
            Name = plan.Name,
            BaseCurrency = plan.BaseCurrency,
            Persons = plan.Persons,
            Accounts = plan.Accounts,
            Transactions = plan.Transactions,
            Mortgages = plan.Mortgages,
            CreditCards = plan.CreditCards,
            Pillar3aContracts = plan.Pillar3aContracts,
            HouseBuyScenarios = scenarios,
            SimulationSettings = plan.SimulationSettings
        });

        if (scenarioIdToSelect is null)
        {
            return;
        }

        var selectedScenario = AppState.CurrentPlan?.HouseBuyScenarios
            .SingleOrDefault(x => x.Id == scenarioIdToSelect.Value);

        if (selectedScenario is not null)
        {
            LoadScenarioIntoUi(selectedScenario);
        }
    }

    private static string GetScenarioIdString(Guid scenarioId)
    {
        return scenarioId == Guid.Empty
            ? string.Empty
            : scenarioId.ToString();
    }

    private HouseBuySimulatorScenario ToScenario()
    {
        return new HouseBuySimulatorScenario
        {
            Id = CurrentScenarioId,
            Name = ScenarioName,
            SalePrice = SalePrice,
            SaleRemainingMortgage = SaleRemainingMortgage,
            SaleCosts = SaleCosts,
            SalePillar2BoundAmount = SalePillar2BoundAmount,
            BuyPrice = BuyPrice,
            RenovationPrice = RenovationPrice,
            DesiredMortgage = DesiredMortgage,
            Persons = Persons
                .Select(x => new HouseBuyScenarioPerson
                {
                    Id = x.Id,
                    Name = x.Name,
                    GrossAnnualIncome = x.GrossAnnualIncome
                })
                .ToList(),
            EquitySources = EquitySources
                .Select(x => new HouseBuyScenarioEquitySource
                {
                    Id = x.Id,
                    Name = x.Name,
                    PersonId = x.PersonId,
                    Type = x.Type,
                    Amount = x.Amount,
                    Origin = x.Origin
                })
                .ToList(),
            Rules = Rules
        };
    }

    private void LoadScenarioIntoUi(HouseBuySimulatorScenario scenario)
    {
        CurrentScenarioId = scenario.Id;
        ScenarioName = scenario.Name;

        SalePrice = scenario.SalePrice;
        SaleRemainingMortgage = scenario.SaleRemainingMortgage;
        SaleCosts = scenario.SaleCosts;
        SalePillar2BoundAmount = scenario.SalePillar2BoundAmount;

        BuyPrice = scenario.BuyPrice;
        RenovationPrice = scenario.RenovationPrice;
        DesiredMortgage = scenario.DesiredMortgage;

        ImputedInterestPercent = scenario.Rules.ImputedInterestPercent;
        MaintenancePercent = scenario.Rules.MaintenancePercent;
        MaxAffordabilityPercent = scenario.Rules.MaxAffordabilityPercent;
        FirstMortgageThresholdPercent = scenario.Rules.FirstMortgageThresholdPercent;
        AmortisationYears = scenario.Rules.AmortisationYears;

        Persons = scenario.Persons
            .Select(x => new PersonUiModel
            {
                Id = x.Id,
                Name = x.Name,
                GrossAnnualIncome = x.GrossAnnualIncome
            })
            .ToList();

        EquitySources = scenario.EquitySources
            .Select(x => new EquitySourceUiModel
            {
                Id = x.Id,
                Name = x.Name,
                PersonId = x.PersonId,
                Type = x.Type,
                Amount = x.Amount,
                Origin = x.Origin
            })
            .ToList();

        if (Persons.Count == 0)
        {
            AddPerson();
        }

        if (EquitySources.Count == 0)
        {
            AddEquitySource();
        }
    }

    private void UseSaleProceedsAsEquity()
    {
        if (SaleResult is null)
        {
            return;
        }

        EquitySources.RemoveAll(x => x.Origin is EquitySourceOrigin.SaleFreeCash or EquitySourceOrigin.SalePillar2);

        if (SaleResult.FreeCashAmount > 0)
        {
            EquitySources.Add(new EquitySourceUiModel
            {
                Id = Guid.NewGuid(),
                Name = Text("HouseBuy_SaleProceedsFreeCash"),
                Type = EquitySourceType.Cash,
                Amount = SaleResult.FreeCashAmount,
                Origin = EquitySourceOrigin.SaleFreeCash
            });
        }

        if (SaleResult.Pillar2BoundAmount > 0)
        {
            EquitySources.Add(new EquitySourceUiModel
            {
                Id = Guid.NewGuid(),
                Name = Text("HouseBuy_SaleProceedsPillar2Bvg"),
                Type = EquitySourceType.Pillar2Bvg,
                Amount = SaleResult.Pillar2BoundAmount,
                Origin = EquitySourceOrigin.SalePillar2
            });
        }

        SetMortgageFromEquity();
    }

    private void SetMortgageToMaximum80Percent()
    {
        DesiredMortgage = TotalPrice * Rules.MaxLoanToValuePercent / 100m;
    }

    private void SetMortgageFromEquity()
    {
        var impliedMortgage = Math.Max(0m, TotalPrice - TotalEquity);
        var maxMortgage = TotalPrice * Rules.MaxLoanToValuePercent / 100m;
        DesiredMortgage = Math.Min(impliedMortgage, maxMortgage);
    }

    private void AddPerson()
    {
        Persons.Add(new PersonUiModel
        {
            Id = Guid.NewGuid(),
            Name = Text("HouseBuy_DefaultPersonName", Persons.Count + 1),
            GrossAnnualIncome = 0m
        });
    }

    private void RemovePerson(Guid personId)
    {
        if (Persons.Count <= 1)
        {
            return;
        }

        Persons.RemoveAll(x => x.Id == personId);

        foreach (var equity in EquitySources.Where(x => x.PersonId == personId))
        {
            equity.PersonId = null;
        }
    }

    private void AddEquitySource()
    {
        EquitySources.Add(new EquitySourceUiModel
        {
            Id = Guid.NewGuid(),
            Name = Text("HouseBuy_DefaultEquityName", EquitySources.Count + 1),
            Type = EquitySourceType.Cash,
            Amount = 0m
        });
    }

    private void RemoveEquitySource(Guid equitySourceId)
    {
        if (EquitySources.Count <= 1)
        {
            return;
        }

        EquitySources.RemoveAll(x => x.Id == equitySourceId);
    }

    private static string GetPersonIdString(Guid? personId)
    {
        return personId?.ToString() ?? string.Empty;
    }

    private void SetEquityPerson(Guid equityId, string? value)
    {
        var equity = EquitySources.SingleOrDefault(x => x.Id == equityId);
        if (equity is null)
        {
            return;
        }

        equity.PersonId = Guid.TryParse(value, out var personId) ? personId : null;
    }

    private void SetEquityType(Guid equityId, string? value)
    {
        var equity = EquitySources.SingleOrDefault(x => x.Id == equityId);
        if (equity is null)
        {
            return;
        }

        if (Enum.TryParse<EquitySourceType>(value, out var type))
        {
            equity.Type = type;
        }
    }

    private string RuleTitle(string code)
    {
        return code switch
        {
            "EQUITY_TOTAL_MIN" => Text("HouseBuy_RuleTitleMinimumTotalEquity"),
            "EQUITY_HARD_MIN" => Text("HouseBuy_RuleTitleMinimumHardEquity"),
            "EQUITY_PILLAR2_MAX" => Text("HouseBuy_RuleTitleMaximumPillar2Bvg"),
            "MORTGAGE_LTV_MAX" => Text("HouseBuy_RuleTitleMaximumMortgage"),
            "AFFORDABILITY_MAX" => Text("HouseBuy_RuleTitleAffordability"),
            _ => code
        };
    }

    private string RuleDescription(string code, string fallback)
    {
        return code switch
        {
            "EQUITY_TOTAL_MIN" => Text("HouseBuy_RuleDescriptionMinimumTotalEquity"),
            "EQUITY_HARD_MIN" => Text("HouseBuy_RuleDescriptionMinimumHardEquity"),
            "EQUITY_PILLAR2_MAX" => Text("HouseBuy_RuleDescriptionMaximumPillar2Bvg"),
            "MORTGAGE_LTV_MAX" => Text("HouseBuy_RuleDescriptionMaximumMortgage"),
            "AFFORDABILITY_MAX" => Text("HouseBuy_RuleDescriptionAffordability"),
            _ => fallback
        };
    }

    private static string Money(decimal value)
    {
        return $"CHF {value.ToString("N0", SwissCulture)}";
    }

    private static string Percent(decimal value)
    {
        return $"{value.ToString("N2", SwissCulture)}%";
    }

    private string AffordabilityRatioText(decimal ratio)
    {
        if (ratio == decimal.MaxValue)
        {
            return Text("NotApplicable");
        }

        return Percent(ratio * 100m);
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private sealed class PersonUiModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public decimal GrossAnnualIncome { get; set; }
    }

    private sealed class EquitySourceUiModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public Guid? PersonId { get; set; }
        public EquitySourceType Type { get; set; }
        public decimal Amount { get; set; }
        public EquitySourceOrigin Origin { get; set; } = EquitySourceOrigin.Manual;
    }
