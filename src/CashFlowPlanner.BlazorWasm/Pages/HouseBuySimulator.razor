            "EQUITY_HARD_MIN" => Text("HouseBuy_RuleTitleMinimumHardEquity"),
            "EQUITY_PILLAR2_MAX" => Text("HouseBuy_RuleTitleMaximumPillar2Bvg"),
            "MORTGAGE_LTV_MAX" => Text("HouseBuy_RuleTitleMaximumMortgage"),
            "AFFORDABILITY_MAX" => Text("HouseBuy_RuleTitleAffordability"),
            _ => code
        };
    }

    private string RuleDescription(string code, string fallback)
    {
        return code switch
        {
            "EQUITY_TOTAL_MIN" => Text("HouseBuy_RuleDescriptionMinimumTotalEquity"),
            "EQUITY_HARD_MIN" => Text("HouseBuy_RuleDescriptionMinimumHardEquity"),
            "EQUITY_PILLAR2_MAX" => Text("HouseBuy_RuleDescriptionMaximumPillar2Bvg"),
            "MORTGAGE_LTV_MAX" => Text("HouseBuy_RuleDescriptionMaximumMortgage"),
            "AFFORDABILITY_MAX" => Text("HouseBuy_RuleDescriptionAffordability"),
            _ => fallback
        };
    }

    /// <summary>
    /// A whole-franc amount with its currency, e.g. <c>CHF 12'346</c>.
    ///
    /// The number comes from <see cref="AppFormatter"/> so it follows the region the user picked
    /// in Settings. The page used to format it itself and, alone in the app, ignored that
    /// preference - setting the region to en-US left this one page speaking Swiss German.
    /// </summary>
    private string Money(decimal value)
    {
        return $"{Currency} {Formatter.MoneyRounded(value)}";
    }

    /// <summary>
    /// <see cref="SwissMortgageAffordabilityCalculator"/> signals "no income to divide by" with
    /// <see cref="decimal.MaxValue"/> and passes that sentinel into three result fields:
    /// <c>AffordabilityRatio</c>, <c>RequiredGrossAnnualIncomeForAffordability</c> and, through it,
    /// <c>MissingGrossAnnualIncomeForAffordability</c>. Rendered as money that is a 29-digit
    /// number in the middle of a mortgage summary. The calculator is Core and stays as it is; the
    /// sentinel is caught here, on every field that can carry it, rather than on one of them.
    /// </summary>
    private string MoneyOrNotApplicable(decimal value)
    {
        return value == decimal.MaxValue ? Text("NotApplicable") : Money(value);
    }

    private string AffordabilityRatioText(decimal ratio)
    {
        if (ratio == decimal.MaxValue)
        {
            return Text("NotApplicable");
        }

        return Formatter.Percent(ratio * 100m);
    }

