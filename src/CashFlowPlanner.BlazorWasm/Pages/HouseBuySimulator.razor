@page "/house-buy-simulator"

@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core.RealEstate
@using CashFlowPlanner.Core
@using CashFlowPlanner.BlazorWasm.Components
@using CashFlowPlanner.BlazorWasm.Services
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject CashFlowAppState AppState
@inject AppFormatter Formatter
@inject IStringLocalizer<SharedResource> L

@*
    Swiss house-buy affordability simulator.

    This page used to carry an 877-line scoped stylesheet: its own colours, its own control
    sizing, its own .btn variants, its own breakpoints at 600/900/1100/1400px. None of it was
    reachable from a child component either - CSS isolation stamps its scope attribute only onto
    elements written here, so every rule aimed at an <InputNumber>'s <input> matched nothing until
    a round of ::deep patched it up. The stylesheet is gone: the page is built from PageScaffold,
    FormField, MoneyInput and DataTable, which need no page-local CSS at all, and everything else
    is a Bootstrap utility reading the tokens in wwwroot/css/tokens.css.
*@

<ConfirmDialog @ref="_confirmDialog" />

<PageScaffold Title="@L["HouseBuy_Title"]"
              Subtitle="@L["HouseBuy_Subtitle"]"
              RequiresPlan="true"
              EmptyStateMessage="@L["HouseBuy_LoadPlanFirst"]">

    @* ---------------------------------------------------------------- Scenarios *@
    <section class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h2 class="h5 mb-1">@L["HouseBuy_Scenarios"]</h2>
                    <p class="text-body-secondary small mb-0">@L["HouseBuy_ScenariosText"]</p>
                </div>

                <span class="badge rounded-pill @StatusPillCssClass(CurrentScenarioExists)">
                    @(CurrentScenarioExists ? L["HouseBuy_Saved"] : L["HouseBuy_Unsaved"])
                </span>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-12 col-xl-4">
                    <FormField Label='@L["HouseBuy_SelectedScenario"]' CssClass="mb-0">
                        <select id="@context.Id"
                                class="form-select"
                                value="@GetScenarioIdString(CurrentScenarioId)"
                                @onchange="OnScenarioSelected">
                            @if (SavedScenarios.Count == 0 || !CurrentScenarioExists)
                            {
                                <option value="">@L["HouseBuy_CurrentUnsavedScenario"]</option>
                            }

                            @foreach (var scenario in SavedScenarios)
                            {
                                <option value="@scenario.Id">@scenario.Name</option>
                            }
                        </select>
                    </FormField>
                </div>

                <div class="col-12 col-xl-4">
                    <FormField Label='@L["HouseBuy_ScenarioName"]' CssClass="mb-0">
                        <InputText id="@context.Id" class="form-control" @bind-Value="ScenarioName" />
                    </FormField>
                </div>

                <div class="col-12 col-xl-4 d-flex flex-wrap gap-2 justify-content-xl-end">
                    <button type="button" class="btn btn-primary" @onclick="SaveScenario">
                        @L["Save"]
                    </button>

                    <button type="button" class="btn btn-outline-secondary" @onclick="CreateNewScenario">
                        @L["New"]
                    </button>

                    <button type="button" class="btn btn-outline-secondary" @onclick="DuplicateScenario">
                        @L["Duplicate"]
                    </button>

                    <button type="button"
                            class="btn btn-outline-danger"
                            disabled="@(!CurrentScenarioExists)"
                            @onclick="DeleteScenarioAsync">
                        @L["Delete"]
                    </button>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-3">

        @* ------------------------------------------------ Sale of the current property *@
        <div class="col-12 col-lg-6 col-xxl-4">
            <section class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">@L["HouseBuy_CurrentRealEstateSale"]</h2>

                    <FormField Label='@L["HouseBuy_ExpectedSalePrice"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="0"
                                    Prefix="@Currency"
                                    @bind-Value="SalePrice" />
                    </FormField>

                    <FormField Label='@L["HouseBuy_RemainingMortgagePrincipal"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="0"
                                    Prefix="@Currency"
                                    @bind-Value="SaleRemainingMortgage" />
                    </FormField>

                    <FormField Label='@L["HouseBuy_SellingCosts"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="0"
                                    Prefix="@Currency"
                                    @bind-Value="SaleCosts" />
                    </FormField>

                    <FormField Label='@L["HouseBuy_Pillar2BoundAmount"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="0"
                                    Prefix="@Currency"
                                    @bind-Value="SalePillar2BoundAmount" />
                    </FormField>

                    @if (SaleResult is not null)
                    {
                        <ul class="list-group list-group-flush border-top mb-0">
                            @ValueRow(L["HouseBuy_NetProceeds"], Money(SaleResult.NetProceeds), itemCssClass: FlushItem)
                            @ValueRow(L["HouseBuy_FreeCash"], Money(SaleResult.FreeCashAmount), itemCssClass: FlushItem)
                            @ValueRow(L["HouseBuy_PurposeBoundPillar2"], Money(SaleResult.Pillar2BoundAmount), itemCssClass: FlushItem)
                            @ValueRow(L["HouseBuy_TotalUsableForNextPurchase"], Money(SaleResult.TotalAvailable), emphasis: true, itemCssClass: FlushItem)
                        </ul>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="button" class="btn btn-outline-secondary" @onclick="UseSaleProceedsAsEquity">
                                @L["HouseBuy_UseSaleProceedsAsEquity"]
                            </button>
                        </div>
                    }
                </div>
            </section>
        </div>

        @* ------------------------------------------------------------ New property *@
        <div class="col-12 col-lg-6 col-xxl-4">
            <section class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">@L["HouseBuy_NewRealEstate"]</h2>

                    <FormField Label='@L["HouseBuy_BuyPrice"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="0"
                                    Prefix="@Currency"
                                    @bind-Value="BuyPrice" />
                    </FormField>

                    <FormField Label='@L["HouseBuy_RenovationPrice"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="0"
                                    Prefix="@Currency"
                                    @bind-Value="RenovationPrice" />
                    </FormField>

                    <FormField Label='@L["HouseBuy_DesiredMortgage"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="0"
                                    Prefix="@Currency"
                                    @bind-Value="DesiredMortgage" />
                    </FormField>

                    <ul class="list-group list-group-flush border-top mb-0">
                        @ValueRow(L["HouseBuy_TotalFinancingBasis"], Money(TotalPrice), emphasis: true, itemCssClass: FlushItem)
                    </ul>

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button type="button" class="btn btn-outline-secondary" @onclick="SetMortgageToMaximum80Percent">
                            @L["HouseBuy_SetMortgageToMax80"]
                        </button>

                        <button type="button" class="btn btn-outline-secondary" @onclick="SetMortgageFromEquity">
                            @L["HouseBuy_SetMortgageFromCurrentEquity"]
                        </button>
                    </div>
                </div>
            </section>
        </div>

        @* ------------------------------------------------------- Persons and income *@
        <div class="col-12 col-lg-6 col-xxl-4">
            <section class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">@L["HouseBuy_PersonsAndIncome"]</h2>
                    <p class="text-body-secondary small">@L["HouseBuy_PersonsAndIncomeText"]</p>

                    <DataTable Items="Persons" RowKey="@(person => person.Id)">
                        <Column Title='@L["Name"]'>
                            <ChildContent Context="person">
                                <InputText class="form-control form-control-sm"
                                           aria-label='@L["Name"]'
                                           @bind-Value="person.Name" />
                            </ChildContent>
                        </Column>

                        <Column Title='@L["HouseBuy_GrossSalaryYear"]' Align="ColumnAlign.Number">
                            <ChildContent Context="person">
                                <MoneyInput Decimals="0"
                                            CssClass="form-control form-control-sm num"
                                            AdditionalAttributes="@AriaLabel(L["HouseBuy_GrossSalaryYear"])"
                                            @bind-Value="person.GrossAnnualIncome" />
                            </ChildContent>
                        </Column>

                        <Column>
                            <HeaderContent>
                                <span class="visually-hidden">@L["Actions"]</span>
                            </HeaderContent>
                            <ChildContent Context="person">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger text-nowrap"
                                        @onclick="() => RemovePerson(person.Id)">
                                    @L["Remove"]
                                </button>
                            </ChildContent>
                        </Column>
                    </DataTable>

                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="AddPerson">
                            @L["HouseBuy_AddPerson"]
                        </button>
                    </div>

                    <ul class="list-group list-group-flush border-top mt-3 mb-0">
                        @ValueRow(L["HouseBuy_TotalGrossIncomeYear"], Money(TotalGrossIncome), itemCssClass: FlushItem)
                        @ValueRow(L["HouseBuy_MaxYearlyHousingCost"], Money(TotalGrossIncome * Rules.MaxAffordabilityPercent / 100m), itemCssClass: FlushItem)
                        @ValueRow(L["HouseBuy_MaxMonthlyHousingCost"], Money(TotalGrossIncome * Rules.MaxAffordabilityPercent / 100m / 12m), itemCssClass: FlushItem)
                    </ul>
                </div>
            </section>
        </div>

        @* ----------------------------------------------------------- Equity sources *@
        <div class="col-12 col-xxl-8">
            <section class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1">@L["HouseBuy_EquitySources"]</h2>
                    <p class="text-body-secondary small">@L["HouseBuy_EquitySourcesText"]</p>

                    <DataTable Items="EquitySources" RowKey="@(equity => equity.Id)">
                        <Column Title='@L["Name"]'>
                            <ChildContent Context="equity">
                                <InputText class="form-control form-control-sm"
                                           aria-label='@L["Name"]'
                                           @bind-Value="equity.Name" />
                            </ChildContent>
                        </Column>

                        <Column Title='@L["HouseBuy_Person"]'>
                            <ChildContent Context="equity">
                                <select class="form-select form-select-sm"
                                        aria-label='@L["HouseBuy_Person"]'
                                        value="@GetPersonIdString(equity.PersonId)"
                                        @onchange="e => SetEquityPerson(equity.Id, e.Value?.ToString())">
                                    <option value="">@L["HouseBuy_HouseholdUnassigned"]</option>
                                    @foreach (var person in Persons)
                                    {
                                        <option value="@person.Id">@person.Name</option>
                                    }
                                </select>
                            </ChildContent>
                        </Column>

                        <Column Title='@L["Type"]'>
                            <ChildContent Context="equity">
                                <select class="form-select form-select-sm"
                                        aria-label='@L["Type"]'
                                        value="@equity.Type.ToString()"
                                        @onchange="e => SetEquityType(equity.Id, e.Value?.ToString())">
                                    <option value="@EquitySourceType.Cash">@L["HouseBuy_Cash"]</option>
                                    <option value="@EquitySourceType.Pillar2Bvg">@L["HouseBuy_Pillar2Bvg"]</option>
                                </select>
                            </ChildContent>
                        </Column>

                        <Column Title='@L["Amount"]' Align="ColumnAlign.Number">
                            <ChildContent Context="equity">
                                <MoneyInput Decimals="0"
                                            CssClass="form-control form-control-sm num"
                                            AdditionalAttributes="@AriaLabel(L["Amount"])"
                                            @bind-Value="equity.Amount" />
                            </ChildContent>
                        </Column>

                        <Column>
                            <HeaderContent>
                                <span class="visually-hidden">@L["Actions"]</span>
                            </HeaderContent>
                            <ChildContent Context="equity">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger text-nowrap"
                                        @onclick="() => RemoveEquitySource(equity.Id)">
                                    @L["Remove"]
                                </button>
                            </ChildContent>
                        </Column>
                    </DataTable>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-lg-6">
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-outline-secondary" @onclick="AddEquitySource">
                                    @L["HouseBuy_AddEquitySource"]
                                </button>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <ul class="list-group list-group-flush border-top mb-0">
                                @ValueRow(L["HouseBuy_CashEquity"], Money(CashEquity), itemCssClass: FlushItem)
                                @ValueRow(L["HouseBuy_Pillar2BvgEquity"], Money(Pillar2Equity), itemCssClass: FlushItem)
                                @ValueRow(L["HouseBuy_TotalEquity"], Money(TotalEquity), emphasis: true, itemCssClass: FlushItem)
                                @ValueRow(L["HouseBuy_RequiredTotalEquity"], Money(TotalPrice * Rules.MinTotalEquityPercent / 100m), itemCssClass: FlushItem)
                                @ValueRow(L["HouseBuy_RequiredHardEquity"], Money(TotalPrice * Rules.MinHardEquityPercent / 100m), itemCssClass: FlushItem)
                                @ValueRow(L["HouseBuy_MaxPillar2Bvg"], Money(TotalPrice * Rules.MaxPillar2Percent / 100m), itemCssClass: FlushItem)
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        @* -------------------------------------------------------- Bank assumptions *@
        <div class="col-12 col-lg-6 col-xxl-4">
            <section class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">@L["HouseBuy_BankAssumptions"]</h2>

                    <FormField Label='@L["HouseBuy_ImputedInterestRatePercent"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="2"
                                    Suffix="%"
                                    @bind-Value="ImputedInterestPercent" />
                    </FormField>

                    <FormField Label='@L["HouseBuy_MaintenancePercent"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="2"
                                    Suffix="%"
                                    @bind-Value="MaintenancePercent" />
                    </FormField>

                    <FormField Label='@L["HouseBuy_AffordabilityLimitPercent"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="2"
                                    Suffix="%"
                                    @bind-Value="MaxAffordabilityPercent" />
                    </FormField>

                    <FormField Label='@L["HouseBuy_FirstMortgageThresholdPercent"]'>
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="2"
                                    Suffix="%"
                                    @bind-Value="FirstMortgageThresholdPercent" />
                    </FormField>

                    <FormField Label='@L["HouseBuy_AmortisationYears"]' CssClass="mb-0">
                        <MoneyInput Id="@context.Id"
                                    AriaDescribedBy="@context.DescribedBy"
                                    Decimals="0"
                                    @bind-Value="AmortisationYearsDecimal" />
                    </FormField>
                </div>
            </section>
        </div>

        @* --------------------------------------------------- Summary and rule checks *@
        @if (Result is not null)
        {
            <div class="col-12">
                <section class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                            <div class="d-flex align-items-start gap-3">
                                <span class="badge rounded-pill d-inline-flex align-items-center p-2 flex-shrink-0 @(Result.IsViable ? "text-bg-success" : "text-bg-danger")">
                                    @(Result.IsViable ? CheckIcon : CrossIcon)
                                    <span class="visually-hidden">
                                        @(Result.IsViable ? L["HouseBuy_Viable"] : L["HouseBuy_NotViable"])
                                    </span>
                                </span>

                                <div>
                                    <h2 class="h5 mb-1">@L["HouseBuy_SummaryAndRuleChecks"]</h2>
                                    <p class="text-body-secondary small mb-0">@L["HouseBuy_SummaryAndRuleChecksText"]</p>
                                </div>
                            </div>

                            <span class="badge rounded-pill @StatusPillCssClass(Result.IsViable)">
                                @(Result.IsViable ? L["HouseBuy_Viable"] : L["HouseBuy_NotViable"])
                            </span>
                        </div>

                        <div class="row g-4">
                            <div class="col-12 col-xl-6">
                                <h3 class="h6 mb-3">@L["HouseBuy_Summary"]</h3>

                                <ul class="list-group mb-0">
                                    @ValueRow(L["HouseBuy_TotalPrice"], Money(Result.TotalPrice))
                                    @ValueRow(L["HouseBuy_Mortgage"], Money(DesiredMortgage))
                                    @ValueRow(L["HouseBuy_LoanToValue"], Formatter.Percent(Result.LoanToValuePercent))
                                    @ValueRow(L["HouseBuy_CashEquity"], Money(Result.CashEquity))
                                    @ValueRow(L["HouseBuy_Pillar2BvgEquity"], Money(Result.Pillar2Equity))
                                    @ValueRow(L["HouseBuy_TotalEquity"], Money(Result.TotalEquity), emphasis: true, itemCssClass: TotalItem)
                                    @ValueRow(L["HouseBuy_GrossIncomeYear"], Money(Result.GrossAnnualIncome))
                                    @ValueRow(L["HouseBuy_MaxAllowedYearlyCost"], Money(Result.MaxAllowedYearlyCost))
                                    @ValueRow(L["HouseBuy_TheoreticalYearlyCost"], Money(Result.TheoreticalYearlyCost))
                                    @ValueRow(L["HouseBuy_TheoreticalMonthlyCost"], Money(Result.TheoreticalYearlyCost / 12m))
                                    @ValueRow(L["HouseBuy_AffordabilityRatio"], AffordabilityRatioText(Result.AffordabilityRatio), emphasis: true, itemCssClass: TotalItem)
                                </ul>

                                @if (!Result.IsAffordable)
                                {
                                    <div class="alert alert-warning mt-3 mb-0" role="alert">
                                        <strong>@L["HouseBuy_RequiredIncomeForAffordabilityTarget"]</strong>
                                        <div>@Text("HouseBuy_PerYearAmount", MoneyOrNotApplicable(Result.RequiredGrossAnnualIncomeForAffordability))</div>
                                        <div>@Text("HouseBuy_MissingIncomePerYear", MoneyOrNotApplicable(Result.MissingGrossAnnualIncomeForAffordability))</div>
                                    </div>
                                }
                            </div>

                            <div class="col-12 col-xl-6">
                                <h3 class="h6 mb-3">@L["HouseBuy_RuleChecks"]</h3>

                                <div class="d-flex flex-column gap-2">
                                    @foreach (var check in Result.Checks)
                                    {
                                        <div class="d-flex gap-3 p-3 rounded border @(check.Passed ? "border-success-subtle bg-success-subtle" : "border-danger-subtle bg-danger-subtle")">
                                            <span class="badge rounded-pill d-inline-flex align-items-center align-self-start p-2 flex-shrink-0 @(check.Passed ? "text-bg-success" : "text-bg-danger")">
                                                @(check.Passed ? CheckIcon : CrossIcon)
                                                <span class="visually-hidden">
                                                    @(check.Passed ? L["HouseBuy_Passed"] : L["HouseBuy_Failed"])
                                                </span>
                                            </span>

                                            <div class="flex-grow-1">
                                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                    <strong>@RuleTitle(check.Code)</strong>

                                                    @* Solid rather than subtle: this pill sits on an already-tinted card. *@
                                                    <span class="badge rounded-pill @(check.Passed ? "text-bg-success" : "text-bg-danger")">
                                                        @(check.Passed ? L["HouseBuy_Ok"] : L["HouseBuy_Failed"])
                                                    </span>
                                                </div>

                                                <div class="small text-body-secondary mt-1">
                                                    @RuleDescription(check.Code, check.Description)
                                                </div>

                                                <div class="row g-2 mt-1">
                                                    <div class="col-12 col-sm-6">
                                                        <div class="border rounded bg-body p-2">
                                                            <div class="small fw-bold text-uppercase text-body-secondary">@L["HouseBuy_Actual"]</div>
                                                            <div class="fw-semibold num text-nowrap">@Money(check.ActualValue)</div>
                                                        </div>
                                                    </div>

                                                    <div class="col-12 col-sm-6">
                                                        <div class="border rounded bg-body p-2">
                                                            <div class="small fw-bold text-uppercase text-body-secondary">@L["HouseBuy_Limit"]</div>
                                                            <div class="fw-semibold num text-nowrap">@Money(check.RequiredValue)</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        }
    </div>
</PageScaffold>

@code {
    /// <summary>
    /// The currency shown as an input-group addon on every amount field. The page is Swiss-rules
    /// specific and every figure it produces already said CHF before this rebuild.
    /// </summary>
    private const string Currency = "CHF";

    /// <summary>Classes for a key/value row in a borderless, flush summary list.</summary>
    private const string FlushItem = "px-0 bg-transparent";

    /// <summary>Classes for a highlighted total row inside a bordered summary list.</summary>
    private const string TotalItem = "list-group-item-primary";

    private readonly HouseBuyScenarioManager _scenarioManager = new();

    private ConfirmDialog? _confirmDialog;

    private Guid CurrentScenarioId { get; set; } = Guid.NewGuid();

    private string ScenarioName { get; set; } = "House buy scenario";

    private decimal SalePrice { get; set; } = 920_000m;
    private decimal SaleRemainingMortgage { get; set; } = 720_000m;
    private decimal SaleCosts { get; set; } = 0m;
    private decimal SalePillar2BoundAmount { get; set; } = 74_000m;

    private decimal BuyPrice { get; set; } = 1_000_000m;
    private decimal RenovationPrice { get; set; } = 0m;
    private decimal DesiredMortgage { get; set; } = 800_000m;

    private decimal ImputedInterestPercent { get; set; } = 5m;
    private decimal MaintenancePercent { get; set; } = 1m;
    private decimal MaxAffordabilityPercent { get; set; } = 33m;
    private decimal FirstMortgageThresholdPercent { get; set; } = 66m;
    private int AmortisationYears { get; set; } = 15;

    private decimal AmortisationYearsDecimal
    {
        get => AmortisationYears;
        set => AmortisationYears = Math.Max(1, (int)Math.Round(value, 0));
    }

    private List<PersonUiModel> Persons { get; set; } =
    [
        new()
        {
            Id = Guid.NewGuid(),
            Name = "Person 1",
            GrossAnnualIncome = 200_000m
        }
    ];

    private List<EquitySourceUiModel> EquitySources { get; set; } =
    [
        new()
        {
            Id = Guid.NewGuid(),
            Name = "Cash equity",
            Type = EquitySourceType.Cash,
            Amount = 150_000m
        },
        new()
        {
            Id = Guid.NewGuid(),
            Name = "Pillar 2 BVG",
            Type = EquitySourceType.Pillar2Bvg,
            Amount = 50_000m
        }
    ];

    private IReadOnlyList<HouseBuySimulatorScenario> SavedScenarios =>
        AppState.CurrentPlan?.HouseBuyScenarios
            .OrderBy(x => x.Name)
            .ToList()
        ?? new List<HouseBuySimulatorScenario>();

    private bool CurrentScenarioExists =>
        AppState.CurrentPlan?.HouseBuyScenarios.Any(x => x.Id == CurrentScenarioId) == true;

    private decimal TotalPrice => BuyPrice + RenovationPrice;

    private decimal TotalGrossIncome => Persons.Sum(x => x.GrossAnnualIncome);

    private decimal CashEquity => EquitySources
        .Where(x => x.Type == EquitySourceType.Cash)
        .Sum(x => x.Amount);

    private decimal Pillar2Equity => EquitySources
        .Where(x => x.Type == EquitySourceType.Pillar2Bvg)
        .Sum(x => x.Amount);

    private decimal TotalEquity => CashEquity + Pillar2Equity;

    private SwissMortgageRuleSettings Rules => new()
    {
        ImputedInterestPercent = ImputedInterestPercent,
        MaintenancePercent = MaintenancePercent,
        MaxAffordabilityPercent = MaxAffordabilityPercent,
        FirstMortgageThresholdPercent = FirstMortgageThresholdPercent,
        AmortisationYears = AmortisationYears
    };

    private HouseSaleResult? SaleResult
    {
        get
        {
            try
            {
                return new HouseSaleCalculator().Calculate(new HouseSaleScenario
                {
                    ExpectedSalePrice = SalePrice,
                    RemainingMortgagePrincipal = SaleRemainingMortgage,
                    SellingCosts = SaleCosts,
                    Pillar2BvgBoundAmount = SalePillar2BoundAmount
                });
            }
            catch
            {
                return null;
            }
        }
    }

    private HousePurchaseResult? Result
    {
        get
        {
            if (BuyPrice <= 0)
            {
                return null;
            }

            try
            {
                var scenario = new HousePurchaseScenario
                {
                    BuyPrice = BuyPrice,
                    RenovationPrice = RenovationPrice,
                    DesiredMortgage = DesiredMortgage,
                    Rules = Rules,
                    EquitySources = EquitySources
                        .Select(x => new EquitySource
                        {
                            Name = x.Name,
                            Type = x.Type,
                            Amount = x.Amount,
                            PersonId = x.PersonId,
                            Origin = x.Origin
                        })
                        .ToList(),
                    Incomes = Persons
                        .Select(x => new PersonIncome
                        {
                            PersonId = x.Id,
                            Name = x.Name,
                            GrossAnnualIncome = x.GrossAnnualIncome
                        })
                        .ToList()
                };

                return new SwissMortgageAffordabilityCalculator().Calculate(scenario);
            }
            catch
            {
                return null;
            }
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        var scenario = AppState.CurrentPlan?.HouseBuyScenarios
            .OrderBy(x => x.Name)
            .FirstOrDefault();

        if (scenario is not null)
        {
            LoadScenarioIntoUi(scenario);
            return;
        }

        LoadScenarioIntoUi(
            HouseBuySimulatorScenario.CreateDefault(Text("HouseBuy_DefaultScenarioName")));
    }

    private void SaveScenario()
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            return;
        }

        var scenarioToSave = ToScenario();

        var updatedScenarios = _scenarioManager
            .AddOrUpdate(plan.HouseBuyScenarios, scenarioToSave)
            .ToList();

        ReplaceHouseBuyScenariosAndSelect(
            updatedScenarios,
            scenarioToSave.Id);
    }

    private void CreateNewScenario()
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            LoadScenarioIntoUi(
                HouseBuySimulatorScenario.CreateDefault(Text("HouseBuy_DefaultScenarioName")));

            return;
        }

        var newScenario = _scenarioManager.CreateDefault(plan.HouseBuyScenarios);

        var updatedScenarios = _scenarioManager
            .AddOrUpdate(plan.HouseBuyScenarios, newScenario)
            .ToList();

        ReplaceHouseBuyScenariosAndSelect(
            updatedScenarios,
            newScenario.Id);
    }

    private void DuplicateScenario()
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            return;
        }

        var currentScenario = ToScenario();

        var savedCurrentScenarios = _scenarioManager
            .AddOrUpdate(plan.HouseBuyScenarios, currentScenario)
            .ToList();

        var duplicateResult = _scenarioManager.Duplicate(
            savedCurrentScenarios,
            currentScenario.Id);

        ReplaceHouseBuyScenariosAndSelect(
            duplicateResult.Scenarios.ToList(),
            duplicateResult.Scenario.Id);
    }

    /// <summary>
    /// Deleting a saved scenario used to happen on the first click, with nothing to undo it. It
    /// now goes through <see cref="ConfirmDialog"/> like every other destructive action in the app.
    /// </summary>
    private async Task DeleteScenarioAsync()
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            return;
        }

        if (!CurrentScenarioExists)
        {
            return;
        }

        if (_confirmDialog is null)
        {
            return;
        }

        var confirmed = await _confirmDialog.ShowAsync(
            Text("Delete"),
            Text("Dialog_ConfirmMessage"));

        if (!confirmed)
        {
            return;
        }

        var updatedScenarios = _scenarioManager
            .Delete(plan.HouseBuyScenarios, CurrentScenarioId)
            .ToList();

        var nextScenario = updatedScenarios
            .OrderBy(x => x.Name)
            .FirstOrDefault();

        ReplaceHouseBuyScenariosAndSelect(
            updatedScenarios,
            nextScenario?.Id);

        if (nextScenario is null)
        {
            LoadScenarioIntoUi(
                HouseBuySimulatorScenario.CreateDefault(Text("HouseBuy_DefaultScenarioName")));
        }
    }

    private void OnScenarioSelected(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();

        if (!Guid.TryParse(value, out var scenarioId))
        {
            return;
        }

        var scenario = AppState.CurrentPlan?.HouseBuyScenarios
            .SingleOrDefault(x => x.Id == scenarioId);

        if (scenario is null)
        {
            return;
        }

        LoadScenarioIntoUi(scenario);
    }

    private void ReplaceHouseBuyScenariosAndSelect(
        List<HouseBuySimulatorScenario> scenarios,
        Guid? scenarioIdToSelect)
    {
        var plan = AppState.CurrentPlan;

        if (plan is null)
        {
            return;
        }

        AppState.SetPlan(new CashFlowPlan
        {
            Id = plan.Id,
            Name = plan.Name,
            BaseCurrency = plan.BaseCurrency,
            Persons = plan.Persons,
            Accounts = plan.Accounts,
            Transactions = plan.Transactions,
            Mortgages = plan.Mortgages,
            CreditCards = plan.CreditCards,
            Pillar3aContracts = plan.Pillar3aContracts,
            HouseBuyScenarios = scenarios,
            SimulationSettings = plan.SimulationSettings
        });

        if (scenarioIdToSelect is null)
        {
            return;
        }

        var selectedScenario = AppState.CurrentPlan?.HouseBuyScenarios
            .SingleOrDefault(x => x.Id == scenarioIdToSelect.Value);

        if (selectedScenario is not null)
        {
            LoadScenarioIntoUi(selectedScenario);
        }
    }

    private static string GetScenarioIdString(Guid scenarioId)
    {
        return scenarioId == Guid.Empty
            ? string.Empty
            : scenarioId.ToString();
    }

    private HouseBuySimulatorScenario ToScenario()
    {
        return new HouseBuySimulatorScenario
        {
            Id = CurrentScenarioId,
            Name = ScenarioName,
            SalePrice = SalePrice,
            SaleRemainingMortgage = SaleRemainingMortgage,
            SaleCosts = SaleCosts,
            SalePillar2BoundAmount = SalePillar2BoundAmount,
            BuyPrice = BuyPrice,
            RenovationPrice = RenovationPrice,
            DesiredMortgage = DesiredMortgage,
            Persons = Persons
                .Select(x => new HouseBuyScenarioPerson
                {
                    Id = x.Id,
                    Name = x.Name,
                    GrossAnnualIncome = x.GrossAnnualIncome
                })
                .ToList(),
            EquitySources = EquitySources
                .Select(x => new HouseBuyScenarioEquitySource
                {
                    Id = x.Id,
                    Name = x.Name,
                    PersonId = x.PersonId,
                    Type = x.Type,
                    Amount = x.Amount,
                    Origin = x.Origin
                })
                .ToList(),
            Rules = Rules
        };
    }

    private void LoadScenarioIntoUi(HouseBuySimulatorScenario scenario)
    {
        CurrentScenarioId = scenario.Id;
        ScenarioName = scenario.Name;

        SalePrice = scenario.SalePrice;
        SaleRemainingMortgage = scenario.SaleRemainingMortgage;
        SaleCosts = scenario.SaleCosts;
        SalePillar2BoundAmount = scenario.SalePillar2BoundAmount;

        BuyPrice = scenario.BuyPrice;
        RenovationPrice = scenario.RenovationPrice;
        DesiredMortgage = scenario.DesiredMortgage;

        ImputedInterestPercent = scenario.Rules.ImputedInterestPercent;
        MaintenancePercent = scenario.Rules.MaintenancePercent;
        MaxAffordabilityPercent = scenario.Rules.MaxAffordabilityPercent;
        FirstMortgageThresholdPercent = scenario.Rules.FirstMortgageThresholdPercent;
        AmortisationYears = scenario.Rules.AmortisationYears;

        Persons = scenario.Persons
            .Select(x => new PersonUiModel
            {
                Id = x.Id,
                Name = x.Name,
                GrossAnnualIncome = x.GrossAnnualIncome
            })
            .ToList();

        EquitySources = scenario.EquitySources
            .Select(x => new EquitySourceUiModel
            {
                Id = x.Id,
                Name = x.Name,
                PersonId = x.PersonId,
                Type = x.Type,
                Amount = x.Amount,
                Origin = x.Origin
            })
            .ToList();

        if (Persons.Count == 0)
        {
            AddPerson();
        }

        if (EquitySources.Count == 0)
        {
            AddEquitySource();
        }
    }

    private void UseSaleProceedsAsEquity()
    {
        if (SaleResult is null)
        {
            return;
        }

        EquitySources.RemoveAll(x => x.Origin is EquitySourceOrigin.SaleFreeCash or EquitySourceOrigin.SalePillar2);

        if (SaleResult.FreeCashAmount > 0)
        {
            EquitySources.Add(new EquitySourceUiModel
            {
                Id = Guid.NewGuid(),
                Name = Text("HouseBuy_SaleProceedsFreeCash"),
                Type = EquitySourceType.Cash,
                Amount = SaleResult.FreeCashAmount,
                Origin = EquitySourceOrigin.SaleFreeCash
            });
        }

        if (SaleResult.Pillar2BoundAmount > 0)
        {
            EquitySources.Add(new EquitySourceUiModel
            {
                Id = Guid.NewGuid(),
                Name = Text("HouseBuy_SaleProceedsPillar2Bvg"),
                Type = EquitySourceType.Pillar2Bvg,
                Amount = SaleResult.Pillar2BoundAmount,
                Origin = EquitySourceOrigin.SalePillar2
            });
        }

        SetMortgageFromEquity();
    }

    private void SetMortgageToMaximum80Percent()
    {
        DesiredMortgage = TotalPrice * Rules.MaxLoanToValuePercent / 100m;
    }

    private void SetMortgageFromEquity()
    {
        var impliedMortgage = Math.Max(0m, TotalPrice - TotalEquity);
        var maxMortgage = TotalPrice * Rules.MaxLoanToValuePercent / 100m;
        DesiredMortgage = Math.Min(impliedMortgage, maxMortgage);
    }

    private void AddPerson()
    {
        Persons.Add(new PersonUiModel
        {
            Id = Guid.NewGuid(),
            Name = Text("HouseBuy_DefaultPersonName", Persons.Count + 1),
            GrossAnnualIncome = 0m
        });
    }

    private void RemovePerson(Guid personId)
    {
        if (Persons.Count <= 1)
        {
            return;
        }

        Persons.RemoveAll(x => x.Id == personId);

        foreach (var equity in EquitySources.Where(x => x.PersonId == personId))
        {
            equity.PersonId = null;
        }
    }

    private void AddEquitySource()
    {
        EquitySources.Add(new EquitySourceUiModel
        {
            Id = Guid.NewGuid(),
            Name = Text("HouseBuy_DefaultEquityName", EquitySources.Count + 1),
            Type = EquitySourceType.Cash,
            Amount = 0m
        });
    }

    private void RemoveEquitySource(Guid equitySourceId)
    {
        if (EquitySources.Count <= 1)
        {
            return;
        }

        EquitySources.RemoveAll(x => x.Id == equitySourceId);
    }

    private static string GetPersonIdString(Guid? personId)
    {
        return personId?.ToString() ?? string.Empty;
    }

    private void SetEquityPerson(Guid equityId, string? value)
    {
        var equity = EquitySources.SingleOrDefault(x => x.Id == equityId);
        if (equity is null)
        {
            return;
        }

        equity.PersonId = Guid.TryParse(value, out var personId) ? personId : null;
    }

    private void SetEquityType(Guid equityId, string? value)
    {
        var equity = EquitySources.SingleOrDefault(x => x.Id == equityId);
        if (equity is null)
        {
            return;
        }

        if (Enum.TryParse<EquitySourceType>(value, out var type))
        {
            equity.Type = type;
        }
    }

