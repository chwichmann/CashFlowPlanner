@page "/pillar3a"

@using System.Globalization
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core
@using CashFlowPlanner.Core.Accounts
@using CashFlowPlanner.Core.People
@using CashFlowPlanner.Core.Pillar3a
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject CashFlowAppState AppState
@inject Pillar3aProjectionEngine ProjectionEngine
@inject Pillar3aTaxYearSimulator TaxYearSimulator
@inject EnumLocalizer EnumL
@inject IStringLocalizer<SharedResource> L
@inject AppFormatter Formatter

@* Outside the scaffold: the dialog has to survive the body being replaced by the empty state. *@
<ConfirmDialog @ref="_confirmDialog" />

<PageScaffold Title='@L["Pillar3a_Title"]'
              RequiresPlan="true"
              EmptyStateMessage='@L["Pillar3a_NoPlanLoaded"]'>
    <Actions>
        @if (AppState.CurrentPlan is not null)
        {
            <button class="btn btn-primary" @onclick="NewContract">
                @L["Pillar3a_AddContract"]
            </button>
        }
    </Actions>

    <Notifications>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_infoMessage))
        {
            <div class="alert alert-info" role="alert">@_infoMessage</div>
        }
    </Notifications>

    <ChildContent>
        @{
            // The scaffold only invokes this fragment once a plan is loaded, which is what
            // RequiresPlan is for.
            var plan = AppState.CurrentPlan!;

            var contracts = plan.Pillar3aContracts
                .OrderBy(x => GetPersonName(x.OwnerPersonId))
                .ThenBy(x => x.Name)
                .ToList();

            var projectionResults = ProjectionEngine.Project(
                plan,
                DateOnly.FromDateTime(DateTime.Today));

            var taxYearResult = TaxYearSimulator.Simulate(
                plan,
                _taxYear,
                _annualPillar3aLimit);

            var taxYearRows = BuildTaxYearRows(taxYearResult)
                .OrderBy(x => x.PersonName)
                .ToList();

            var personProjectionRows = BuildPersonProjectionRows(contracts, projectionResults)
                .OrderBy(x => x.PersonName)
                .ToList();

            var yearlyProjectionMatrix = BuildYearlyPersonProjectionMatrixRows(contracts, projectionResults)
                .OrderBy(x => x.Year)
                .ToList();

            var yearlyProjectionPersons = yearlyProjectionMatrix
                .SelectMany(x => x.PersonCells.Keys)
                .Distinct()
                .OrderBy(GetPersonName)
                .ToList();

            var contractRows = BuildContractRows(contracts, projectionResults);
            var contractProjectionRows = BuildContractProjectionRows(contracts, projectionResults);
        }

        @if (_editModel is not null)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <strong>@(_isNewContract ? L["Pillar3a_AddContract"] : L["Pillar3a_EditContract"])</strong>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <FormField Label='@L["Name"]' CssClass="">
                                <input id="@context.Id" class="form-control" @bind="_editModel.Name" />
                            </FormField>
                        </div>

                        <div class="col-md-4">
                            <FormField Label='@L["Owner"]' Hint='@L["Pillar3a_OwnerHint"]' CssClass="">
                                <select id="@context.Id"
                                        aria-describedby="@context.DescribedBy"
                                        class="form-select"
                                        @bind="_editModel.OwnerPersonId">
                                    <option value="">@L["Pillar3a_SelectOwner"]</option>
                                    @foreach (var person in ContractOwnerPersonList.OrderBy(x => x.DisplayName))
                                    {
                                        <option value="@person.Id">@person.DisplayName</option>
                                    }
                                </select>
                            </FormField>
                        </div>

                        <div class="col-md-4">
                            <FormField Label='@L["Type"]' CssClass="">
                                <select id="@context.Id" class="form-select" @bind="_editModel.Type">
                                    @foreach (var type in Enum.GetValues<Pillar3aContractType>())
                                    {
                                        <option value="@type">@EnumL.Translate(type)</option>
                                    }
                                </select>
                            </FormField>
                        </div>

                        <div class="col-md-2">
                            <FormField Label='@L["Currency"]' CssClass="">
                                <input id="@context.Id" class="form-control" @bind="_editModel.Currency" />
                            </FormField>
                        </div>

                        <div class="col-md-4">
                            <FormField Label='@L["Pillar3a_Provider"]' CssClass="">
                                <input id="@context.Id" class="form-control" @bind="_editModel.ProviderName" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Pillar3a_ContractNumberMasked"]' CssClass="">
                                <input id="@context.Id" class="form-control" @bind="_editModel.ContractNumberMasked" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Pillar3a_OpeningValue"]' CssClass="">
                                <MoneyInput Id="@context.Id" @bind-Value="_editModel.OpeningValue" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Pillar3a_OpeningDate"]' CssClass="">
                                <input id="@context.Id" type="date" class="form-control" @bind="_editModel.OpeningDate" />
                            </FormField>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <FormField Label='@L["Active"]' Layout="FormFieldLayout.Checkbox" CssClass="">
                                <input id="@context.Id"
                                       type="checkbox"
                                       class="form-check-input"
                                       @bind="_editModel.IsActive" />
                            </FormField>
                        </div>

                        <div class="col-md-6">
                            <FormField Label='@L["Notes"]' CssClass="">
                                <input id="@context.Id" class="form-control" @bind="_editModel.Notes" />
                            </FormField>
                        </div>
                    </div>

                    <hr />

                    <h6>@L["Pillar3a_ProjectionAssumptions"]</h6>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <FormField Label='@L["Pillar3a_ProjectionMethod"]' CssClass="">
                                <select id="@context.Id" class="form-select" @bind="_editModel.ProjectionMethod">
                                    @foreach (var method in Enum.GetValues<Pillar3aProjectionMethod>())
                                    {
                                        <option value="@method">@EnumL.Translate(method)</option>
                                    }
                                </select>
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Pillar3a_ExpectedAnnualReturnPercent"]' CssClass="">
                                <MoneyInput Id="@context.Id"
                                            Suffix="%"
                                            @bind-Value="_editModel.ExpectedAnnualReturnPercent" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Pillar3a_AnnualFeePercent"]' CssClass="">
                                <MoneyInput Id="@context.Id"
                                            Suffix="%"
                                            @bind-Value="_editModel.AnnualFeePercent" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Pillar3a_ExpectedSurplusPercent"]' CssClass="">
                                <MoneyInput Id="@context.Id"
                                            Suffix="%"
                                            @bind-Value="ExpectedSurplusPercent" />
                            </FormField>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">@L["Pillar3a_ContributionSchedules"]</h6>

                        <button class="btn btn-sm btn-outline-primary" @onclick="AddContributionSchedule">
                            @L["Pillar3a_AddSchedule"]
                        </button>
                    </div>

                    @if (_editModel.ContributionSchedules.Count == 0)
                    {
                        <div class="alert alert-info">
                            @L["Pillar3a_NoContributionSchedulesConfigured"]
                        </div>
                    }
                    else
                    {
                        @foreach (var schedule in _editModel.ContributionSchedules)
                        {
                            <div class="border rounded p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <strong>@L["Pillar3a_ContributionSchedule"]</strong>

                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RemoveContributionSchedule(schedule)">
                                        @L["Remove"]
                                    </button>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <FormField Label='@L["Pillar3a_PaymentAccount"]' CssClass="">
                                            <select id="@context.Id" class="form-select" @bind="schedule.PaymentAccountId">
                                                <option value="">@L["Pillar3a_SelectAccount"]</option>
                                                @foreach (var account in PaymentAccounts.OrderBy(x => x.Name))
                                                {
                                                    <option value="@account.Id">@account.Name</option>
                                                }
                                            </select>
                                        </FormField>
                                    </div>

                                    <div class="col-md-2">
                                        <FormField Label='@L["Amount"]' CssClass="">
                                            <MoneyInput Id="@context.Id" @bind-Value="schedule.Amount" />
                                        </FormField>
                                    </div>

                                    <div class="col-md-2">
                                        <FormField Label='@L["Currency"]' CssClass="">
                                            <input id="@context.Id" class="form-control" @bind="schedule.Currency" />
                                        </FormField>
                                    </div>

                                    <div class="col-md-2">
                                        <FormField Label='@L["Pillar3a_StartDate"]' CssClass="">
                                            <input id="@context.Id" type="date" class="form-control" @bind="schedule.StartDate" />
                                        </FormField>
                                    </div>

                                    <div class="col-md-2">
                                        <FormField Label='@L["Pillar3a_EndDate"]' CssClass="">
                                            <input id="@context.Id" type="date" class="form-control" @bind="schedule.EndDate" />
                                        </FormField>
                                    </div>

                                    <div class="col-md-3">
                                        <FormField Label='@L["Pillar3a_Frequency"]' CssClass="">
                                            <select id="@context.Id" class="form-select" @bind="schedule.Frequency">
                                                @foreach (var frequency in Enum.GetValues<ScheduleFrequency>())
                                                {
                                                    <option value="@frequency">@EnumL.Translate(frequency)</option>
                                                }
                                            </select>
                                        </FormField>
                                    </div>

                                    <div class="col-md-2">
                                        <FormField Label='@L["Pillar3a_Interval"]' CssClass="">
                                            <input id="@context.Id" type="number" class="form-control num" @bind="schedule.Interval" />
                                        </FormField>
                                    </div>

                                    <div class="col-md-2">
                                        <FormField Label='@L["Pillar3a_DayOfMonth"]' CssClass="">
                                            <input id="@context.Id" type="number" class="form-control num" @bind="schedule.DayOfMonth" />
                                        </FormField>
                                    </div>

                                    <div class="col-md-3">
                                        <FormField Label='@L["Pillar3a_BusinessDayAdjustment"]' CssClass="">
                                            <select id="@context.Id" class="form-select" @bind="schedule.BusinessDayAdjustment">
                                                @foreach (var adjustment in Enum.GetValues<BusinessDayAdjustment>())
                                                {
                                                    <option value="@adjustment">@EnumL.Translate(adjustment)</option>
                                                }
                                            </select>
                                        </FormField>
                                    </div>

                                    <div class="col-md-2 d-flex align-items-end">
                                        <FormField Label='@L["Active"]' Layout="FormFieldLayout.Checkbox" CssClass="">
                                            <input id="@context.Id"
                                                   type="checkbox"
                                                   class="form-check-input"
                                                   @bind="schedule.IsActive" />
                                        </FormField>
                                    </div>

                                    <div class="col-md-12">
                                        <FormField Label='@L["Notes"]' CssClass="">
                                            <input id="@context.Id" class="form-control" @bind="schedule.Notes" />
                                        </FormField>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <div class="mt-3">
                        <button class="btn btn-primary" @onclick="SaveContract">
                            @L["Save"]
                        </button>

                        <button class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">
                            @L["Cancel"]
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">
                <strong>@L["Pillar3a_TaxYearSimulator"]</strong>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    @L["Pillar3a_TaxYearSimulatorText"]
                </p>

                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-3">
                        <FormField Label='@L["Pillar3a_TaxYear"]' CssClass="">
                            <input id="@context.Id" type="number" class="form-control num" @bind="_taxYear" />
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label='@L["Pillar3a_AnnualLimitPerPerson"]' CssClass="">
                            <MoneyInput Id="@context.Id" @bind-Value="_annualPillar3aLimit" />
                        </FormField>
                    </div>
                </div>

                <DataTable Items="taxYearRows"
                           RowKey="@(x => x.PersonId)"
                           Caption='@L["Pillar3a_TaxYearSimulator"]'
                           TableCssClass="table table-sm table-striped table-hover align-middle"
                           EmptyText='@L["Pillar3a_NoEligiblePersonsWithSchedules"]'>
                    <Column Title='@L["Person"]' Text="@(x => x.PersonName)" />

                    <Column Title='@L["Pillar3a_Contracts"]'
                            Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Number(x.ContractCount, 0))" />

                    <Column Title='@L["Pillar3a_ActiveSchedules"]'
                            Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Number(x.ActiveScheduleCount, 0))" />

                    <Column Title='@L["Pillar3a_AnnualLimit"]'
                            Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Money(x.AnnualLimit, x.Currency))" />

                    <Column Title='@L["Pillar3a_ScheduledContributions"]'
                            Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Money(x.ScheduledContributions, x.Currency))" />

                    <Column Title='@L["Pillar3a_Remaining"]'
                            Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Money(x.Remaining, x.Currency))" />

                    <Column Title='@L["Pillar3a_Excess"]'
                            Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Money(x.Excess, x.Currency))" />

                    <Column Title='@L["Status"]'
                            HeaderCssClass="text-end"
                            CellCssClass="text-end">
                        <ChildContent Context="row">
                            @if (row.IsExceeded)
                            {
                                <span class="badge bg-danger">@L["Pillar3a_Exceeded"]</span>
                            }
                            else if (row.IsLimitReached)
                            {
                                <span class="badge bg-success">@L["Pillar3a_LimitReached"]</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@L["Pillar3a_BelowLimit"]</span>
                            }
                        </ChildContent>
                    </Column>
                </DataTable>
            </div>
        </div>

        <h5>@L["Pillar3a_ProjectionSummaryPerPerson"]</h5>

        <DataTable Items="personProjectionRows"
                   RowKey="@(x => x.PersonId)"
                   Caption='@L["Pillar3a_ProjectionSummaryPerPerson"]'
                   TableCssClass="table table-sm table-striped table-hover align-middle"
                   EmptyText='@L["Pillar3a_NoPerPersonProjectionAvailable"]'>
            <Column Title='@L["Person"]' Text="@(x => x.PersonName)" />

            <Column Title='@L["Pillar3a_Contracts"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Number(x.ContractCount, 0))" />

            <Column Title='@L["Pillar3a_OpeningValue"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Money(x.OpeningValue, x.Currency))" />

            <Column Title='@L["Pillar3a_TotalContributions"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Money(x.Contributions, x.Currency))" />

            <Column Title='@L["Pillar3a_TotalGrowth"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Money(x.Growth, x.Currency))" />

            <Column Title='@L["Pillar3a_TotalWithdrawals"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Money(x.Withdrawals, x.Currency))" />

            <Column Title='@L["Pillar3a_ProjectedValue"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Money(x.ProjectedValue, x.Currency))" />

            <Column Title='@L["Pillar3a_LatestProjectionDate"]'
                    HeaderCssClass="text-end"
                    CellCssClass="text-end"
                    Text="@(x => Formatter.Date(x.LatestProjectionDate))" />
        </DataTable>

        <h5>@L["Pillar3a_Contracts"]</h5>

        @*
            Every cell reads its row and nothing else. A cell that closed over one of the locals
            computed above would render a frame late: Blazor hands a child component its parameters
            after the parent has already produced its render tree, so the lambda a Column is holding
            when DataTable draws the body is the one from the *previous* pass. Items is DataTable's
            own parameter and is always current, so anything a cell needs belongs on the row.
        *@
        <DataTable Items="contractRows"
                   RowKey="@(x => x.Contract.Id)"
                   Caption='@L["Pillar3a_Contracts"]'
                   TableCssClass="table table-sm table-striped table-hover align-middle"
                   EmptyText='@L["Pillar3a_NoContractsConfigured"]'>
            <Column Title='@L["Name"]'>
                <ChildContent Context="row">
                    <div>@row.Contract.Name</div>
                    @if (!string.IsNullOrWhiteSpace(row.Contract.ContractNumberMasked))
                    {
                        <small class="text-muted">@row.Contract.ContractNumberMasked</small>
                    }
                </ChildContent>
            </Column>

            <Column Title='@L["Status"]'>
                <ChildContent Context="row">
                    @if (row.Contract.IsActive)
                    {
                        <span class="badge bg-success">@L["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@L["Inactive"]</span>
                    }
                </ChildContent>
            </Column>

            <Column Title='@L["Owner"]' Text="@(x => x.OwnerName)" />

            <Column Title='@L["Type"]' Text="@(x => EnumL.Translate(x.Contract.Type))" />

            <Column Title='@L["Pillar3a_Provider"]'
                    Text="@(x => x.Contract.ProviderName ?? string.Empty)" />

            <Column Title='@L["Pillar3a_OpeningValue"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Money(x.Contract.OpeningValue, x.Contract.Currency))" />

            <Column Title='@L["Pillar3a_OpeningDate"]'
                    HeaderCssClass="text-center"
                    CellCssClass="text-center"
                    Text="@(x => Formatter.Date(x.Contract.OpeningDate))" />

            <Column Title='@L["Pillar3a_RetirementDate"]'
                    HeaderCssClass="text-center"
                    CellCssClass="text-center">
                <ChildContent Context="row">
                    @if (row.RetirementDate is null)
                    {
                        <span class="text-muted">@L["Pillar3a_Fallback30Years"]</span>
                    }
                    else
                    {
                        @Formatter.Date(row.RetirementDate.Value)
                    }
                </ChildContent>
            </Column>

            <Column Title='@L["Pillar3a_RemainingYears"]'
                    HeaderCssClass="text-center"
                    CellCssClass="text-center"
                    Text="@(x => x.RemainingYears)" />

            <Column Title='@L["Pillar3a_ProjectedValue"]' Align="ColumnAlign.Number">
                <ChildContent Context="row">
                    @if (row.ProjectedValue is null)
                    {
                        <span class="text-muted">@L["NotApplicable"]</span>
                    }
                    else
                    {
                        @Formatter.Money(row.ProjectedValue.Value, row.ProjectedValueCurrency)
                    }
                </ChildContent>
            </Column>

            <Column Title='@L["Actions"]'
                    HeaderCssClass="text-end"
                    CellCssClass="text-end text-nowrap">
                <ChildContent Context="row">
                    <button class="btn btn-sm btn-primary me-1"
                            @onclick="() => EditContract(row.Contract)">
                        @L["Edit"]
                    </button>

                    <button class="btn btn-sm btn-danger"
                            @onclick="() => DeleteContractAsync(row.Contract)">
                        @L["Delete"]
                    </button>
                </ChildContent>
            </Column>
        </DataTable>

        @if (contracts.Count > 0)
        {
            <h5>@L["Pillar3a_ProjectionSummaryByContract"]</h5>

            <DataTable Items="contractProjectionRows"
                       RowKey="@(x => x.ContractId)"
                       Caption='@L["Pillar3a_ProjectionSummaryByContract"]'
                       TableCssClass="table table-sm table-striped table-hover align-middle">
                <Column Title='@L["Pillar3a_Contract"]' Text="@(x => x.ContractName)" />

                <Column Title='@L["Owner"]' Text="@(x => x.OwnerName)" />

                <Column Title='@L["Pillar3a_OpeningValue"]'
                        Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Money(x.OpeningValue, x.Currency))" />

                <Column Title='@L["Pillar3a_TotalContributions"]'
                        Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Money(x.Contributions, x.Currency))" />

                <Column Title='@L["Pillar3a_TotalGrowth"]'
                        Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Money(x.Growth, x.Currency))" />

                <Column Title='@L["Pillar3a_Performance"]'
                        Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Percent(x.PerformancePercent))" />

                <Column Title='@L["Pillar3a_TotalWithdrawals"]'
                        Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Money(x.Withdrawals, x.Currency))" />

                <Column Title='@L["Pillar3a_ProjectedValue"]' Align="ColumnAlign.Number">
                    <ChildContent Context="row">
                        @if (row.ProjectedValue is null)
                        {
                            <span class="text-muted">@L["NotApplicable"]</span>
                        }
                        else
                        {
                            @Formatter.Money(row.ProjectedValue.Value, row.ProjectedValueCurrency)
                        }
                    </ChildContent>
                </Column>

                <Column Title='@L["Pillar3a_ProjectionEnd"]'>
                    <ChildContent Context="row">
                        @if (row.ProjectionEnd is null)
                        {
                            <span class="text-muted">@L["NotApplicable"]</span>
                        }
                        else
                        {
                            @Formatter.Date(row.ProjectionEnd.Value)
                        }
                    </ChildContent>
                </Column>
            </DataTable>

            <h5>@L["Pillar3a_YearlyProjectionByPerson"]</h5>

            @*
                One header row rather than two. The grouped header this replaces was a rowspan/
                colspan lattice, and DataTable generates header, body and footer from a single flat
                column list on purpose - the colspan arithmetic is exactly what went wrong
                elsewhere in the app. The person's name rides above the measure inside its own
                header cell instead.

                Keyed on the set of people: the columns are generated in a loop, and a person
                appearing mid-session would otherwise register their columns after the totals
                rather than in the middle. The key rebuilds the table instead.
            *@
            <DataTable @key="YearlyColumnKey(yearlyProjectionPersons)"
                       Items="yearlyProjectionMatrix"
                       RowKey="@(x => x.Year)"
                       Caption='@L["Pillar3a_YearlyProjectionByPerson"]'
                       TableCssClass="table table-sm table-striped table-hover align-middle"
                       EmptyText='@L["Pillar3a_NoYearlyProjectionAvailable"]'>
                <Column Title='@L["Pillar3a_Year"]'
                        Text="@(x => x.Year.ToString(CultureInfo.InvariantCulture))" />

                @foreach (var personId in yearlyProjectionPersons)
                {
                    <Column Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Money(Cell(x, personId)?.Contributions ?? 0m, x.Currency))">
                        <HeaderContent>
                            <span class="d-block small text-body-secondary fw-normal">@GetPersonName(personId)</span>
                            @L["Pillar3a_Contributions"]
                        </HeaderContent>
                    </Column>

                    <Column Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Money(Cell(x, personId)?.Growth ?? 0m, x.Currency))">
                        <HeaderContent>
                            <span class="d-block small text-body-secondary fw-normal">@GetPersonName(personId)</span>
                            @L["Pillar3a_Growth"]
                        </HeaderContent>
                    </Column>

                    <Column Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Percent(Cell(x, personId)?.PerformancePercent))">
                        <HeaderContent>
                            <span class="d-block small text-body-secondary fw-normal">@GetPersonName(personId)</span>
                            @L["Pillar3a_Performance"]
                        </HeaderContent>
                    </Column>

                    <Column Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Money(Cell(x, personId)?.Withdrawals ?? 0m, x.Currency))">
                        <HeaderContent>
                            <span class="d-block small text-body-secondary fw-normal">@GetPersonName(personId)</span>
                            @L["Pillar3a_Withdrawals"]
                        </HeaderContent>
                    </Column>

                    <Column Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Money(Cell(x, personId)?.EndValue ?? 0m, x.Currency))">
                        <HeaderContent>
                            <span class="d-block small text-body-secondary fw-normal">@GetPersonName(personId)</span>
                            @L["Pillar3a_EndValue"]
                        </HeaderContent>
                    </Column>
                }

                <Column Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Money(x.TotalEndValue, x.Currency))">
                    <HeaderContent>
                        <span class="d-block small text-body-secondary fw-normal">@L["Pillar3a_Total"]</span>
                        @L["Pillar3a_EndValue"]
                    </HeaderContent>
                </Column>

                <Column Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Money(x.TotalGrowth, x.Currency))">
                    <HeaderContent>
                        <span class="d-block small text-body-secondary fw-normal">@L["Pillar3a_Total"]</span>
                        @L["Pillar3a_Growth"]
                    </HeaderContent>
                </Column>

                <Column Align="ColumnAlign.Number"
                        Text="@(x => Formatter.Percent(x.TotalPerformancePercent))">
                    <HeaderContent>
                        <span class="d-block small text-body-secondary fw-normal">@L["Pillar3a_Total"]</span>
                        @L["Pillar3a_Performance"]
                    </HeaderContent>
                </Column>
            </DataTable>

            <h5>@L["Pillar3a_SimulatedContributionEvents"]</h5>

            @if (AppState.CurrentSimulationResult is null)
            {
                <div class="alert alert-info">
                    @L["Pillar3a_NoSimulationResultForContributionEvents"]
                </div>
            }
            else
            {
                <DataTable Items="SimulatedContributionEvents"
                           Caption='@L["Pillar3a_SimulatedContributionEvents"]'
                           TableCssClass="table table-sm table-striped table-hover align-middle"
                           EmptyText='@L["Pillar3a_NoContributionEventsInRange"]'>
                    <Column Title='@L["Date"]' Text="@(x => Formatter.Date(x.Date))" />

                    <Column Title='@L["Name"]'>
                        <ChildContent Context="cashFlowEvent">
                            <div>@cashFlowEvent.Name</div>
                            @if (!string.IsNullOrWhiteSpace(cashFlowEvent.Notes))
                            {
                                <small class="text-muted">@cashFlowEvent.Notes</small>
                            }
                        </ChildContent>
                    </Column>

                    <Column Title='@L["Transaction_FromAccount"]'
                            Text="@(x => GetAccountName(x.FromAccountId))" />

                    <Column Title='@L["Amount"]'
                            Align="ColumnAlign.Number"
                            Text="@(x => Formatter.Money(x.Amount))" />

                    <Column Title='@L["Currency"]' Text="@(x => x.Currency)" />

                    <Column Title='@L["Transaction_PaymentMethod"]'
                            Text="@(x => EnumL.Translate(x.PaymentMethod))" />
                </DataTable>
            }
        }
    </ChildContent>
</PageScaffold>

@code {
    private Pillar3aContractEditModel? _editModel;
    private bool _isNewContract;
    private string? _errorMessage;
    private string? _infoMessage;

    private ConfirmDialog? _confirmDialog;

    private int _taxYear = DateTime.Today.Year;
    private decimal _annualPillar3aLimit = 7_258m;

    private IReadOnlyList<Person> PersonList => AppState.CurrentPlan?.Persons ?? [];

    private IReadOnlyList<Person> ContractOwnerPersonList =>
        PersonList
            .Where(x => x.Pillar3aEligibility == Pillar3aEligibilityType.WithPensionFund)
            .ToList();

    private IReadOnlyList<Account> PaymentAccounts =>
        AppState.CurrentPlan?.Accounts
            .Where(x => x.Type is AccountType.BankAccount or AccountType.SavingsAccount or AccountType.Cash)
            .ToList()
        ?? [];

    private IReadOnlyList<CashFlowEvent> SimulatedContributionEvents =>
        AppState.CurrentSimulationResult?.Events
            .Where(x => x.Category == "Pillar 3a Contribution")
            .OrderBy(x => x.Date)
            .ThenBy(x => x.Name)
            .ToList()
        ?? [];

    /// <summary>
    /// <see cref="MoneyInput"/> binds a <c>decimal</c> and the model holds a <c>decimal?</c>. Zero
    /// stands in for null, which changes nothing: the projection engine never reads this figure and
    /// the only rule on it is that it may not be negative.
    /// </summary>
    private decimal ExpectedSurplusPercent
    {
        get => _editModel?.ExpectedSurplusPercent ?? 0m;
        set
        {
            if (_editModel is not null)
            {
                _editModel.ExpectedSurplusPercent = value == 0m ? null : value;
            }
        }
    }

    private static YearlyPersonProjectionCell? Cell(
        YearlyPersonProjectionMatrixRow row,
        Guid personId)
    {
        return row.PersonCells.TryGetValue(personId, out var cell) ? cell : null;
    }

    private static string YearlyColumnKey(IReadOnlyList<Guid> personIds) =>
        string.Join('|', personIds);

    private void NewContract()
    {
        ClearMessages();

        var baseCurrency = AppState.CurrentPlan?.BaseCurrency ?? "CHF";

        _editModel = new Pillar3aContractEditModel
        {
            Id = Guid.NewGuid(),
            Name = string.Empty,
            Currency = baseCurrency,
            OpeningDate = DateOnly.FromDateTime(DateTime.Today),
            IsActive = true,
            OwnerPersonId = ContractOwnerPersonList.Count == 1
                ? ContractOwnerPersonList[0].Id
                : null
        };

        _isNewContract = true;
    }

    private void EditContract(Pillar3aContract contract)
    {
        ClearMessages();
        _editModel = Pillar3aContractEditModel.FromContract(contract);
        _isNewContract = false;
    }

    private void SaveContract()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        try
        {
            var contract = _editModel.ToContract();
            AppState.AddOrUpdatePillar3aContract(contract);

            _infoMessage = _isNewContract
                ? Text("Pillar3a_ContractAdded", contract.Name)
                : Text("Pillar3a_ContractUpdated", contract.Name);

            _editModel = null;
            _isNewContract = false;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    // The plan autosaves to the browser working copy, so an accidental click here is not
    // recoverable without re-importing a file.
    private async Task DeleteContractAsync(Pillar3aContract contract)
    {
        ClearMessages();

        if (_confirmDialog is null)
        {
            return;
        }

        var confirmed = await _confirmDialog.ShowAsync(
            Text("Delete"),
            Text("Dialog_ConfirmMessage"));

        if (!confirmed)
        {
            return;
        }

        try
        {
            AppState.DeletePillar3aContract(contract.Id);
            _infoMessage = Text("Pillar3a_ContractDeleted", contract.Name);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        ClearMessages();
        _editModel = null;
        _isNewContract = false;
    }

    private void AddContributionSchedule()
    {
        if (_editModel is null)
        {
            return;
        }

        _editModel.ContributionSchedules.Add(new Pillar3aContributionScheduleEditModel
        {
            Id = Guid.NewGuid(),
            PaymentAccountId = PaymentAccounts.Count == 1
                ? PaymentAccounts[0].Id
                : null,
            StartDate = DateOnly.FromDateTime(DateTime.Today),
            Amount = 0m,
            Currency = AppState.CurrentPlan?.BaseCurrency ?? "CHF",
            Frequency = ScheduleFrequency.Monthly,
            Interval = 1,
            DayOfMonth = DateTime.Today.Day,
            BusinessDayAdjustment = BusinessDayAdjustment.PreviousBusinessDay,
            IsActive = true
        });
    }

    private void RemoveContributionSchedule(Pillar3aContributionScheduleEditModel schedule)
    {
        _editModel?.ContributionSchedules.Remove(schedule);
    }

    private Person? GetPerson(Guid personId)
    {
        return AppState.CurrentPlan?.Persons
            .SingleOrDefault(x => x.Id == personId);
    }

    private string GetPersonName(Guid personId)
    {
        return GetPerson(personId)?.DisplayName ?? "?";
    }

    private string GetAccountName(Guid? accountId)
    {
        if (accountId is null || AppState.CurrentPlan is null)
        {
            return AppFormatter.EmptyMarker;
        }

        return AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == accountId.Value)
            ?.Name
            ?? "?";
    }

    private bool HasActiveScheduledPillar3aContribution(Guid personId)
    {
        if (AppState.CurrentPlan is null)
        {
            return false;
        }

        return AppState.CurrentPlan.Pillar3aContracts.Any(contract =>
            contract.IsActive
            && contract.OwnerPersonId == personId
            && contract.ContributionSchedules.Any(schedule => schedule.IsActive));
    }

    private IReadOnlyList<TaxYearDashboardRow> BuildTaxYearRows(
        Pillar3aTaxYearSimulationResult taxYearResult)
    {
        return PersonList
            .Where(person =>
                person.Pillar3aEligibility == Pillar3aEligibilityType.WithPensionFund
                && HasActiveScheduledPillar3aContribution(person.Id))
            .OrderBy(person => person.DisplayName)
            .Select(person =>
            {
                var result = taxYearResult.Persons
                    .SingleOrDefault(x => x.PersonId == person.Id);

                var scheduledContributions = result?.ScheduledContributions ?? 0m;
                var remaining = Math.Max(0m, _annualPillar3aLimit - scheduledContributions);
                var excess = Math.Max(0m, scheduledContributions - _annualPillar3aLimit);

                return new TaxYearDashboardRow
                {
                    PersonId = person.Id,
                    PersonName = person.DisplayName,
                    ContractCount = result?.ContractCount ?? 0,
                    ActiveScheduleCount = result?.ActiveScheduleCount ?? 0,
                    AnnualLimit = _annualPillar3aLimit,
                    ScheduledContributions = scheduledContributions,
                    Remaining = remaining,
                    Excess = excess,
                    Currency = AppState.CurrentPlan?.BaseCurrency ?? "CHF",
                    IsLimitReached = scheduledContributions >= _annualPillar3aLimit,
                    IsExceeded = scheduledContributions > _annualPillar3aLimit
                };
            })
            .ToList();
    }

    private IReadOnlyList<PersonPillar3aProjectionRow> BuildPersonProjectionRows(
        IReadOnlyList<Pillar3aContract> contracts,
        IReadOnlyList<Pillar3aProjectionResult> projectionResults)
    {
        return contracts
            .GroupBy(x => x.OwnerPersonId)
            .Select(group =>
            {
                var personId = group.Key;
                var personContracts = group.ToList();

                var personProjectionResults = projectionResults
                    .Where(x => x.OwnerPersonId == personId)
                    .ToList();

                var openingValue = personContracts.Sum(x => x.OpeningValue);
                var contributions = personProjectionResults.Sum(x => x.Points.Sum(p => p.Contributions));
                var growth = personProjectionResults.Sum(x => x.Points.Sum(p => p.Growth));
                var withdrawals = personProjectionResults.Sum(x => x.Points.Sum(p => p.Withdrawals));
                var projectedValue = personProjectionResults.Sum(x => x.Points.LastOrDefault()?.Value ?? 0m);

                var latestProjectionDate = personProjectionResults
                    .Select(x => x.Points.LastOrDefault()?.Date)
                    .Where(x => x is not null)
                    .Select(x => x!.Value)
                    .DefaultIfEmpty()
                    .Max();

                return new PersonPillar3aProjectionRow
                {
                    PersonId = personId,
                    PersonName = GetPersonName(personId),
                    ContractCount = personContracts.Count,
                    OpeningValue = openingValue,
                    Contributions = contributions,
                    Growth = growth,
                    Withdrawals = withdrawals,
                    ProjectedValue = projectedValue,
                    LatestProjectionDate = latestProjectionDate == default ? null : latestProjectionDate,
                    Currency = AppState.CurrentPlan?.BaseCurrency ?? "CHF"
                };
            })
            .ToList();
    }

    private IReadOnlyList<ContractRow> BuildContractRows(
        IReadOnlyList<Pillar3aContract> contracts,
        IReadOnlyList<Pillar3aProjectionResult> projectionResults)
    {
        return contracts
            .Select(contract =>
            {
                var owner = GetPerson(contract.OwnerPersonId);

                var finalPoint = projectionResults
                    .SingleOrDefault(x => x.ContractId == contract.Id)
                    ?.Points.LastOrDefault();

                return new ContractRow
                {
                    Contract = contract,
                    OwnerName = GetPersonName(contract.OwnerPersonId),
                    RetirementDate = owner?.RetirementDate,
                    RemainingYears = FormatRemainingYears(owner?.RetirementDate),
                    ProjectedValue = finalPoint?.Value,
                    ProjectedValueCurrency = finalPoint?.Currency ?? contract.Currency
                };
            })
            .ToList();
    }

    /// <summary>
    /// The per-contract projection summary as rows. Pulled out of the markup so the table is a
    /// column declaration rather than a loop with five running totals in it.
    /// </summary>
    private IReadOnlyList<ContractProjectionRow> BuildContractProjectionRows(
        IReadOnlyList<Pillar3aContract> contracts,
        IReadOnlyList<Pillar3aProjectionResult> projectionResults)
    {
        return projectionResults
            .OrderBy(x => GetPersonName(x.OwnerPersonId))
            .ThenBy(x => x.ContractName)
            .Select(projection =>
            {
                var contract = contracts.Single(x => x.Id == projection.ContractId);
                var finalPoint = projection.Points.LastOrDefault();
                var contributions = projection.Points.Sum(x => x.Contributions);
                var growth = projection.Points.Sum(x => x.Growth);
                var withdrawals = projection.Points.Sum(x => x.Withdrawals);

                return new ContractProjectionRow
                {
                    ContractId = projection.ContractId,
                    ContractName = projection.ContractName,
                    OwnerName = GetPersonName(projection.OwnerPersonId),
                    Currency = contract.Currency,
                    OpeningValue = contract.OpeningValue,
                    Contributions = contributions,
                    Growth = growth,
                    Withdrawals = withdrawals,
                    PerformancePercent = CalculatePerformancePercent(
                        contract.OpeningValue,
                        contributions,
                        withdrawals,
                        growth),
                    ProjectedValue = finalPoint?.Value,
                    ProjectedValueCurrency = finalPoint?.Currency ?? contract.Currency,
                    ProjectionEnd = finalPoint?.Date
                };
            })
            .ToList();
    }

    private IReadOnlyList<YearlyPersonProjectionMatrixRow> BuildYearlyPersonProjectionMatrixRows(
        IReadOnlyList<Pillar3aContract> contracts,
        IReadOnlyList<Pillar3aProjectionResult> projectionResults)
    {
        var years = projectionResults
            .SelectMany(x => x.Points.Select(point => point.Date.Year))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        var rows = new List<YearlyPersonProjectionMatrixRow>();

        foreach (var year in years)
        {
            var row = new YearlyPersonProjectionMatrixRow
            {
                Year = year,
                Currency = AppState.CurrentPlan?.BaseCurrency ?? "CHF"
            };

            var personIds = projectionResults
                .Select(x => x.OwnerPersonId)
                .Distinct()
                .ToList();

            foreach (var personId in personIds)
            {
                var personProjectionResults = projectionResults
                    .Where(x => x.OwnerPersonId == personId)
                    .ToList();

                var contributions = 0m;
                var growth = 0m;
                var withdrawals = 0m;
                var endValue = 0m;

                foreach (var projection in personProjectionResults)
                {
                    var pointsInYear = projection.Points
                        .Where(x => x.Date.Year == year)
                        .OrderBy(x => x.Date)
                        .ToList();

                    if (pointsInYear.Count == 0)
                    {
                        continue;
                    }

                    contributions += pointsInYear.Sum(x => x.Contributions);
                    growth += pointsInYear.Sum(x => x.Growth);
                    withdrawals += pointsInYear.Sum(x => x.Withdrawals);
                    endValue += pointsInYear.Last().Value;
                }

                if (contributions == 0m && growth == 0m && withdrawals == 0m && endValue == 0m)
                {
                    continue;
                }

                var performancePercent = CalculateYearPerformancePercent(
                    endValue,
                    withdrawals,
                    growth);

                row.PersonCells[personId] = new YearlyPersonProjectionCell
                {
                    PersonId = personId,
                    Contributions = contributions,
                    Growth = growth,
                    Withdrawals = withdrawals,
                    EndValue = endValue,
                    PerformancePercent = performancePercent
                };
            }

            row.TotalEndValue = row.PersonCells.Values.Sum(x => x.EndValue);
            row.TotalGrowth = row.PersonCells.Values.Sum(x => x.Growth);

            var totalWithdrawals = row.PersonCells.Values.Sum(x => x.Withdrawals);

            row.TotalPerformancePercent = CalculateYearPerformancePercent(
                row.TotalEndValue,
                totalWithdrawals,
                row.TotalGrowth);

            rows.Add(row);
        }

        return rows;
    }

    private static decimal? CalculatePerformancePercent(
        decimal openingValue,
        decimal contributions,
        decimal withdrawals,
        decimal growth)
    {
        var denominator = openingValue + contributions - withdrawals;

        if (denominator <= 0m)
        {
            return null;
        }

        return growth / denominator * 100m;
    }

    private static decimal? CalculateYearPerformancePercent(
        decimal endValue,
        decimal withdrawals,
        decimal growth)
    {
        var denominator = endValue - growth + withdrawals;

        if (denominator <= 0m)
        {
            return null;
        }

        return growth / denominator * 100m;
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
    }

    // Left alone deliberately: this composes a localized sentence rather than formatting a value,
    // so it is not one of the duplicated format helpers AppFormatter replaces.
    private string FormatRemainingYears(DateOnly? retirementDate)
    {
        var effectiveRetirementDate = retirementDate
            ?? DateOnly.FromDateTime(DateTime.Today).AddYears(30);

        var today = DateOnly.FromDateTime(DateTime.Today);

        if (effectiveRetirementDate <= today)
        {
            return "0";
        }

        var totalYears = (effectiveRetirementDate.Year - today.Year);

        // Adjust if the retirement date has not yet been reached this year
        var hasFullYearPassed =
            effectiveRetirementDate.Month > today.Month ||
            (effectiveRetirementDate.Month == today.Month &&
             effectiveRetirementDate.Day >= today.Day);

        if (!hasFullYearPassed)
        {
            totalYears--;
        }

        return totalYears.ToString(CultureInfo.CurrentCulture);
    }

    private sealed class TaxYearDashboardRow
    {
        public Guid PersonId { get; init; }
        public string PersonName { get; init; } = string.Empty;
        public int ContractCount { get; init; }
        public int ActiveScheduleCount { get; init; }
        public decimal AnnualLimit { get; init; }
        public decimal ScheduledContributions { get; init; }
        public decimal Remaining { get; init; }
        public decimal Excess { get; init; }
        public bool IsLimitReached { get; init; }
        public bool IsExceeded { get; init; }
        public string Currency { get; init; } = "CHF";
    }

    /// <summary>
    /// One row of the contracts table, with everything its cells need already resolved. See the
    /// comment above that table for why a cell may not reach outside its row.
    /// </summary>
    private sealed class ContractRow
    {
        public required Pillar3aContract Contract { get; init; }
        public string OwnerName { get; init; } = string.Empty;
        public DateOnly? RetirementDate { get; init; }
        public string RemainingYears { get; init; } = string.Empty;
        public decimal? ProjectedValue { get; init; }
        public string ProjectedValueCurrency { get; init; } = "CHF";
    }

    private sealed class PersonPillar3aProjectionRow
    {
        public Guid PersonId { get; init; }
        public string PersonName { get; init; } = string.Empty;
        public int ContractCount { get; init; }
        public decimal OpeningValue { get; init; }
        public decimal Contributions { get; init; }
        public decimal Growth { get; init; }
        public decimal Withdrawals { get; init; }
        public decimal ProjectedValue { get; init; }
        public DateOnly? LatestProjectionDate { get; init; }
        public string Currency { get; init; } = "CHF";
    }

    private sealed class ContractProjectionRow
    {
        public Guid ContractId { get; init; }
        public string ContractName { get; init; } = string.Empty;
        public string OwnerName { get; init; } = string.Empty;
        public string Currency { get; init; } = "CHF";
        public decimal OpeningValue { get; init; }
        public decimal Contributions { get; init; }
        public decimal Growth { get; init; }
        public decimal Withdrawals { get; init; }
        public decimal? PerformancePercent { get; init; }
        public decimal? ProjectedValue { get; init; }
        public string ProjectedValueCurrency { get; init; } = "CHF";
        public DateOnly? ProjectionEnd { get; init; }
    }

    private sealed class YearlyPersonProjectionMatrixRow
    {
        public int Year { get; init; }
        public Dictionary<Guid, YearlyPersonProjectionCell> PersonCells { get; } = [];
        public decimal TotalEndValue { get; set; }
        public decimal TotalGrowth { get; set; }
        public decimal? TotalPerformancePercent { get; set; }
        public string Currency { get; init; } = "CHF";
    }

    private sealed class YearlyPersonProjectionCell
    {
        public Guid PersonId { get; init; }
        public decimal Contributions { get; init; }
        public decimal Growth { get; init; }
        public decimal? PerformancePercent { get; init; }
        public decimal Withdrawals { get; init; }
        public decimal EndValue { get; init; }
    }
}
