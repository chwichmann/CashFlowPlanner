    // Left alone deliberately: this composes a localized sentence rather than formatting a value,
    // so it is not one of the duplicated format helpers AppFormatter replaces.
    private string FormatRemainingYears(DateOnly? retirementDate)
    {
        var effectiveRetirementDate = retirementDate
            ?? DateOnly.FromDateTime(DateTime.Today).AddYears(30);

        var today = DateOnly.FromDateTime(DateTime.Today);

        if (effectiveRetirementDate <= today)
        {
            return "0";
        }

        var totalYears = (effectiveRetirementDate.Year - today.Year);

        // Adjust if the retirement date has not yet been reached this year
        var hasFullYearPassed =
            effectiveRetirementDate.Month > today.Month ||
            (effectiveRetirementDate.Month == today.Month &&
             effectiveRetirementDate.Day >= today.Day);

        if (!hasFullYearPassed)
        {
            totalYears--;
        }

        return totalYears.ToString(CultureInfo.CurrentCulture);
    }

