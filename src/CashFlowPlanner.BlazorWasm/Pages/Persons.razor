@page "/persons"

@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core
@using CashFlowPlanner.Core.People
@using Microsoft.Extensions.Localization

@inherits AppStateAwarePage

@inject CashFlowAppState AppState
@inject AppFormatter Formatter
@inject EnumLocalizer EnumL
@inject IStringLocalizer<SharedResource> L

<PageScaffold Title='@L["Persons"]'
              Subtitle='@L["Person_Text"]'
              RequiresPlan="true"
              EmptyStateMessage='@L["Person_NoPlanLoaded"]'>

    <Notifications>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(infoMessage))
        {
            <div class="alert alert-success" role="alert">@infoMessage</div>
        }
    </Notifications>

    <ChildContent>
        <div class="card mb-3">
            <div class="card-header">
                <strong>@(isEditing ? L["Person_EditPerson"] : L["Person_AddPerson"])</strong>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <FormField Label='@L["Person_DisplayName"]' Required="true" CssClass="">
                            <input id="@context.Id"
                                   class="form-control"
                                   aria-describedby="@context.DescribedBy"
                                   @bind="editModel.DisplayName" />
                        </FormField>
                    </div>

                    <div class="col-md-4">
                        <FormField Label='@L["Person_DateOfBirth"]' CssClass="">
                            <input id="@context.Id"
                                   type="date"
                                   class="form-control"
                                   aria-describedby="@context.DescribedBy"
                                   @bind="editModel.DateOfBirth" />
                        </FormField>
                    </div>

                    <div class="col-md-4">
                        <FormField Label='@L["Person_RetirementDate"]'
                                   Hint='@L["Person_RetirementDateHint"]'
                                   CssClass="">
                            <input id="@context.Id"
                                   type="date"
                                   class="form-control"
                                   aria-describedby="@context.DescribedBy"
                                   @bind="editModel.RetirementDate" />
                        </FormField>
                    </div>

                    <div class="col-md-6">
                        <FormField Label='@L["Person_Pillar3aEligibility"]' CssClass="">
                            <select id="@context.Id"
                                    class="form-select"
                                    aria-describedby="@context.DescribedBy"
                                    @bind="editModel.Pillar3aEligibility">
                                @foreach (var eligibility in Enum.GetValues<Pillar3aEligibilityType>())
                                {
                                    <option value="@eligibility">@EnumL.Translate(eligibility)</option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-md-6">
                        <FormField Label='@L["Person_AnnualEarnedIncome"]' Hint="@EarnedIncomeHint" CssClass="">
                            <MoneyInput Id="@context.Id"
                                        AriaDescribedBy="@context.DescribedBy"
                                        Suffix="@BaseCurrency"
                                        @bind-Value="editModel.AnnualEarnedIncome" />
                        </FormField>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="button" class="btn btn-primary" @onclick="Save">
                        @(isEditing ? L["Save"] : L["Person_Add"])
                    </button>

                    @if (isEditing)
                    {
                        <button type="button" class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">
                            @L["Cancel"]
                        </button>
                    }
                </div>
            </div>
        </div>

        <DataTable Items="@PersonList.OrderBy(x => x.DisplayName).ToList()"
                   RowKey="@(person => person.Id)"
                   EmptyText='@L["Person_NoPersonsDefined"]'
                   Caption='@L["Persons"]'>
            <Column Title='@L["Name"]' Text="@(person => person.DisplayName)" />
            <Column Title='@L["Person_DateOfBirth"]' Text="@(person => Formatter.Date(person.DateOfBirth))" />
            <Column Title='@L["Person_RetirementDate"]' Text="@(person => Formatter.Date(person.RetirementDate))" />
            <Column Title='@L["Person_Pillar3aEligibility"]'
                    Text="@(person => EnumL.Translate(person.Pillar3aEligibility))" />
            <Column Title='@L["Person_ManualEarnedIncome"]' Align="ColumnAlign.Number"
                    Text="@(person => Formatter.Money(person.AnnualEarnedIncome, BaseCurrency))" />
            <Column Title='@L["Person_IncomeTransactions"]' Align="ColumnAlign.Number"
                    Text="@(person => Formatter.Number(CountIncomeTransactionsForPerson(person.Id), 0))" />
            <Column Title='@L["Person_SimulatedIncome"]' Align="ColumnAlign.Number"
                    Text="@(person => Formatter.Money(GetSimulatedIncomeForPerson(person.Id), BaseCurrency))" />
            <Column Title='@L["Accounts"]' Align="ColumnAlign.Number"
                    Text="@(person => Formatter.Number(CountAccountsForPerson(person.Id), 0))" />
            <Column Title='@L["Person_Pillar3aContracts"]' Align="ColumnAlign.Number"
                    Text="@(person => Formatter.Number(CountPillar3aContractsForPerson(person.Id), 0))" />
            <Column Title='@L["Actions"]' Align="ColumnAlign.Number" CellCssClass="text-nowrap">
                <ChildContent>
                    <button type="button"
                            class="btn btn-sm btn-primary me-1"
                            @onclick="() => Edit(context)">
                        @L["Edit"]
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-danger"
                            title="@GetDeleteTitle(context)"
                            disabled="@(!CanDelete(context))"
                            @onclick="() => DeleteAsync(context)">
                        @L["Delete"]
                    </button>
                </ChildContent>
            </Column>
        </DataTable>
    </ChildContent>
</PageScaffold>

<ConfirmDialog @ref="_confirmDialog" />

@code {
    private PersonEditModel editModel = CreateNewEditModel();
    private bool isEditing;
    private string? errorMessage;
    private string? infoMessage;
    private ConfirmDialog? _confirmDialog;

    private IReadOnlyList<Person> PersonList => AppState.CurrentPlan?.Persons ?? [];

    private string BaseCurrency => AppState.CurrentPlan?.BaseCurrency ?? string.Empty;

    private string? EarnedIncomeHint =>
        editModel.Pillar3aEligibility == Pillar3aEligibilityType.WithoutPensionFund
            ? L["Person_AnnualEarnedIncomeHint"].Value
            : null;

    private void Save()
    {
        ClearMessages();

        if (string.IsNullOrWhiteSpace(editModel.DisplayName))
        {
            errorMessage = Text("Person_ErrorDisplayNameRequired");
            return;
        }

        try
        {
            var person = editModel.ToPerson();
            AppState.AddOrUpdatePerson(person);

            infoMessage = isEditing
                ? Text("Person_Updated", person.DisplayName)
                : Text("Person_Added", person.DisplayName);

            ResetForm();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void Edit(Person person)
    {
        ClearMessages();
        isEditing = true;
        editModel = PersonEditModel.FromPerson(person);
    }

    private void CancelEdit()
    {
        ClearMessages();
        ResetForm();
    }

    private async Task DeleteAsync(Person person)
    {
        ClearMessages();

        if (_confirmDialog is null)
        {
            return;
        }

        // A person can be wired to accounts, income transactions and Pillar 3a contracts, and the
        // deletion is not undoable - it went straight through on a single click before this.
        var confirmed = await _confirmDialog.ShowAsync(
            Text("Person_DeletePerson"),
            Text("Dialog_ConfirmMessage"));

        if (!confirmed)
        {
            return;
        }

        try
        {
            AppState.DeletePerson(person.Id);

            if (editModel.Id == person.Id)
            {
                ResetForm();
            }

            infoMessage = Text("Person_Deleted", person.DisplayName);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ResetForm()
    {
        isEditing = false;
        editModel = CreateNewEditModel();
    }

    private static PersonEditModel CreateNewEditModel()
    {
        return new PersonEditModel
        {
            Id = Guid.NewGuid(),
            Pillar3aEligibility = Pillar3aEligibilityType.WithPensionFund
        };
    }

    private int CountAccountsForPerson(Guid personId)
    {
        if (AppState.CurrentPlan is null)
        {
            return 0;
        }

        return AppState.CurrentPlan.Accounts.Count(account =>
            account.Owners.Any(owner => owner.PersonId == personId));
    }

    private int CountIncomeTransactionsForPerson(Guid personId)
    {
        if (AppState.CurrentPlan is null)
        {
            return 0;
        }

        return AppState.CurrentPlan.Transactions.Count(transaction =>
            transaction.IncomePersonId == personId);
    }

    private decimal? GetSimulatedIncomeForPerson(Guid personId)
    {
        if (AppState.CurrentPlan is null || AppState.CurrentSimulationResult is null)
        {
            return null;
        }

        var incomeTransactionIds = AppState.CurrentPlan.Transactions
            .Where(transaction =>
                transaction.IncomePersonId == personId
                && transaction.Kind == TransactionKind.ExternalIncome)
            .Select(transaction => transaction.Id)
            .ToHashSet();

        if (incomeTransactionIds.Count == 0)
        {
            return 0m;
        }

        return AppState.CurrentSimulationResult.Events
            .Where(cashFlowEvent =>
                incomeTransactionIds.Contains(cashFlowEvent.SourceTransactionId)
                && cashFlowEvent.Kind == TransactionKind.ExternalIncome)
            .Sum(cashFlowEvent => cashFlowEvent.Amount);
    }

    private int CountPillar3aContractsForPerson(Guid personId)
    {
        if (AppState.CurrentPlan is null)
        {
            return 0;
        }

        return AppState.CurrentPlan.Pillar3aContracts.Count(contract =>
            contract.OwnerPersonId == personId);
    }

    private bool CanDelete(Person person) =>
        CountAccountsForPerson(person.Id) == 0
        && CountIncomeTransactionsForPerson(person.Id) == 0
        && CountPillar3aContractsForPerson(person.Id) == 0;

    private string GetDeleteTitle(Person person)
    {
        if (CountAccountsForPerson(person.Id) > 0)
        {
            return Text("Person_DeleteBlockedByAccounts");
        }

        if (CountIncomeTransactionsForPerson(person.Id) > 0)
        {
            return Text("Person_DeleteBlockedByIncomeTransactions");
        }

        if (CountPillar3aContractsForPerson(person.Id) > 0)
        {
            return Text("Person_DeleteBlockedByPillar3aContracts");
        }

        return Text("Person_DeletePerson");
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private void ClearMessages()
    {
        errorMessage = null;
        infoMessage = null;
    }
}
