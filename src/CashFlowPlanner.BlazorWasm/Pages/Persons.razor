@page "/persons"

@using System.Globalization
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core
@using CashFlowPlanner.Core.People
@using Microsoft.Extensions.Localization

@inject CashFlowAppState AppState
@inject EnumLocalizer EnumL
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Persons"] - CashFlow Planner</PageTitle>

<h3>@L["Persons"]</h3>

<p class="text-muted">
    @L["Person_Text"]
</p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(infoMessage))
{
    <div class="alert alert-info">@infoMessage</div>
}

@if (!AppState.HasPlan || AppState.CurrentPlan is null)
{
    <div class="alert alert-warning">
        @L["Person_NoPlanLoaded"]
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>@(isEditing ? L["Person_EditPerson"] : L["Person_AddPerson"])</strong>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@L["Person_DisplayName"]</label>
                    <input class="form-control" @bind="editModel.DisplayName" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">@L["Person_DateOfBirth"]</label>
                    <input type="date" class="form-control" @bind="editModel.DateOfBirth" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">@L["Person_RetirementDate"]</label>
                    <input type="date" class="form-control" @bind="editModel.RetirementDate" />
                    <div class="form-text">
                        @L["Person_RetirementDateHint"]
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">@L["Person_Pillar3aEligibility"]</label>
                    <select class="form-select" @bind="editModel.Pillar3aEligibility">
                        @foreach (var eligibility in Enum.GetValues<Pillar3aEligibilityType>())
                        {
                            <option value="@eligibility">@EnumL.Translate(eligibility)</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">@L["Person_AnnualEarnedIncome"]</label>
                    <input type="number" step="0.01" class="form-control" @bind="editModel.AnnualEarnedIncome" />

                    @if (editModel.Pillar3aEligibility == Pillar3aEligibilityType.WithoutPensionFund)
                    {
                        <div class="form-text">
                            @L["Person_AnnualEarnedIncomeHint"]
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Save">
                    @(isEditing ? L["Save"] : L["Person_Add"])
                </button>

                @if (isEditing)
                {
                    <button class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">
                        @L["Cancel"]
                    </button>
                }
            </div>
        </div>
    </div>

    @if (PersonList.Count == 0)
    {
        <div class="alert alert-info">
            @L["Person_NoPersonsDefined"]
        </div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>@L["Name"]</th>
                    <th>@L["Person_DateOfBirth"]</th>
                    <th>@L["Person_RetirementDate"]</th>
                    <th>@L["Person_Pillar3aEligibility"]</th>
                    <th class="text-end">@L["Person_ManualEarnedIncome"]</th>
                    <th class="text-end">@L["Person_IncomeTransactions"]</th>
                    <th class="text-end">@L["Person_SimulatedIncome"]</th>
                    <th class="text-end">@L["Accounts"]</th>
                    <th class="text-end">@L["Person_Pillar3aContracts"]</th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var person in PersonList.OrderBy(x => x.DisplayName))
                {
                    var usedByAccounts = CountAccountsForPerson(person.Id);
                    var incomeTransactionCount = CountIncomeTransactionsForPerson(person.Id);
                    var simulatedIncome = GetSimulatedIncomeForPerson(person.Id);
                    var usedByPillar3aContracts = CountPillar3aContractsForPerson(person.Id);
                    var canDelete = usedByAccounts == 0
                        && incomeTransactionCount == 0
                        && usedByPillar3aContracts == 0;

                    <tr>
                        <td>@person.DisplayName</td>
                        <td>@FormatDate(person.DateOfBirth)</td>
                        <td>@FormatDate(person.RetirementDate)</td>
                        <td>@EnumL.Translate(person.Pillar3aEligibility)</td>
                        <td class="text-end">@FormatMoney(person.AnnualEarnedIncome)</td>
                        <td class="text-end">@incomeTransactionCount</td>
                        <td class="text-end">@FormatMoney(simulatedIncome)</td>
                        <td class="text-end">@usedByAccounts</td>
                        <td class="text-end">@usedByPillar3aContracts</td>
                        <td style="white-space: nowrap;">
                            <button class="btn btn-sm btn-primary me-1"
                                    @onclick="() => Edit(person)">
                                @L["Edit"]
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    title="@GetDeleteTitle(usedByAccounts, incomeTransactionCount, usedByPillar3aContracts)"
                                    disabled="@(!canDelete)"
                                    @onclick="() => Delete(person)">
                                @L["Delete"]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private PersonEditModel editModel = CreateNewEditModel();
    private bool isEditing;
    private string? errorMessage;
    private string? infoMessage;

    private IReadOnlyList<Person> PersonList => AppState.CurrentPlan?.Persons ?? [];

    private void Save()
    {
        ClearMessages();

        if (string.IsNullOrWhiteSpace(editModel.DisplayName))
        {
            errorMessage = Text("Person_ErrorDisplayNameRequired");
            return;
        }

        try
        {
            var person = editModel.ToPerson();
            AppState.AddOrUpdatePerson(person);

            infoMessage = isEditing
                ? Text("Person_Updated", person.DisplayName)
                : Text("Person_Added", person.DisplayName);

            ResetForm();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void Edit(Person person)
    {
        ClearMessages();
        isEditing = true;
        editModel = PersonEditModel.FromPerson(person);
    }

    private void CancelEdit()
    {
        ClearMessages();
        ResetForm();
    }

    private void Delete(Person person)
    {
        ClearMessages();

        try
        {
            AppState.DeletePerson(person.Id);

            if (editModel.Id == person.Id)
            {
                ResetForm();
            }

            infoMessage = Text("Person_Deleted", person.DisplayName);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ResetForm()
    {
        isEditing = false;
        editModel = CreateNewEditModel();
    }

    private static PersonEditModel CreateNewEditModel()
    {
        return new PersonEditModel
        {
            Id = Guid.NewGuid(),
            Pillar3aEligibility = Pillar3aEligibilityType.WithPensionFund
        };
    }

    private int CountAccountsForPerson(Guid personId)
    {
        if (AppState.CurrentPlan is null)
        {
            return 0;
        }

        return AppState.CurrentPlan.Accounts.Count(account =>
            account.Owners.Any(owner => owner.PersonId == personId));
    }

    private int CountIncomeTransactionsForPerson(Guid personId)
    {
        if (AppState.CurrentPlan is null)
        {
            return 0;
        }

        return AppState.CurrentPlan.Transactions.Count(transaction =>
            transaction.IncomePersonId == personId);
    }

    private decimal? GetSimulatedIncomeForPerson(Guid personId)
    {
        if (AppState.CurrentPlan is null || AppState.CurrentSimulationResult is null)
        {
            return null;
        }

        var incomeTransactionIds = AppState.CurrentPlan.Transactions
            .Where(transaction =>
                transaction.IncomePersonId == personId
                && transaction.Kind == TransactionKind.ExternalIncome)
            .Select(transaction => transaction.Id)
            .ToHashSet();

        if (incomeTransactionIds.Count == 0)
        {
            return 0m;
        }

        return AppState.CurrentSimulationResult.Events
            .Where(cashFlowEvent =>
                incomeTransactionIds.Contains(cashFlowEvent.SourceTransactionId)
                && cashFlowEvent.Kind == TransactionKind.ExternalIncome)
            .Sum(cashFlowEvent => cashFlowEvent.Amount);
    }

    private int CountPillar3aContractsForPerson(Guid personId)
    {
        if (AppState.CurrentPlan is null)
        {
            return 0;
        }

        return AppState.CurrentPlan.Pillar3aContracts.Count(contract =>
            contract.OwnerPersonId == personId);
    }

    private string GetDeleteTitle(
        int usedByAccounts,
        int incomeTransactionCount,
        int usedByPillar3aContracts)
    {
        if (usedByAccounts > 0)
        {
            return Text("Person_DeleteBlockedByAccounts");
        }

        if (incomeTransactionCount > 0)
        {
            return Text("Person_DeleteBlockedByIncomeTransactions");
        }

        if (usedByPillar3aContracts > 0)
        {
            return Text("Person_DeleteBlockedByPillar3aContracts");
        }

        return Text("Person_DeletePerson");
    }

    private static string FormatDate(DateOnly? date)
    {
        return date?.ToString("d", CultureInfo.CurrentCulture) ?? "-";
    }

    private static string FormatMoney(decimal? amount)
    {
        return amount is null
            ? "-"
            : $"CHF {amount.Value.ToString("N2", CultureInfo.CurrentCulture)}";
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private void ClearMessages()
    {
        errorMessage = null;
        infoMessage = null;
    }
}