@page "/mortgages"
@using CashFlowPlanner.BlazorWasm.Resources
@using CashFlowPlanner.Core
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.Core.Accounts
@using CashFlowPlanner.Core.Mortgages
@using Microsoft.Extensions.Localization
@inherits AppStateAwarePage

@inject CashFlowAppState AppState
@inject IStringLocalizer<SharedResource> L
@inject EnumLocalizer EnumL
@inject AppFormatter Formatter

@* Outside the scaffold: the dialog has to survive the body being replaced by the empty state. *@
<ConfirmDialog @ref="_confirmDialog" />

<PageScaffold Title='@L["Mortgages_Title"]'
              RequiresPlan="true"
              EmptyStateMessage='@L["Mortgages_NoPlanLoaded"]'>
    <Actions>
        <button class="btn btn-primary" @onclick="NewMortgage">
            @L["Mortgages_AddMortgage"]
        </button>
    </Actions>

    <Notifications>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_infoMessage))
        {
            <div class="alert alert-info" role="alert">@_infoMessage</div>
        }
    </Notifications>

    <ChildContent>
        @if (_editModel is not null)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <strong>@(_isNewMortgage ? L["Mortgages_AddMortgage"] : L["Mortgages_EditMortgage"])</strong>
                </div>

                <div class="card-body">
                    <h6>@L["Mortgages_Basic"]</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <FormField Label='@L["Name"]' CssClass="">
                                <input id="@context.Id" class="form-control" @bind="_editModel.Name" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Type"]' CssClass="">
                                <select id="@context.Id" class="form-select" @bind="_editModel.Type">
                                    @foreach (var type in Enum.GetValues<MortgageType>())
                                    {
                                        <option value="@type">@EnumL.Translate(type)</option>
                                    }
                                </select>
                            </FormField>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <FormField Label='@L["Active"]'
                                       Layout="FormFieldLayout.Checkbox"
                                       CssClass="">
                                <input id="@context.Id"
                                       type="checkbox"
                                       class="form-check-input"
                                       @bind="_editModel.IsActive" />
                            </FormField>
                        </div>
                    </div>

                    <hr />

                    <h6>@L["Mortgages_PaymentAccounts"]</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <FormField Label='@L["Mortgages_PaymentAccount"]'
                                       Hint='@L["Mortgages_PaymentAccountHint"]'
                                       CssClass="">
                                <select id="@context.Id"
                                        aria-describedby="@context.DescribedBy"
                                        class="form-select"
                                        @bind="_editModel.PaymentAccountIdText">
                                    <option value="">@L["Mortgages_SelectPaymentAccount"]</option>
                                    @foreach (var account in PaymentAccounts)
                                    {
                                        <option value="@account.Id">@account.Name (@EnumL.Translate(account.Type))</option>
                                    }
                                </select>
                            </FormField>
                        </div>

                        <div class="col-md-6">
                            <FormField Label='@L["Mortgages_IndirectAccount"]'
                                       Hint='@L["Mortgages_IndirectAccountHint"]'
                                       CssClass="">
                                <select id="@context.Id"
                                        aria-describedby="@context.DescribedBy"
                                        class="form-select"
                                        @bind="_editModel.IndirectAmortisationAccountIdText">
                                    <option value="">@L["Transaction_NoneOption"]</option>
                                    @foreach (var account in IndirectAmortisationAccounts)
                                    {
                                        <option value="@account.Id">@account.Name (@EnumL.Translate(account.Type))</option>
                                    }
                                </select>
                            </FormField>
                        </div>
                    </div>

                    <hr />

                    <h6>@L["Mortgages_Principal"]</h6>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <FormField Label='@L["Mortgages_InitialPrincipal"]' CssClass="">
                                <MoneyInput Id="@context.Id" @bind-Value="_editModel.InitialPrincipal" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Mortgages_InitialDate"]' CssClass="">
                                <input id="@context.Id" type="date" class="form-control" @bind="_editModel.InitialDate" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Mortgages_CalculationPrincipal"]' CssClass="">
                                <MoneyInput Id="@context.Id" @bind-Value="_editModel.CalculationPrincipal" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Mortgages_CalculationPrincipalDate"]' CssClass="">
                                <input id="@context.Id" type="date" class="form-control" @bind="_editModel.CalculationPrincipalDate" />
                            </FormField>
                        </div>
                    </div>

                    <div class="form-text mt-2">
                        @L["Mortgages_PrincipalHint"]
                    </div>

                    <hr />

                    <h6>@L["Mortgages_Interest"]</h6>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <FormField Label='@L["Mortgages_FixedInterestSaronMarginPercent"]' CssClass="">
                                <MoneyInput Id="@context.Id"
                                            Decimals="3"
                                            Suffix="%"
                                            @bind-Value="_editModel.FixedInterestPercent" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Mortgages_EndDate"]' CssClass="">
                                <input id="@context.Id" type="date" class="form-control" @bind="_editModel.EndDate" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Mortgages_PaymentInterval"]' CssClass="">
                                <select id="@context.Id" class="form-select" @bind="_editModel.PaymentInterval">
                                    @foreach (var interval in Enum.GetValues<MortgagePaymentInterval>())
                                    {
                                        <option value="@interval">@EnumL.Translate(interval)</option>
                                    }
                                </select>
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label='@L["Mortgages_BillingCalendar"]' CssClass="">
                                <select id="@context.Id" class="form-select" @bind="_editModel.BillingCalendar">
                                    @foreach (var calendar in Enum.GetValues<MortgageBillingCalendar>())
                                    {
                                        <option value="@calendar">@EnumL.Translate(calendar)</option>
                                    }
                                </select>
                            </FormField>
                        </div>
                    </div>

                    @if (_editModel.Type == MortgageType.Saron)
                    {
                        <div class="mt-3">
                            <h6>@L["Mortgages_SaronRates"]</h6>

                            <div class="row g-3 align-items-end">
                                <div class="col-md-3">
                                    <FormField Label='@L["Date"]' CssClass="">
                                        <input id="@context.Id" type="date" class="form-control" @bind="_newSaronRate.Date" />
                                    </FormField>
                                </div>

                                <div class="col-md-3">
                                    <FormField Label='@L["Mortgages_RatePercent"]' CssClass="">
                                        <MoneyInput Id="@context.Id"
                                                    Decimals="3"
                                                    Suffix="%"
                                                    @bind-Value="_newSaronRate.RatePercent" />
                                    </FormField>
                                </div>

                                <div class="col-md-3">
                                    <button class="btn btn-outline-primary" @onclick="AddSaronRatePoint">
                                        @L["Mortgages_AddOrUpdateRatePoint"]
                                    </button>
                                </div>
                            </div>

                            @if (_editModel.SaronRates.Count == 0)
                            {
                                <div class="alert alert-warning mt-3">
                                    @L["Mortgages_SaronRateRequired"]
                                </div>
                            }
                            else
                            {
                                <DataTable Items="SaronRateRows"
                                           RowKey="@(x => x.Date)"
                                           Caption='@L["Mortgages_SaronRates"]'
                                           TableCssClass="table table-sm table-striped table-hover align-middle mt-3">
                                    <Column Title='@L["Date"]' Text="@(x => Formatter.Date(x.Date))" />

                                    <Column Title='@L["Mortgages_RatePercent"]'
                                            Align="ColumnAlign.Number"
                                            Text="@(x => Formatter.Number(x.RatePercent, 3))" />

                                    <Column Title='@L["Actions"]'>
                                        <ChildContent Context="ratePoint">
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => DeleteSaronRatePointAsync(ratePoint)">
                                                @L["Delete"]
                                            </button>
                                        </ChildContent>
                                    </Column>
                                </DataTable>
                            }

                            <div class="form-text">
                                @L["Mortgages_SaronRatesHint"]
                            </div>
                        </div>
                    }

                    <hr />

                    <h6>@L["Mortgages_Amortisation"]</h6>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <FormField Label='@L["Mortgages_AmortisationMode"]' CssClass="">
                                <select id="@context.Id" class="form-select" @bind="_editModel.AmortisationMode">
                                    @foreach (var mode in Enum.GetValues<AmortisationMode>())
                                    {
                                        <option value="@mode">@EnumL.Translate(mode)</option>
                                    }
                                </select>
                            </FormField>
                        </div>

                        <div class="col-md-4">
                            <FormField Label='@L["Mortgages_AnnualAmortisationAmount"]' CssClass="">
                                <MoneyInput Id="@context.Id" @bind-Value="_editModel.AnnualAmortisationAmount" />
                            </FormField>
                        </div>

                        <div class="col-md-4">
                            <FormField Label='@L["Notes"]' CssClass="">
                                <input id="@context.Id" class="form-control" @bind="_editModel.Notes" />
                            </FormField>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-primary" @onclick="SaveMortgage">
                            @L["Save"]
                        </button>

                        <button class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">
                            @L["Cancel"]
                        </button>
                    </div>
                </div>
            </div>
        }

        <DataTable Items="MortgageRows"
                   RowKey="@(x => x.Id)"
                   Caption='@L["Mortgages_Title"]'
                   TableCssClass="table table-sm table-striped table-hover align-middle"
                   EmptyText='@L["Mortgages_NoneConfigured"]'>
            <Column Title='@L["Name"]' Text="@(x => x.Name)" />

            <Column Title='@L["Type"]' Text="@(x => EnumL.Translate(x.Type))" />

            <Column Title='@L["Active"]'>
                <ChildContent Context="mortgage">
                    @if (mortgage.IsActive)
                    {
                        <span class="badge bg-success">@L["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@L["Inactive"]</span>
                    }
                </ChildContent>
            </Column>

            <Column Title='@L["Mortgages_PaymentAccount"]'
                    Text="@(x => GetAccountName(x.PaymentAccountId))" />

            <Column Title='@L["Mortgages_InitialPrincipal"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Money(x.InitialPrincipal))" />

            <Column Title='@L["Mortgages_CalculationPrincipal"]' Align="ColumnAlign.Number">
                <ChildContent Context="mortgage">
                    @if (mortgage.CalculationPrincipal is null)
                    {
                        <span class="text-muted">@L["Mortgages_Initial"]</span>
                    }
                    else
                    {
                        @Formatter.Money(mortgage.CalculationPrincipal.Value)
                    }
                </ChildContent>
            </Column>

            <Column Title='@L["Mortgages_ProjectedPrincipal"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Money(GetProjectedPrincipal(x)))" />

            @* Three decimals and no percent sign, exactly as the page has always shown it. *@
            <Column Title='@L["Mortgages_FixedPercent"]'
                    Align="ColumnAlign.Number"
                    Text="@(x => Formatter.Number(x.FixedInterestPercent, 3))" />

            <Column Title='@L["Mortgages_Amortisation"]'>
                <ChildContent Context="mortgage">
                    @EnumL.Translate(mortgage.AmortisationMode)
                    @if (mortgage.AnnualAmortisationAmount > 0)
                    {
                        <span>/ @Formatter.Money(mortgage.AnnualAmortisationAmount) @L["Mortgages_PerYearAbbreviation"]</span>
                    }
                </ChildContent>
            </Column>

            <Column Title='@L["Actions"]'
                    HeaderCssClass="text-end"
                    CellCssClass="text-end text-nowrap">
                <ChildContent Context="mortgage">
                    <button class="btn btn-sm btn-primary me-1"
                            @onclick="() => EditMortgage(mortgage)">
                        @L["Edit"]
                    </button>

                    <button class="btn btn-sm btn-danger"
                            @onclick="() => DeleteMortgageAsync(mortgage)">
                        @L["Delete"]
                    </button>
                </ChildContent>
            </Column>
        </DataTable>
    </ChildContent>
</PageScaffold>

@code {
    private MortgageEditModel? _editModel;
    private bool _isNewMortgage;

    private MortgageInterestRatePointEditModel _newSaronRate = new()
    {
        Date = DateOnly.FromDateTime(DateTime.Today),
        RatePercent = 0m
    };

    private string? _errorMessage;
    private string? _infoMessage;

    private ConfirmDialog? _confirmDialog;

    private IReadOnlyList<MortgageContract> MortgageRows =>
        AppState.CurrentPlan?.Mortgages
            .OrderBy(x => x.Name)
            .ToList()
        ?? [];

    private IReadOnlyList<MortgageInterestRatePointEditModel> SaronRateRows =>
        _editModel?.SaronRates
            .OrderBy(x => x.Date)
            .ToList()
        ?? [];

    private IReadOnlyList<Account> PaymentAccounts =>
        AppState.CurrentPlan?.Accounts
            .Where(x => x.Type is AccountType.BankAccount or AccountType.SavingsAccount or AccountType.Cash)
            .OrderBy(x => x.Name)
            .ToList()
        ?? [];

    private IReadOnlyList<Account> IndirectAmortisationAccounts =>
        AppState.CurrentPlan?.Accounts
            .Where(x => x.Type is AccountType.SavingsAccount)
            .OrderBy(x => x.Name)
            .ToList()
        ?? [];

    private void NewMortgage()
    {
        ClearMessages();

        var plan = AppState.CurrentPlan;
        var today = plan?.SimulationSettings.StartDate ?? DateOnly.FromDateTime(DateTime.Today);

        _editModel = new MortgageEditModel
        {
            Id = Guid.NewGuid(),
            Name = string.Empty,
            Type = MortgageType.Saron,
            PaymentAccountIdText = PaymentAccounts.FirstOrDefault()?.Id.ToString() ?? string.Empty,
            InitialPrincipal = 0m,
            InitialDate = today,
            CalculationPrincipal = null,
            CalculationPrincipalDate = null,
            FixedInterestPercent = 0.65m,
            SaronRates =
            [
                new MortgageInterestRatePointEditModel
                {
                    Date = today,
                    RatePercent = 0m
                }
            ],
            AmortisationMode = AmortisationMode.None,
            AnnualAmortisationAmount = 0m,
            PaymentInterval = MortgagePaymentInterval.Quarterly,
            BillingCalendar = MortgageBillingCalendar.BankQuarters,
            IsActive = true
        };

        _newSaronRate = new MortgageInterestRatePointEditModel
        {
            Date = today,
            RatePercent = 0m
        };

        _isNewMortgage = true;
    }

    private void EditMortgage(MortgageContract mortgage)
    {
        ClearMessages();

        _editModel = MortgageEditModel.FromMortgage(mortgage);
        _newSaronRate = new MortgageInterestRatePointEditModel
        {
            Date = DateOnly.FromDateTime(DateTime.Today),
            RatePercent = 0m
        };

        _isNewMortgage = false;
    }

    private void SaveMortgage()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        try
        {
            ValidateEditModel();

            var mortgage = _editModel.ToMortgage();
            AppState.AddOrUpdateMortgage(mortgage);

            _infoMessage = _isNewMortgage
                ? Text("Mortgages_Added", mortgage.Name)
                : Text("Mortgages_Updated", mortgage.Name);

            _editModel = null;
            _isNewMortgage = false;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    // The plan autosaves to the browser working copy, so an accidental click here is not
    // recoverable without re-importing a file.
    private async Task DeleteMortgageAsync(MortgageContract mortgage)
    {
        ClearMessages();

        if (_confirmDialog is null)
        {
            return;
        }

        var confirmed = await _confirmDialog.ShowAsync(
            Text("Delete"),
            Text("Dialog_ConfirmMessage"));

        if (!confirmed)
        {
            return;
        }

        try
        {
            AppState.DeleteMortgage(mortgage.Id);
            _infoMessage = Text("Mortgages_Deleted", mortgage.Name);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        ClearMessages();
        _editModel = null;
        _isNewMortgage = false;
    }

    private void AddSaronRatePoint()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        var existing = _editModel.SaronRates
            .SingleOrDefault(x => x.Date == _newSaronRate.Date);

        if (existing is not null)
        {
            existing.RatePercent = _newSaronRate.RatePercent;
        }
        else
        {
            _editModel.SaronRates.Add(new MortgageInterestRatePointEditModel
            {
                Date = _newSaronRate.Date,
                RatePercent = _newSaronRate.RatePercent
            });
        }

        _editModel.SaronRates = _editModel.SaronRates
            .OrderBy(x => x.Date)
            .ToList();

        _newSaronRate = new MortgageInterestRatePointEditModel
        {
            Date = _newSaronRate.Date.AddMonths(3),
            RatePercent = _newSaronRate.RatePercent
        };
    }

    // A rate point is only held in the edit model, but it is still the one control that silently
    // discards a figure the user typed in, so it asks first like the other deletions do.
    private async Task DeleteSaronRatePointAsync(MortgageInterestRatePointEditModel ratePoint)
    {
        if (_editModel is null || _confirmDialog is null)
        {
            return;
        }

        var confirmed = await _confirmDialog.ShowAsync(
            Text("Delete"),
            Text("Dialog_ConfirmMessage"));

        if (!confirmed)
        {
            return;
        }

        _editModel.SaronRates.Remove(ratePoint);
    }

    private void ValidateEditModel()
    {
        if (_editModel is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editModel.Name))
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorNameRequired"));
        }

        if (string.IsNullOrWhiteSpace(_editModel.PaymentAccountIdText))
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorPaymentAccountRequired"));
        }

        if (_editModel.InitialPrincipal <= 0)
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorInitialPrincipalGreaterThanZero"));
        }

        if (_editModel.FixedInterestPercent < 0)
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorFixedInterestNotNegative"));
        }

        if (_editModel.AnnualAmortisationAmount < 0)
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorAnnualAmortisationNotNegative"));
        }

        if (_editModel.CalculationPrincipal is not null && _editModel.CalculationPrincipal <= 0)
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorCalculationPrincipalGreaterThanZero"));
        }

        if (_editModel.CalculationPrincipal is not null && _editModel.CalculationPrincipalDate is null)
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorCalculationPrincipalDateRequired"));
        }

        if (_editModel.CalculationPrincipalDate is not null && _editModel.CalculationPrincipal is null)
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorCalculationPrincipalRequired"));
        }

        if (_editModel.CalculationPrincipalDate is not null && _editModel.CalculationPrincipalDate < _editModel.InitialDate)
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorCalculationPrincipalDateBeforeInitialDate"));
        }

        if (_editModel.Type == MortgageType.Saron && _editModel.SaronRates.Count == 0)
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorSaronRateRequired"));
        }

        if (_editModel.AmortisationMode == AmortisationMode.Indirect
            && string.IsNullOrWhiteSpace(_editModel.IndirectAmortisationAccountIdText))
        {
            throw new InvalidOperationException(Text("Mortgages_ErrorIndirectAmortisationAccountRequired"));
        }
    }

    private string GetAccountName(Guid accountId)
    {
        if (AppState.CurrentPlan is null)
        {
            return "?";
        }

        return AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == accountId)
            ?.Name
            ?? "?";
    }

    private decimal GetProjectedPrincipal(MortgageContract mortgage)
    {
        if (AppState.CurrentSimulationResult is null || AppState.CurrentPlan is null)
        {
            return mortgage.CalculationPrincipal ?? mortgage.InitialPrincipal;
        }

        var projectedPrincipal = AppState.CurrentSimulationResult.GetMortgagePrincipal(
            mortgage.Id,
            AppState.CurrentPlan.SimulationSettings.EndDate);

        if (projectedPrincipal == 0m)
        {
            return mortgage.CalculationPrincipal ?? mortgage.InitialPrincipal;
        }

        return projectedPrincipal;
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
    }
}
