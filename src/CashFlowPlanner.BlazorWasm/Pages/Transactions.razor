@page "/transactions"

@using Microsoft.Extensions.Localization
@using CashFlowPlanner.Core
@using CashFlowPlanner.Core.People
@using CashFlowPlanner.BlazorWasm.Models
@using CashFlowPlanner.BlazorWasm.Services
@using CashFlowPlanner.BlazorWasm.Components
@using CashFlowPlanner.BlazorWasm.Resources

@inherits AppStateAwarePage

@inject UiFeedbackService Feedback
@inject CashFlowAppState AppState
@inject AppFormatter Formatter
@inject EnumLocalizer EnumL
@inject IStringLocalizer<SharedResource> L

<ConfirmDialog @ref="_confirmDialog" />

<PageScaffold Title="@L["Transactions"]"
              RequiresPlan="true"
              EmptyStateMessage="@L["Transaction_NoPlanLoaded"]">

    <Notifications>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_infoMessage))
        {
            <div class="alert alert-info">
                @_infoMessage
            </div>
        }
    </Notifications>

    <ChildContent>
        @{
            // PageScaffold only renders ChildContent once AppState.HasPlan, and HasPlan is
            // CurrentPlan is not null. The guard the page used to write itself now lives there.
            var plan = AppState.CurrentPlan!;

            var filteredTransactions = GetFilteredTransactions();

            var oneTimeTransactions = filteredTransactions
                .Where(IsOneTimeTransaction)
                .OrderByDescending(x => x.Schedule.StartDate)
                .ThenBy(x => x.Name)
                .ToList();

            var recurringTransactions = filteredTransactions
                .Where(x => !IsOneTimeTransaction(x))
                .OrderBy(x => x.Name)
                .ThenBy(x => x.Amount)
                .ToList();

            var visibleTransactions = _selectedTransactionTab == TransactionTab.OneTime
                ? oneTimeTransactions
                : recurringTransactions;

            var showRecurringColumns = _selectedTransactionTab == TransactionTab.Recurring;
            var baseCurrency = plan.BaseCurrency;
        }

        <div class="mb-3">
            <button type="button" class="btn btn-primary" @onclick="NewTransaction">
                @L["Transaction_AddTransaction"]
            </button>
        </div>

        @if (_editModel is not null)
        {
            @*
                Bound to a local rather than to the field. The dialog's body is a RenderFragment the
                AppModal holds on to, and cancelling clears the field before the modal has rendered
                itself away - so a fragment reading _editModel directly dereferences null on the way
                out.
            *@
            var edit = _editModel;

            <AppModal Visible="true"
                      Title="@(_isNewTransaction ? Text("Transaction_AddTransaction") : Text("Transaction_EditTransaction"))"
                      SizeCssClass="modal-xl modal-dialog-scrollable"
                      ConfirmText="@L["Save"]"
                      CancelText="@L["Cancel"]"
                      OnConfirm="SaveTransaction"
                      OnCancel="CancelEdit">

                <div class="row g-3">
                    <div class="col-md-6">
                        <FormField Label="@L["Name"]" CssClass="mb-0">
                            <input id="@context.Id"
                                   aria-describedby="@context.DescribedBy"
                                   class="form-control"
                                   @bind="edit.Name" />
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Kind"]" CssClass="mb-0">
                            <select id="@context.Id"
                                    aria-describedby="@context.DescribedBy"
                                    class="form-select"
                                    @bind="edit.Kind">
                                @foreach (var kind in Enum.GetValues<TransactionKind>())
                                {
                                    <option value="@kind">@EnumL.Translate(kind)</option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Amount"]" CssClass="mb-0">
                            <MoneyInput Id="@context.Id"
                                        AriaDescribedBy="@context.DescribedBy"
                                        @bind-Value="edit.Amount" />
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Currency"]" CssClass="mb-0">
                            <input id="@context.Id"
                                   aria-describedby="@context.DescribedBy"
                                   class="form-control"
                                   @bind="edit.Currency" />
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Transaction_Priority"]" CssClass="mb-0">
                            <input id="@context.Id"
                                   aria-describedby="@context.DescribedBy"
                                   type="number"
                                   class="form-control"
                                   @bind="edit.Priority" />
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Transaction_FromAccount"]" CssClass="mb-0">
                            <select id="@context.Id"
                                    aria-describedby="@context.DescribedBy"
                                    class="form-select"
                                    @bind="edit.FromAccountId">
                                <option value="">@L["Transaction_NoneOption"]</option>
                                @foreach (var account in plan.Accounts.OrderBy(x => x.Name))
                                {
                                    <option value="@account.Id">
                                        @account.Name (@EnumL.Translate(account.Type))
                                    </option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Transaction_ToAccount"]" CssClass="mb-0">
                            <select id="@context.Id"
                                    aria-describedby="@context.DescribedBy"
                                    class="form-select"
                                    @bind="edit.ToAccountId">
                                <option value="">@L["Transaction_NoneOption"]</option>
                                @foreach (var account in plan.Accounts.OrderBy(x => x.Name))
                                {
                                    <option value="@account.Id">
                                        @account.Name (@EnumL.Translate(account.Type))
                                    </option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-md-4">
                        <FormField Label="@L["Transaction_IncomePerson"]"
                                   CssClass="mb-0"
                                   Hint="@(Text("Transaction_IncomePersonHint"))">
                            <select id="@context.Id"
                                    aria-describedby="@context.DescribedBy"
                                    class="form-select"
                                    @bind="edit.IncomePersonId">
                                <option value="">@L["Transaction_NotAssignedOption"]</option>
                                @foreach (var person in PersonList.OrderBy(x => x.DisplayName))
                                {
                                    <option value="@person.Id">@person.DisplayName</option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-md-4">
                        <FormField Label="@L["Transaction_PaymentMethod"]" CssClass="mb-0">
                            <select id="@context.Id"
                                    aria-describedby="@context.DescribedBy"
                                    class="form-select"
                                    @bind="edit.PaymentMethod">
                                @foreach (var paymentMethod in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@paymentMethod">@EnumL.Translate(paymentMethod)</option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-md-4">
                        <FormField Label="@L["Category"]" CssClass="mb-0">
                            <input id="@context.Id"
                                   aria-describedby="@context.DescribedBy"
                                   class="form-control"
                                   @bind="edit.Category" />
                        </FormField>
                    </div>

                    <div class="col-md-6">
                        <FormField Label="@L["Transaction_Counterparty"]" CssClass="mb-0">
                            <input id="@context.Id"
                                   aria-describedby="@context.DescribedBy"
                                   class="form-control"
                                   @bind="edit.Counterparty" />
                        </FormField>
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <FormField Label="@L["Active"]"
                                   Layout="FormFieldLayout.Checkbox"
                                   CssClass="mb-2">
                            <input id="@context.Id"
                                   class="form-check-input"
                                   type="checkbox"
                                   @bind="edit.IsActive" />
                        </FormField>
                    </div>

                    <div class="col-12">
                        <hr />
                        <h3 class="h5">@L["Schedule"]</h3>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Transaction_Frequency"]" CssClass="mb-0">
                            <select id="@context.Id"
                                    aria-describedby="@context.DescribedBy"
                                    class="form-select"
                                    @bind="edit.Frequency">
                                @foreach (var frequency in Enum.GetValues<ScheduleFrequency>())
                                {
                                    <option value="@frequency">@EnumL.Translate(frequency)</option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Transaction_StartDate"]" CssClass="mb-0">
                            <input id="@context.Id"
                                   aria-describedby="@context.DescribedBy"
                                   type="date"
                                   class="form-control"
                                   @bind="edit.StartDate" />
                        </FormField>
                    </div>

                    @if (edit.Frequency != ScheduleFrequency.Once)
                    {
                        <div class="col-md-3">
                            <FormField Label="@L["Transaction_EndDate"]" CssClass="mb-0">
                                <input id="@context.Id"
                                       aria-describedby="@context.DescribedBy"
                                       type="date"
                                       class="form-control"
                                       @bind="edit.EndDate" />
                            </FormField>
                        </div>

                        <div class="col-md-3">
                            <FormField Label="@L["Transaction_Interval"]" CssClass="mb-0">
                                <input id="@context.Id"
                                       aria-describedby="@context.DescribedBy"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       @bind="edit.Interval" />
                            </FormField>
                        </div>

                        @if (edit.Frequency == ScheduleFrequency.Monthly
                            || edit.Frequency == ScheduleFrequency.Quarterly
                            || edit.Frequency == ScheduleFrequency.SemiYearly
                            || edit.Frequency == ScheduleFrequency.Yearly)
                        {
                            <div class="col-md-3">
                                <FormField Label="@L["Transaction_DayOfMonth"]" CssClass="mb-0">
                                    <input id="@context.Id"
                                           aria-describedby="@context.DescribedBy"
                                           type="number"
                                           min="1"
                                           max="31"
                                           class="form-control"
                                           @bind="edit.DayOfMonth" />
                                </FormField>
                            </div>
                        }

                        @if (edit.Frequency == ScheduleFrequency.Weekly)
                        {
                            <div class="col-md-3">
                                <FormField Label="@L["Transaction_DayOfWeek"]" CssClass="mb-0">
                                    <select id="@context.Id"
                                            aria-describedby="@context.DescribedBy"
                                            class="form-select"
                                            @bind="edit.DayOfWeek">
                                        <option value="">@L["Transaction_NoneOption"]</option>
                                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                                        {
                                            <option value="@day">@Formatter.DayOfWeek(day)</option>
                                        }
                                    </select>
                                </FormField>
                            </div>
                        }

                        @if (edit.Frequency == ScheduleFrequency.Yearly)
                        {
                            <div class="col-md-3">
                                <FormField Label="@L["Transaction_Month"]" CssClass="mb-0">
                                    <input id="@context.Id"
                                           aria-describedby="@context.DescribedBy"
                                           type="number"
                                           min="1"
                                           max="12"
                                           class="form-control"
                                           @bind="edit.Month" />
                                </FormField>
                            </div>
                        }
                    }

                    <div class="col-md-3">
                        <FormField Label="@L["Transaction_BusinessDayAdjustment"]" CssClass="mb-0">
                            <select id="@context.Id"
                                    aria-describedby="@context.DescribedBy"
                                    class="form-select"
                                    @bind="edit.BusinessDayAdjustment">
                                @foreach (var adjustment in Enum.GetValues<BusinessDayAdjustment>())
                                {
                                    <option value="@adjustment">@EnumL.Translate(adjustment)</option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-12">
                        <FormField Label="@L["Notes"]" CssClass="mb-0">
                            <textarea id="@context.Id"
                                      aria-describedby="@context.DescribedBy"
                                      class="form-control"
                                      rows="3"
                                      @bind="edit.Notes"></textarea>
                        </FormField>
                    </div>
                </div>
            </AppModal>
        }

        <div class="card mb-3">
            <div class="card-header">
                @L["Transaction_Filter"]
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <FormField Label="@L["Transaction_Search"]" CssClass="mb-0">
                            <input id="@context.Id"
                                   aria-describedby="@context.DescribedBy"
                                   class="form-control"
                                   value="@_transactionFilterText"
                                   @oninput="OnTransactionFilterInput" />
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Category"]" CssClass="mb-0">
                            <select id="@context.Id"
                                    aria-describedby="@context.DescribedBy"
                                    class="form-select"
                                    @onchange="OnCategoryFilterChanged"
                                    value="@_categoryFilter">
                                <option value="">@L["Transaction_AllCategories"]</option>
                                @foreach (var category in GetCategories())
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-md-3">
                        <FormField Label="@L["Kind"]" CssClass="mb-0">
                            <select id="@context.Id"
                                    aria-describedby="@context.DescribedBy"
                                    class="form-select"
                                    @onchange="OnKindFilterChanged"
                                    value="@_kindFilter">
                                <option value="">@L["Transaction_AllKinds"]</option>
                                @foreach (var kind in Enum.GetValues<TransactionKind>())
                                {
                                    <option value="@kind">@EnumL.Translate(kind)</option>
                                }
                            </select>
                        </FormField>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <div>
                            <FormField Label="@L["Transaction_ActiveOnly"]"
                                       Layout="FormFieldLayout.Checkbox"
                                       CssClass="mb-0">
                                <input id="@context.Id"
                                       class="form-check-input"
                                       type="checkbox"
                                       @bind="_showOnlyActive" />
                            </FormField>

                            <FormField Label="@L["Transaction_ShowAllTransactions"]"
                                       Layout="FormFieldLayout.Checkbox"
                                       CssClass="mb-0">
                                <input id="@context.Id"
                                       class="form-check-input"
                                       type="checkbox"
                                       @bind="_showAllTransactions" />
                            </FormField>
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <div class="text-muted">
                            @Text("Transaction_ShowingTransactions", filteredTransactions.Count, plan.Transactions.Count)
                        </div>

                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearTransactionFilters">
                            @L["Transaction_ClearFilter"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button type="button"
                        class="nav-link @(_selectedTransactionTab == TransactionTab.OneTime ? "active" : null)"
                        @onclick="() => _selectedTransactionTab = TransactionTab.OneTime">
                    @L["Transaction_TabOneTime"]
                    <span class="badge bg-secondary ms-1">@oneTimeTransactions.Count</span>
                </button>
            </li>

            <li class="nav-item">
                <button type="button"
                        class="nav-link @(_selectedTransactionTab == TransactionTab.Recurring ? "active" : null)"
                        @onclick="() => _selectedTransactionTab = TransactionTab.Recurring">
                    @L["Transaction_TabRecurring"]
                    <span class="badge bg-secondary ms-1">@recurringTransactions.Count</span>
                </button>
            </li>
        </ul>

        @*
            One column list drives the header, the body and the totals. The yearly total used to be
            a hand-written row whose colspan had to add up to the number of columns above it; it is
            now FooterValue on the two columns it belongs to, so it cannot drift out from under its
            own heading. FooterValue receives exactly the rows rendered, which is what makes the sum
            follow both the filter and the tab.
        *@
        <DataTable Items="visibleTransactions"
                   RowKey="@(transaction => (object)transaction.Id)"
                   TableCssClass="table table-striped table-hover align-middle"
                   Caption="@L["Transactions"]"
                   EmptyText="@L["Transaction_NoTransactionsMatchFilter"]"
                   ShowFooter="@(showRecurringColumns && visibleTransactions.Count > 0)"
                   FooterRowCount="3">

            <Column Title="@L["Name"]"
                    FooterValueAt="@((rows, row) => row switch
                    {
                        0 => L["Transaction_SumIncomingYearlyAmountFilter"].Value,
                        1 => L["Transaction_SumOutgoingYearlyAmountFilter"].Value,
                        _ => L["Transaction_SumYearlyAmountFilter"].Value
                    })">
                <ChildContent Context="transaction">
                    <div>@transaction.Name</div>

                    @if (!string.IsNullOrWhiteSpace(transaction.Notes))
                    {
                        <small class="text-muted">@transaction.Notes</small>
                    }
                </ChildContent>
            </Column>

            <Column Title="@L["Kind"]" Text="@(transaction => EnumL.Translate(transaction.Kind))" />

            <Column Title="@L["Active"]">
                <ChildContent Context="transaction">
                    @if (transaction.IsActive)
                    {
                        <span class="badge bg-success">@L["Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@L["Inactive"]</span>
                    }
                </ChildContent>
            </Column>

            <Column Title="@L["Transaction_From"]"
                    Text="@(transaction => GetAccountName(transaction.FromAccountId))" />

            <Column Title="@L["Transaction_To"]"
                    Text="@(transaction => GetAccountName(transaction.ToAccountId))" />

            <Column Title="@L["Transaction_IncomePerson"]"
                    Text="@(transaction => GetPersonName(transaction.IncomePersonId))" />

            <Column Title="@L["Amount"]"
                    Align="ColumnAlign.Number"
                    Text="@(transaction => Formatter.Money(transaction.Amount, transaction.Currency))" />

            @*
                Two declarations rather than one column wrapped in an @@if: the column list is built
                in declaration order as the components initialise, so a column that appears only on
                one tab would register at the end of the list rather than in its place.
            *@
            <Column Title="@L["Schedule"]"
                    Visible="@showRecurringColumns"
                    Text="@(transaction => FormatSchedule(transaction.Schedule))" />

            <Column Title="@L["Date"]"
                    Visible="@(!showRecurringColumns)"
                    Text="@(transaction => Formatter.Date(transaction.Schedule.StartDate))" />

            <Column Title="@L["Category"]"
                    Text="@(transaction => transaction.Category ?? string.Empty)" />

            <Column Title="@L["Transaction_YearlyAmount"]"
                    Align="ColumnAlign.Number"
                    Visible="@showRecurringColumns"
                    Text="@(transaction => Formatter.Money(CalculateYearlyAmount(transaction), transaction.Currency))"
                    FooterValueAt="@((rows, row) => row switch
                    {
                        0 => Formatter.Money(SumYearly(rows, TransactionKind.ExternalIncome), baseCurrency),
                        1 => Formatter.Money(SumYearly(rows, TransactionKind.ExternalExpense), baseCurrency),
                        _ => Formatter.Money(rows.Sum(CalculateYearlyAmount), baseCurrency)
                    })" />

            <Column Title="@L["Transaction_EffectiveYearlyAmount"]"
                    Align="ColumnAlign.Number"
                    Visible="@showRecurringColumns"
                    Text="@(transaction => Formatter.Money(CalculateEffectiveYearlyAmount(transaction), transaction.Currency))"
                    FooterValueAt="@((rows, row) => row == 2
                        ? Formatter.Money(rows.Sum(CalculateEffectiveYearlyAmount), baseCurrency)
                        : null)" />

            <Column Title="@L["Actions"]" HeaderCssClass="text-end" CellCssClass="text-nowrap">
                <ChildContent Context="transaction">
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-sm btn-primary"
                                @onclick="() => EditTransaction(transaction)">
                            @L["Edit"]
                        </button>

                        <button type="button" class="btn btn-sm btn-danger"
                                @onclick="() => DeleteTransaction(transaction)">
                            @L["Delete"]
                        </button>
                    </div>
                </ChildContent>
            </Column>
        </DataTable>

    </ChildContent>
</PageScaffold>

@code {
    private TransactionEditModel? _editModel;
    private bool _isNewTransaction;

    private string? _errorMessage;
    private string? _infoMessage;

    private ConfirmDialog? _confirmDialog;

    private string? _transactionFilterText;
    private string? _categoryFilter;
    private TransactionKind? _kindFilter;

    private bool _showOnlyActive = false;
    private bool _showAllTransactions = false;

    private TransactionTab _selectedTransactionTab = TransactionTab.OneTime;

    private IReadOnlyList<Person> PersonList => AppState.CurrentPlan?.Persons ?? [];

    private enum TransactionTab
    {
        OneTime,
        Recurring
    }

    private void NewTransaction()
    {
        ClearMessages();

        var plan = AppState.CurrentPlan;
        var startDate = DateOnly.FromDateTime(DateTime.Today);

        _editModel = new TransactionEditModel
        {
            Id = Guid.NewGuid(),
            Name = string.Empty,
            Kind = TransactionKind.ExternalExpense,
            FromAccountId = plan?.DefaultPaymentAccountId,
            Currency = plan?.BaseCurrency ?? "CHF",
            StartDate = startDate,
            DayOfMonth = startDate.Day,
            Month = startDate.Month,
            DayOfWeek = startDate.DayOfWeek,
            Interval = 1,
            Frequency = ScheduleFrequency.Once,
            Priority = 100,
            IsActive = true
        };

        _isNewTransaction = true;
        _selectedTransactionTab = TransactionTab.OneTime;
    }

    private void EditTransaction(TransactionDefinition transaction)
    {
        ClearMessages();

        _editModel = TransactionEditModel.FromTransaction(transaction);
        _isNewTransaction = false;

        _selectedTransactionTab = transaction.Schedule.Frequency == ScheduleFrequency.Once
            ? TransactionTab.OneTime
            : TransactionTab.Recurring;
    }

    private void SaveTransaction()
    {
        ClearMessages();

        if (_editModel is null)
        {
            return;
        }

        try
        {
            if (string.IsNullOrWhiteSpace(_editModel.Name))
            {
                throw new InvalidOperationException(Text("Transaction_ErrorNameRequired"));
            }

            if (_editModel.Amount <= 0)
            {
                throw new InvalidOperationException(Text("Transaction_ErrorAmountGreaterThanZero"));
            }

            if (_editModel.Interval < 1)
            {
                throw new InvalidOperationException(Text("Transaction_ErrorIntervalGreaterOrEqualOne"));
            }

            var transaction = _editModel.ToTransaction();

            AppState.AddOrUpdateTransaction(transaction);

            _selectedTransactionTab = transaction.Schedule.Frequency == ScheduleFrequency.Once
                ? TransactionTab.OneTime
                : TransactionTab.Recurring;

            Feedback.Success(
                _isNewTransaction
                    ? Text("Transaction_Added", transaction.Name)
                    : Text("Transaction_Updated", transaction.Name));

            _editModel = null;
            _isNewTransaction = false;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task DeleteTransaction(TransactionDefinition transaction)
    {
        ClearMessages();

        if (_confirmDialog is null)
        {
            return;
        }

        var confirmed = await _confirmDialog.ShowAsync(
            Text("Transaction_DeleteTitle"),
            Text("Transaction_DeleteConfirm", transaction.Name));

        if (!confirmed)
        {
            return;
        }

        try
        {
            AppState.DeleteTransaction(transaction.Id);
            Feedback.Success(Text("Transaction_Deleted", transaction.Name));
        }
        catch (Exception ex)
        {
            Feedback.Error(ex.Message);
        }
    }

    private void CancelEdit()
    {
        ClearMessages();

        _editModel = null;
        _isNewTransaction = false;
    }

    private IReadOnlyList<TransactionDefinition> GetFilteredTransactions()
    {
        if (AppState.CurrentPlan is null)
        {
            return [];
        }

        var query = AppState.CurrentPlan.Transactions.AsEnumerable();

        if (!_showAllTransactions)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            query = query.Where(x => IsVisibleByDefault(x, today));
        }

        if (_showOnlyActive)
        {
            query = query.Where(x => x.IsActive);
        }

        if (_kindFilter is not null)
        {
            query = query.Where(x => x.Kind == _kindFilter.Value);
        }

        if (!string.IsNullOrWhiteSpace(_categoryFilter))
        {
            query = query.Where(x => string.Equals(
                x.Category,
                _categoryFilter,
                StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_transactionFilterText))
        {
            var filter = _transactionFilterText.Trim();

            query = query.Where(x =>
                ContainsIgnoreCase(x.Name, filter)
                || ContainsIgnoreCase(x.Category, filter)
                || ContainsIgnoreCase(x.Counterparty, filter)
                || ContainsIgnoreCase(x.Notes, filter)
                || ContainsIgnoreCase(GetAccountName(x.FromAccountId), filter)
                || ContainsIgnoreCase(GetAccountName(x.ToAccountId), filter)
                || ContainsIgnoreCase(GetPersonName(x.IncomePersonId), filter)
                || ContainsIgnoreCase(EnumL.Translate(x.Kind), filter)
                || ContainsIgnoreCase(x.Kind.ToString(), filter)
                || ContainsIgnoreCase(Formatter.Money(x.Amount), filter)
                || ContainsIgnoreCase(Formatter.Money(CalculateYearlyAmount(x)), filter));
        }

        return query.ToList();
    }

    private IReadOnlyList<string> GetCategories()
    {
        if (AppState.CurrentPlan is null)
        {
            return [];
        }

        return AppState.CurrentPlan.Transactions
            .Select(x => x.Category)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .Select(x => x!)
            .ToList();
    }

    private void ClearTransactionFilters()
    {
        _transactionFilterText = null;
        _categoryFilter = null;
        _kindFilter = null;
        _showOnlyActive = false;
        _showAllTransactions = false;
    }

    private void OnTransactionFilterInput(ChangeEventArgs args)
    {
        _transactionFilterText = args.Value?.ToString();
    }

    private void OnCategoryFilterChanged(ChangeEventArgs args)
    {
        _categoryFilter = args.Value?.ToString();

        if (string.IsNullOrWhiteSpace(_categoryFilter))
        {
            _categoryFilter = null;
        }
    }

    private void OnKindFilterChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();

        if (string.IsNullOrWhiteSpace(value))
        {
            _kindFilter = null;
            return;
        }

        if (Enum.TryParse<TransactionKind>(value, out var kind))
        {
            _kindFilter = kind;
        }
        else
        {
            _kindFilter = null;
        }
    }

    private string GetAccountName(Guid? accountId)
    {
        if (accountId is null || AppState.CurrentPlan is null)
        {
            return AppFormatter.EmptyMarker;
        }

        return AppState.CurrentPlan.Accounts
            .SingleOrDefault(x => x.Id == accountId.Value)
            ?.Name ?? "?";
    }

    private string GetPersonName(Guid? personId)
    {
        if (personId is null || AppState.CurrentPlan is null)
        {
            return AppFormatter.EmptyMarker;
        }

        return AppState.CurrentPlan.Persons
            .SingleOrDefault(x => x.Id == personId.Value)
            ?.DisplayName ?? "?";
    }

    private static bool IsOneTimeTransaction(TransactionDefinition transaction)
    {
        return transaction.Schedule.Frequency == ScheduleFrequency.Once;
    }

    private static bool IsVisibleByDefault(TransactionDefinition transaction, DateOnly today)
    {
        if (!transaction.IsActive)
        {
            return false;
        }

        if (transaction.Schedule.Frequency == ScheduleFrequency.Once)
        {
            return transaction.Schedule.StartDate >= today;
        }

        return transaction.Schedule.EndDate is null
            || transaction.Schedule.EndDate.Value >= today;
    }

    private static bool ContainsIgnoreCase(string? value, string filter)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(filter, StringComparison.OrdinalIgnoreCase);
    }

    private static decimal CalculateYearlyAmount(TransactionDefinition transaction)
    {
        var interval = transaction.Schedule.Interval < 1
            ? 1
            : transaction.Schedule.Interval;

        var multiplier = transaction.Schedule.Frequency switch
        {
            ScheduleFrequency.Once => 1m,
            ScheduleFrequency.Daily => 365m / interval,
            ScheduleFrequency.Weekly => 52m / interval,
            ScheduleFrequency.Monthly => 12m / interval,
            ScheduleFrequency.Quarterly => 4m / interval,
            ScheduleFrequency.SemiYearly => 2m / interval,
            ScheduleFrequency.Yearly => 1m / interval,
            _ => 0m
        };

        return transaction.Amount * multiplier;
    }

    /// <summary>
    /// The yearly total for one kind of transaction, over exactly the rows the table is showing.
    /// </summary>
    private static decimal SumYearly(
        IReadOnlyList<TransactionDefinition> rows,
        TransactionKind kind)
    {
        return rows
            .Where(x => x.Kind == kind)
            .Sum(CalculateYearlyAmount);
    }

    private static decimal CalculateEffectiveYearlyAmount(TransactionDefinition transaction)
    {
        var yearlyAmount = CalculateYearlyAmount(transaction);

        return transaction.Kind switch
        {
            TransactionKind.ExternalIncome => yearlyAmount,
            TransactionKind.ExternalExpense => -yearlyAmount,
            _ => 0m
        };
    }

    private string FormatSchedule(Schedule schedule)
    {
        var interval = schedule.Interval < 1
            ? 1
            : schedule.Interval;

        return schedule.Frequency switch
        {
            ScheduleFrequency.Once => Text(
                "Transaction_ScheduleOnceOn",
                Formatter.Date(schedule.StartDate)),

            ScheduleFrequency.Weekly => Text(
                "Transaction_ScheduleEveryWeeksOn",
                interval,
                Formatter.DayOfWeek(schedule.DayOfWeek ?? schedule.StartDate.DayOfWeek)),

            ScheduleFrequency.Monthly => Text(
                "Transaction_ScheduleEveryMonthsOnDay",
                interval,
                schedule.DayOfMonth ?? schedule.StartDate.Day),

            ScheduleFrequency.Quarterly => Text(
                "Transaction_ScheduleEveryQuartersOnDay",
                interval,
                schedule.DayOfMonth ?? schedule.StartDate.Day),

            ScheduleFrequency.SemiYearly => Text(
                "Transaction_ScheduleEveryHalfYearsOnDay",
                interval,
                schedule.DayOfMonth ?? schedule.StartDate.Day),

            ScheduleFrequency.Yearly => Text(
                "Transaction_ScheduleEveryYearsOn",
                interval,
                schedule.Month ?? schedule.StartDate.Month,
                schedule.DayOfMonth ?? schedule.StartDate.Day),

            ScheduleFrequency.Daily => Text(
                "Transaction_ScheduleEveryDays",
                interval),

            _ => EnumL.Translate(schedule.Frequency)
        };
    }

    private string Text(string key)
    {
        return L[key].Value;
    }

    private string Text(string key, params object[] arguments)
    {
        return L[key, arguments].Value;
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
    }
