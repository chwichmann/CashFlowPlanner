@inherits LayoutComponentBase
@implements IDisposable

@using CashFlowPlanner.BlazorWasm.Components

@inject CashFlowPlanner.BlazorWasm.Services.PlanCacheCoordinator PlanCacheCoordinator
@inject CashFlowPlanner.BlazorWasm.Services.CashFlowAppState AppState
@inject CashFlowPlanner.BlazorWasm.Services.DiskAutoSaveCoordinator DiskCoordinator
@inject CashFlowPlanner.BlazorWasm.Services.DiskAutoSaveService DiskAutoSave

<div class="app-shell">
    <NavMenu />
    <PassphraseDialog />
    <DiskReconnectBanner />
    <AppUpdateBanner />
    <UiFeedbackBanner />
    <main class="app-main">
        @* .app-container (app.css) is the same class the navbar's inner element
           uses, so the page content and the brand share a left edge at every
           viewport width. Do not add horizontal padding utilities here: the
           container owns the gutter (finding U2). *@
        <div class="app-container content">
            @if (!_cacheInitialized)
            {
                <div class="alert alert-info">
                    Loading browser working copy...
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_cacheError))
            {
                <div class="alert alert-warning">
                    Could not restore browser working copy: @_cacheError
                </div>

                @Body
            }
            else
            {
                @Body
            }
        </div>
    </main>
</div>

@code {
    private bool _cacheInitialized;
    private string? _cacheError;

    protected override void OnInitialized()
    {
        AppState.Changed += OnAppStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Start disk autosave before restoring, so a plan restored from the working copy is
        // written to the linked file too. Reading the link status neither prompts nor touches
        // the disk - re-granting a lapsed permission needs a click and lives in Settings.
        DiskCoordinator.Initialize();
        await DiskAutoSave.RefreshAsync();

        try
        {
            await PlanCacheCoordinator.InitializeAsync();
        }
        catch (Exception ex)
        {
            _cacheError = ex.Message;
        }
        finally
        {
            _cacheInitialized = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    // This used to also bump a counter used as @key on the content div (finding
    // U5). CashFlowAppState raises Changed on ~28 different mutations, and every
    // one of them changed the key, which made Blazor tear the whole subtree down
    // and construct a brand new page component instead of diffing the existing
    // one. Adding a single account therefore discarded filter text, the selected
    // tab, scroll position, focus and any half-typed edit anywhere on the page.
    //
    // What re-rendering the layout does and does not do, measured in the browser:
    // the layout itself re-renders, and so does every component the layout owns
    // directly. It does NOT reach the routed page. @Body renders the page as a
    // child component with no parameters, and Blazor skips SetParametersAsync on
    // a retained child whose parameters are unchanged (ParameterView
    // .DefinitelyEquals), so the page never learns anything happened.
    //
    // In practice a page still updates for any change the user made on that page,
    // because the page's own event handler re-renders it. What does not update is
    // a mutation raised somewhere else - loading a plan or running the simulation
    // from the navigation bar, or the PlanEmptyState buttons. The fix is for each
    // page to subscribe to AppState.Changed itself (Pages/ is out of scope for
    // this change); reinstating the key would only trade the bug back.
    private void OnAppStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.Changed -= OnAppStateChanged;
    }
}