@using CashFlowPlanner.Storage.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using CashFlowPlanner.BlazorWasm
@using Microsoft.Extensions.Localization
@using CashFlowPlanner.BlazorWasm.Components

@implements IDisposable

@inject CashFlowAppState AppState
@inject CashFlowPlanJsonSerializer JsonSerializer
@inject BrowserPlanCacheService BrowserCache
@inject PlanFileService PlanFiles
@inject DiskAutoSaveService Disk
@inject DiskAutoSaveCoordinator DiskCoordinator
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<SharedResource> L
@inject UiFeedbackService Feedback

@* The navbar and the status strip stick to the top as one element (finding H4).
   The strip used to be sticky on its own at a hardcoded top: 56px, which left a
   gap the page scrolled through whenever the navbar was not exactly 56px tall,
   and slid underneath it entirely on mobile with the menu expanded (the navbar
   is then 3-4x taller, and z-index 1020 lost to the navbar's 1030). Sticking the
   pair means neither number has to be guessed. *@
<header class="app-header">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark app-navbar">
    @* .app-container, not .container-fluid: the same class MainLayout wraps the
       page content in, so the brand and the page <h1> share a left edge at every
       viewport width (finding U2). app.css restates the flex layout Bootstrap
       only grants its own .container* classes inside a navbar. *@
    <div class="app-container">
        <NavLink class="navbar-brand" href="" Match="NavLinkMatch.All">
            CashFlow Planner
        </NavLink>

        <button class="navbar-toggler"
                type="button"
                @onclick="ToggleNavMenu"
                aria-label="@L["Nav_ToggleNavigation"]">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass navbar-collapse">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="" Match="NavLinkMatch.All"
                             title="@L["Nav_Home"]"
                             aria-label="@L["Nav_Home"]">
                        <NavIcon Name="home" />
                        <span class="nav-link-label">@L["Nav_Home"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="dashboard"
                             title="@L["Nav_Dashboard"]"
                             aria-label="@L["Nav_Dashboard"]">
                        <NavIcon Name="dashboard" />
                        <span class="nav-link-label">@L["Nav_Dashboard"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="simulation"
                             title="@L["Nav_Simulation"]"
                             aria-label="@L["Nav_Simulation"]">
                        <NavIcon Name="simulation" />
                        <span class="nav-link-label">@L["Nav_Simulation"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="accounts"
                             title="@L["Nav_Accounts"]"
                             aria-label="@L["Nav_Accounts"]">
                        <NavIcon Name="accounts" />
                        <span class="nav-link-label">@L["Nav_Accounts"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="transactions"
                             title="@L["Nav_Transactions"]"
                             aria-label="@L["Nav_Transactions"]">
                        <NavIcon Name="transactions" />
                        <span class="nav-link-label">@L["Nav_Transactions"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="mortgages"
                             title="@L["Nav_Mortgages"]"
                             aria-label="@L["Nav_Mortgages"]">
                        <NavIcon Name="mortgages" />
                        <span class="nav-link-label">@L["Nav_Mortgages"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="creditcards"
                             title="@L["Nav_CreditCards"]"
                             aria-label="@L["Nav_CreditCards"]">
                        <NavIcon Name="creditcards" />
                        <span class="nav-link-label">@L["Nav_CreditCards"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="pillar3a"
                             title="@L["Nav_Pillar3a"]"
                             aria-label="@L["Nav_Pillar3a"]">
                        <NavIcon Name="pillar3a" />
                        <span class="nav-link-label">@L["Nav_Pillar3a"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="persons"
                             title="@L["Nav_Persons"]"
                             aria-label="@L["Nav_Persons"]">
                        <NavIcon Name="persons" />
                        <span class="nav-link-label">@L["Nav_Persons"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="house-buy-simulator"
                             title="@L["Nav_HouseBuySimulator"]"
                             aria-label="@L["Nav_HouseBuySimulator"]">
                        <NavIcon Name="housebuy" />
                        <span class="nav-link-label">@L["Nav_HouseBuySimulator"]</span>
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link nav-link-icon" href="settings"
                             title="@L["Nav_Settings"]"
                             aria-label="@L["Nav_Settings"]">
                        <NavIcon Name="settings" />
                        <span class="nav-link-label">@L["Nav_Settings"]</span>
                    </NavLink>
                </li>
            </ul>

            <div class="navbar-plan-status">
                @if (AppState.CurrentPlan is not null)
                {
                    <div class="navbar-plan-name" title="@AppState.CurrentPlan.Name">
                        @AppState.CurrentPlan.Name

                        @* The visible half of P1c, now with the positive half too. Warning only
                           when something is wrong leaves the user with no way to tell "safe" from
                           "nobody has checked" - so a linked file that is current says so. *@
                        @if (AppState.IsDirty)
                        {
                            <span class="badge text-bg-warning ms-2 align-middle"
                                  title="@L["Nav_ExportNeededHint"]">
                                @L["Nav_ExportNeeded"]
                            </span>
                        }
                        else if (Disk.Status.CanWrite && !DiskCoordinator.FileIsBehind)
                        {
                            <span class="badge text-bg-success ms-2 align-middle"
                                  title="@string.Format(L["Nav_SavedHint"].Value, Disk.Status.FileName)">
                                @L["Nav_Saved"]
                            </span>
                        }
                    </div>

                    <div class="navbar-cache-status">
                        @GetLoadedSourceText()
                    </div>
                }
                else
                {
                    <div class="navbar-cache-status">
                        @L["Nav_NoPlanLoaded"]
                    </div>
                }
            </div>

            <div class="navbar-actions">
                <InputFile id="navJsonFileInput"
                           style="display: none;"
                           accept=".json,.cfplan"
                           OnChange="LoadFileAsync" />

                <label class="btn btn-sm btn-outline-light nav-icon-button"
                       for="navJsonFileInput"
                       title=@L["Nav_OpenJsonFile"]
                       aria-label=@L["Nav_OpenJsonFile"]>
                    📂
                </label>

                <button type="button"
                        class="btn btn-sm btn-outline-light"
                        title="@L["Nav_RunSimulation"]"
                        aria-label="@L["Nav_RunSimulation"]"
                        disabled="@(!AppState.HasPlan || Feedback.IsBusy)"
                        @onclick="RunSimulationAsync">
                    @if (Feedback.IsBusy)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status"
                              aria-hidden="true">
                        </span>
                    }
                    else
                    {
                        <span>▶</span>
                    }
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-light nav-icon-button"
                        title=@L["Nav_SaveJsonFile"]
                        aria-label=@L["Nav_SaveJsonFile"]
                        disabled="@(!AppState.HasPlan)"
                        @onclick="ExportPlanAsync">
                    💾
                </button>
            </div>
        </div>
    </div>
</nav>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="@StatusCssClass">
        @* Same container as the navbar row above and the page below, so the
           message starts on the app's left edge instead of the window's. *@
        <div class="app-container">
            @_statusMessage
        </div>
    </div>
}
</header>

@code {
    private bool collapseNavMenu = true;

    private string? _statusMessage;
    private string? _cachedAtText;
    private string? _loadedSource;
    private bool _isError;

    private string NavMenuCssClass =>
        collapseNavMenu ? "collapse" : string.Empty;

    private string StatusCssClass =>
        _isError
            ? "nav-status nav-status-error"
            : "nav-status nav-status-info";

    protected override void OnInitialized()
    {
        AppState.Changed += OnAppStateChanged;
        // The dirty flag can flip without the plan itself changing (e.g. on export).
        AppState.DirtyStateChanged += OnAppStateChanged;
        Disk.StatusChanged += OnAppStateChanged;
        DiskCoordinator.Changed += OnAppStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await RefreshCachedAtTextAsync();

        if (AppState.HasPlan && string.IsNullOrWhiteSpace(_loadedSource))
        {
            _loadedSource = "cache";
        }

        StateHasChanged();
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void OnAppStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshCachedAtTextAsync();

            if (AppState.HasPlan && string.IsNullOrWhiteSpace(_loadedSource))
            {
                _loadedSource = "cache";
            }

            if (!AppState.HasPlan)
            {
                _loadedSource = null;
            }

            StateHasChanged();
        });
    }

    private async Task LoadFileAsync(InputFileChangeEventArgs args)
    {
        ClearStatus();

        try
        {
            var file = args.File;

            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);

            var fileText = await reader.ReadToEndAsync();

            // Decrypts and prompts for a passphrase when the file is encrypted.
            var document = await PlanFiles.ReadAsync(fileText, file.Name);

            AppState.LoadDocument(document);

            // The working copy is always plaintext JSON: it is scoped to this browser
            // and is re-derived from the document, never from the file bytes.
            var json = JsonSerializer.SerializeDocument(document);
            var cacheWrite = await BrowserCache.SaveAsync(json);
            await RefreshCachedAtTextAsync();

            _loadedSource = "file";

            if (cacheWrite.Success)
            {
                _statusMessage = string.Format(L["Nav_FileLoaded"].Value, file.Name);
                _isError = false;
            }
            else
            {
                // The plan is loaded and usable; only the working copy is missing, so a
                // reload would lose it. Say so rather than reporting a clean load.
                _statusMessage =
                    string.Format(
                        L["Nav_FileLoadedCacheFailed"].Value, file.Name, cacheWrite.Message);
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _isError = true;
        }
    }

    private async Task RunSimulationAsync()
    {
        try
        {
            Feedback.ClearNotification();
            Feedback.StartBusy(L["Nav_SimulationRunning"].Value);

            await Task.Yield();

            AppState.RunSimulation();

            Feedback.Success(L["Nav_SimulationCompleted"].Value);
        }
        catch (Exception ex)
        {
            Feedback.Error(ex.Message);
        }
        finally
        {
            Feedback.StopBusy();
        }
    }

    private async Task ExportPlanAsync()
    {
        ClearStatus();

        try
        {
            var document = AppState.GetDocumentForSave();

            // Encrypts when the user has asked for it, prompting for a passphrase the
            // first time. Throws PassphraseCancelledException if they back out.
            var file = await PlanFiles.WriteAsync(document);
            var fileName = CreateExportFileName(document.Name, file.Extension);

            await JsRuntime.InvokeVoidAsync(
                "cashFlowPlanner.downloadTextFile",
                fileName,
                file.Text,
                file.ContentType);

            // The file on disk now matches what is in memory, so the plan is no longer
            // dirty. Without this the "unexported changes" indicator never clears (P1c).
            // Hash the PLAN json, not the envelope: a fresh key on every encryption makes
            // the envelope bytes different each time even when nothing changed.
            var json = JsonSerializer.SerializeDocument(document);
            AppState.MarkExported(json);

            var cacheWrite = await BrowserCache.SaveAsync(json);
            await RefreshCachedAtTextAsync();

            if (cacheWrite.Success)
            {
                _statusMessage = string.Format(L["Nav_FileExported"].Value, fileName);
                _isError = false;
            }
            else
            {
                // The export itself succeeded - only the working copy failed to update.
                _statusMessage =
                    string.Format(
                        L["Nav_FileExportedCacheFailed"].Value, fileName, cacheWrite.Message);
                _isError = true;
            }
        }
        catch (PassphraseCancelledException)
        {
            ClearStatus();
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _isError = true;
        }
    }

    private string GetLoadedSourceText()
    {
        var sourceText = _loadedSource switch
        {
            "file" => L["Nav_LoadedFromFile"].Value,
            "cache" => L["Nav_LoadedFromCache"].Value,
            _ => L["Nav_Loaded"].Value
        };

        if (string.IsNullOrWhiteSpace(_cachedAtText))
        {
            return sourceText;
        }

        return $"{sourceText} · {string.Format(L["Nav_CachedAt"].Value, _cachedAtText)}";
    }

    private async Task RefreshCachedAtTextAsync()
    {
        var cachedAt = await BrowserCache.GetCachedAtAsync();

        if (string.IsNullOrWhiteSpace(cachedAt))
        {
            _cachedAtText = null;
            return;
        }

        if (DateTimeOffset.TryParse(cachedAt, out var timestamp))
        {
            _cachedAtText = timestamp.LocalDateTime.ToString("dd.MM.yyyy HH:mm:ss");
        }
        else
        {
            _cachedAtText = cachedAt;
        }
    }

    private static string CreateExportFileName(string planName, string extension)
    {
        var safeName = string.Join(
            "-",
            planName.Split(Path.GetInvalidFileNameChars(), StringSplitOptions.RemoveEmptyEntries));

        if (string.IsNullOrWhiteSpace(safeName))
        {
            safeName = "cashflow-plan";
        }

        return $"{safeName}-{DateTime.Now:yyyyMMdd-HHmmss}{extension}";
    }

    private void ClearStatus()
    {
        _statusMessage = null;
        _isError = false;
    }

    public void Dispose()
    {
        AppState.Changed -= OnAppStateChanged;
        AppState.DirtyStateChanged -= OnAppStateChanged;
        Disk.StatusChanged -= OnAppStateChanged;
        DiskCoordinator.Changed -= OnAppStateChanged;
    }
}