###############################################################################
# Line endings
#
# Normalize everything git detects as text to LF in the repository. Working-tree
# endings are then decided per type below, so the shell scripts embedded in
# .github/workflows and the files they touch never reach the ubuntu runner with
# CRLF.
###############################################################################
* text=auto

# Always LF in the working tree, on every platform.
*.sh          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.jsonc       text eol=lf
*.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore    text eol=lf

# Always CRLF in the working tree.
*.cmd         text eol=crlf
*.bat         text eol=crlf
*.ps1         text eol=crlf

###############################################################################
# Source and project files
###############################################################################
*.cs          text diff=csharp
*.razor       text diff=html
*.cshtml      text diff=html
*.css         text diff=css
*.html        text diff=html
*.js          text
*.md          text diff=markdown
*.resx        text
*.csproj      text
*.props       text
*.targets     text
*.slnx        text
*.slnf        text
*.sln         text eol=crlf

###############################################################################
# Binary - never diff, never normalize
###############################################################################
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.webp        binary
*.svgz        binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.eot         binary
*.otf         binary
*.pdf         binary
*.zip         binary
*.gz          binary
*.br          binary
*.7z          binary
*.dll         binary
*.exe         binary
*.pdb         binary
*.wasm        binary
*.dat         binary
*.snk         binary

###############################################################################
# Vendored / generated - keep out of language statistics and out of diffs
###############################################################################
src/CashFlowPlanner.BlazorWasm/wwwroot/lib/**  linguist-vendored
*.min.css     linguist-generated -diff
*.min.js      linguist-generated -diff
*.map         linguist-generated -diff
